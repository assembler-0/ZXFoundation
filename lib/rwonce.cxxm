/// SPDX-License-Identifier: Apache-2.0
/// @file lib/rwonce.cxxm
/// @brief C++26 Read-Write Once (Volatile Single-Access) Primitives

export module lib.rwonce;
import zxfoundation.base.types;
import lib.stl;

export {

namespace lib::rwonce {

    namespace detail {
        template <usize>
        struct native_uint {};

        template <>
        struct native_uint<1> {
            using type = u8;
        };

        template <>
        struct native_uint<2> {
            using type = u16;
        };

        template <>
        struct native_uint<4> {
            using type = u32;
        };

        template <>
        struct native_uint<8> {
            using type = u64;
        };

        template <>
        struct native_uint<16> {
            using type = u128;
        };

        template <usize N>
        concept has_native_uint = requires { typename native_uint<N>::type; };

        template <typename T>
            requires has_native_uint<sizeof(std::remove_cv_t<T>)>
        using native_uint_t = typename native_uint<sizeof(std::remove_cv_t<T>)>::type;
    } // namespace detail

    template <typename T>
    concept Word =
        std::is_trivially_copyable_v<std::remove_cv_t<T>> &&
        detail::has_native_uint<sizeof(std::remove_cv_t<T>)> &&
        alignof(std::remove_cv_t<T>) >= alignof(detail::native_uint_t<std::remove_cv_t<T>>);

    namespace detail {
        template <typename T>
            requires (!Word<T>)
        constexpr auto reject_unsupported_type() -> void {
            static_assert(Word<T>,
                "rwonce: T must be trivially copyable and exactly 1, 2, 4, 8, or 16 "
                "bytes (a native machine word) to be loaded/stored as a single, "
                "non-tearing access. Split it into word-sized fields, or use "
                "std::atomic if you need concurrent synchronization.");
        }
    } // namespace detail

    /// @brief Read a memory location once without compiler caching or reordering
    /// @param[in] x Memory location to read from
    /// @return Stripped non-volatile value copy
    template <typename T>
    [[nodiscard]] constexpr auto read_once(const volatile T &x) noexcept -> std::remove_cv_t<T> {
        using CleanT = std::remove_cv_t<T>;
        if constexpr (!Word<CleanT>) {
            detail::reject_unsupported_type<CleanT>();
            std::unreachable();
        } else {
            if consteval {
                return const_cast<const CleanT&>(x);
            } else {
                using U = detail::native_uint_t<CleanT>;
                const volatile U *p =
                    reinterpret_cast<const volatile U *>(std::addressof(x));
                return std::bit_cast<CleanT>(*p);
            }
        }
    }

    /// @brief Write to a memory location once without compiler elision or reordering
    /// @param[out] x Destination memory location
    /// @param[in] val Value to write
    template <typename T>
    constexpr auto write_once(volatile T &x, std::type_identity_t<std::remove_cv_t<T>> val) noexcept -> void {
        using CleanT = std::remove_cv_t<T>;
        if constexpr (!Word<CleanT>) {
            detail::reject_unsupported_type<CleanT>();
        } else {
            if consteval {
                const_cast<CleanT&>(x) = val;
            } else {
                using U = detail::native_uint_t<CleanT>;
                volatile U *p = reinterpret_cast<volatile U *>(std::addressof(x));
                *p = std::bit_cast<U>(val);
            }
        }
    }

    template <Word T>
    class ref {
    public:
        using CleanT = std::remove_cv_t<T>;

        explicit constexpr ref(T &obj) noexcept : ptr_(std::addressof(obj)) {}

        [[nodiscard]] constexpr operator CleanT() const noexcept { return read_once(*ptr_); }

        constexpr auto operator=(CleanT val) const noexcept -> const ref& {
            write_once(*ptr_, val);
            return *this;
        }

        [[nodiscard]] constexpr auto load() const noexcept -> CleanT { return read_once(*ptr_); }
        constexpr auto store(CleanT val) const noexcept -> void { write_once(*ptr_, val); }

        constexpr ref(const ref &) noexcept = default;
        ref &operator=(const ref &) = delete;

    private:
        T *ptr_;
    };

    template <typename T>
    ref(T &) -> ref<T>;

    template <Word T>
    class cell {
    public:
        using CleanT = std::remove_cv_t<T>;

        constexpr cell() noexcept = default;
        constexpr cell(CleanT init) noexcept : value_(init) {}

        [[nodiscard]] constexpr operator CleanT() const noexcept { return read_once(value_); }

        constexpr auto operator=(CleanT val) noexcept -> cell& {
            write_once(value_, val);
            return *this;
        }

        [[nodiscard]] constexpr auto load() const noexcept -> CleanT { return read_once(value_); }
        constexpr auto store(CleanT val) noexcept -> void { write_once(value_, val); }

        [[nodiscard]] constexpr auto unsafe_ref() noexcept -> CleanT& { return value_; }
        [[nodiscard]] constexpr auto unsafe_ref() const noexcept -> const CleanT& { return value_; }

        cell(const cell &) = delete;
        cell &operator=(const cell &) = delete;

    private:
        CleanT value_{};
    };

} // namespace lib::rwonce

} // end export