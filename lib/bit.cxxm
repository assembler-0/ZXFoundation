/// SPDX-License-Identifier: Apache 2.0
/// @file lib/bit.cxxm
/// @brief Kernel-specific bit helpers layered on top of <bit>.

export module lib.bit;
import zxfoundation.base.types;
import std;

using std::countl_zero;
using std::countr_zero;
using std::popcount;
using std::has_single_bit;
using std::bit_ceil;
using std::bit_floor;
using std::bit_width;
using std::rotl;
using std::rotr;
using std::byteswap;
using std::bit_cast;
using std::endian;

export {

namespace lib {

    /// @brief Bit-numbering conventions
    enum class bit_numbering {
        lsb0,
        msb0
    };

    /// @brief Mask with a single bit set (LSB0 numbering).
    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_mask(u32 bit) noexcept -> T {
        return T(1) << bit;
    }

    /// @brief Mask with a single bit set (MSB0 / IBM numbering).
    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_mask_msb(u32 bit) noexcept -> T {
        return T(1) << (sizeof(T) * 8 - 1 - bit);
    }

    /// @brief Mask for a range of bits [start, end] inclusive (LSB0).
    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_range_mask(u32 start, u32 end) noexcept -> T {
        if (start > end) return 0;
        const u32 len = end - start + 1;
        if (len >= sizeof(T) * 8) return ~T(0);
        return ((T(1) << len) - 1) << start;
    }

    /// @brief Mask for a range of bits [start, end] inclusive (IBM MSB0).
    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_range_mask_msb(u32 start, u32 end) noexcept -> T {
        if (start > end) return 0;
        const u32 len = end - start + 1;
        const u32 shift = sizeof(T) * 8 - 1 - end;
        if (len >= sizeof(T) * 8) return ~T(0);
        return ((T(1) << len) - 1) << shift;
    }

    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_test(T val, u32 bit) noexcept -> bool {
        return (val & bit_mask<T>(bit)) != 0;
    }

    template <typename T> requires std::is_unsigned_v<T>
    constexpr auto bit_set(T& val, u32 bit) noexcept -> void {
        val |= bit_mask<T>(bit);
    }

    template <typename T> requires std::is_unsigned_v<T>
    constexpr auto bit_clear(T& val, u32 bit) noexcept -> void {
        val &= ~bit_mask<T>(bit);
    }

    template <typename T> requires std::is_unsigned_v<T>
    constexpr auto bit_toggle(T& val, u32 bit) noexcept -> void {
        val ^= bit_mask<T>(bit);
    }

    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_test_msb(T val, u32 bit) noexcept -> bool {
        return (val & bit_mask_msb<T>(bit)) != 0;
    }

    template <typename T> requires std::is_unsigned_v<T>
    constexpr auto bit_set_msb(T& val, u32 bit) noexcept -> void {
        val |= bit_mask_msb<T>(bit);
    }

    template <typename T> requires std::is_unsigned_v<T>
    constexpr auto bit_clear_msb(T& val, u32 bit) noexcept -> void {
        val &= ~bit_mask_msb<T>(bit);
    }

    /// @brief Extract bitfield [start, end] inclusive (LSB0), shifted to LSB.
    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_extract(T val, u32 start, u32 end) noexcept -> T {
        return (val & bit_range_mask<T>(start, end)) >> start;
    }

    /// @brief Extract bitfield [start, end] inclusive (IBM MSB0), shifted to LSB.
    template <typename T> requires std::is_unsigned_v<T>
    [[nodiscard]] constexpr auto bit_extract_msb(T val, u32 start, u32 end) noexcept -> T {
        const u32 shift = sizeof(T) * 8 - 1 - end;
        return (val & bit_range_mask_msb<T>(start, end)) >> shift;
    }

    /// @brief Insert value into bitfield [start, end] inclusive (LSB0).
    template <typename T> requires std::is_unsigned_v<T>
    constexpr auto bit_insert(T& target, u32 start, u32 end, T val) noexcept -> void {
        const T mask = bit_range_mask<T>(start, end);
        target = (target & ~mask) | ((val << start) & mask);
    }

    /// @brief Insert value into bitfield [start, end] inclusive (IBM MSB0).
    template <typename T> requires std::is_unsigned_v<T>
    constexpr auto bit_insert_msb(T& target, u32 start, u32 end, T val) noexcept -> void {
        const T mask = bit_range_mask_msb<T>(start, end);
        const u32 shift = sizeof(T) * 8 - 1 - end;
        target = (target & ~mask) | ((val << shift) & mask);
    }

    /// @brief Non-owning typed view over a single integer's bits.
    /// @tparam T    Underlying unsigned integer type.
    /// @tparam Conv Default bit-numbering convention.
    template <typename T, bit_numbering Conv = bit_numbering::lsb0>
        requires std::is_unsigned_v<T>
    struct bit_view {
        T& value;

        constexpr explicit bit_view(T& v) noexcept : value(v) {}

        [[nodiscard]] constexpr auto test(u32 bit) const noexcept -> bool {
            if constexpr (Conv == bit_numbering::msb0) return bit_test_msb(value, bit);
            else return bit_test(value, bit);
        }

        constexpr auto set(u32 bit) noexcept -> bit_view& {
            if constexpr (Conv == bit_numbering::msb0) bit_set_msb(value, bit);
            else bit_set(value, bit);
            return *this;
        }

        constexpr auto clear(u32 bit) noexcept -> bit_view& {
            if constexpr (Conv == bit_numbering::msb0) bit_clear_msb(value, bit);
            else bit_clear(value, bit);
            return *this;
        }

        [[nodiscard]] constexpr auto extract(u32 start, u32 end) const noexcept -> T {
            if constexpr (Conv == bit_numbering::msb0) return bit_extract_msb(value, start, end);
            else return bit_extract(value, start, end);
        }

        constexpr auto insert(u32 start, u32 end, T val) noexcept -> bit_view& {
            if constexpr (Conv == bit_numbering::msb0) bit_insert_msb(value, start, end, val);
            else bit_insert(value, start, end, val);
            return *this;
        }
    };

    template <typename T> requires std::is_integral_v<T>
    [[nodiscard]] constexpr auto native_to_big(T val) noexcept -> T {
        if constexpr (endian::native == endian::big) return val;
        else return byteswap(val);
    }

    template <typename T> requires std::is_integral_v<T>
    [[nodiscard]] constexpr auto big_to_native(T val) noexcept -> T { return native_to_big(val); }

    template <typename T> requires std::is_integral_v<T>
    [[nodiscard]] constexpr auto native_to_little(T val) noexcept -> T {
        if constexpr (endian::native == endian::little) return val;
        else return byteswap(val);
    }

    template <typename T> requires std::is_integral_v<T>
    [[nodiscard]] constexpr auto little_to_native(T val) noexcept -> T { return native_to_little(val); }

} // namespace lib

} // end export
