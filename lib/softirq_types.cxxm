/// SPDX-License-Identifier: Apache-2.0
/// @file lib/softirq_types.cxxm
/// @brief Softirq vector indices and deferred-work entry records.

export module lib.softirq_types;
import zxfoundation.base.types;
import arch.s390x.lib.atomic;

export {

namespace lib {

    /// @brief Softirq vector identifier.
    enum class softirq_vec : u8 {
        hi          = 0,  ///< High-priority tasklets (legacy slot, reserved).
        timer       = 1,  ///< Timer expiry release work.
        net_tx      = 2,  ///< Network transmit (reserved for future net domain).
        net_rx      = 3,  ///< Network receive (reserved for future net domain).
        block       = 4,  ///< Block I/O completion (reserved).
        irq_poll    = 5,  ///< IRQ poll softirq (reserved).
        tasklet     = 6,  ///< Generic tasklet vector (reserved).
        sched       = 7,  ///< Scheduler load-balancing softirq (Phase 4.2).
        hrtimer     = 8,  ///< High-resolution timer softirq.
        rcu         = 9,  ///< Read-Copy-Update grace-period advancement.
        mutex_release = 10, ///< Slow-path mutex release (Phase 0.3 continuation).
        nohz_idle   = 11, ///< nohz idle balance kick (Phase 4.9).
        numa        = 12, ///< NUMA balancing hint (reserved for future Phase 12).
        _count            ///< Sentinel: number of softirq vectors supported.
    };

    static_assert(static_cast<u32>(softirq_vec::_count) <= 32U,
        "softirq vector count must fit the u32 pending bitmap");

    /// @brief Convert a softirq vector to its bit position in the pending bitmap.
    /// @param[in] v Softirq vector identifier.
    /// @return Bit position (0..31).
    [[nodiscard]] constexpr auto softirq_bit(softirq_vec v) noexcept -> u32 {
        return 1U << static_cast<u32>(v);
    }

    /// @brief Convert a softirq vector to its dense index in the vector table.
    /// @param[in] v Softirq vector identifier.
    /// @return Dense index 0 .. N-1 where N is the number of supported vectors.
    [[nodiscard]] constexpr auto softirq_index(softirq_vec v) noexcept -> u32 {
        return static_cast<u32>(v);
    }

    /// @brief Maximum number of softirq vectors supported by the framework.
    inline constexpr u32 NR_SOFTIRQS = static_cast<u32>(softirq_vec::_count);

    /// @brief Function pointer type invoked by the softirq dispatcher.
    /// @param[in] data Opaque context registered with @c open_softirq.
    using softirq_fn = auto (*)(void* data) noexcept -> void;

    /// @brief One entry in the global softirq vector table.
    struct softirq_entry {
        softirq_fn   action{nullptr};
        void*        data{nullptr};
        /// @brief Generation counter bumped on @c open_softirq, allowing callers
        ///        to detect re-registration of a vector slot (e.g. for diagnostics).
        arch::s390x::lib::atomic::atomic<u32> generation{0U};
    };

    static_assert(sizeof(softirq_entry) <= 24U,
        "softirq_entry must fit one cache line stride (no false sharing)");

    /// @brief Per-CPU softirq execution state.
    struct softirq_state {
        /// @brief Bitmap of pending softirq vectors (one bit per @c softirq_vec).
        arch::s390x::lib::atomic::atomic<u32> pending{0U};
        /// @brief Snapshot of pending bits being processed right now in @c do_softirq.
        u32                                     processing{0U};
        /// @brief Recursive re-entry guard (a softirq may raise another softirq).
        u32                                     nest{0U};
        /// @brief Monotonic counter bumped every time @c do_softirq is entered.
        u64                                     dispatch_count{0U};
        /// @brief Monotonic counter bumped every time @c raise_softirq actually sets a bit.
        u64                                     raise_count{0U};
    };

    static_assert(sizeof(softirq_state) <= 32U,
        "softirq_state must remain compact so multiple per-CPU copies fit a cache line");

    /// @brief Reserved value for "no softirq vector" returns.
    inline constexpr softirq_vec SOFTIRQ_VEC_NONE = static_cast<softirq_vec>(0xFFU);

} // namespace lib

} // end export
