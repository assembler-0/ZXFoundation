/// SPDX-License-Identifier: Apache-2.0
/// @file lib/bitmap.cxxm
/// @brief Fixed-capacity SMP-safe bitmap using std::atomic.

export module lib.bitmap;
import zxfoundation.base.types;
import lib.bit;
import lib.stl;

export {

namespace lib {

    /// @brief A fixed-capacity, SMP-aware bitmap.
    /// @tparam N Number of bits in the bitmap.
    /// @note Uses IBM MSB0 bit numbering (bit 0 is the MSB of the first word).
    template <usize N>
    class static_bitmap {
        static constexpr usize bits_per_word = 64;
        static constexpr usize word_count    = (N + bits_per_word - 1) / bits_per_word;

        using atomic_u64 = std::atomic<u64>;

        std::array<atomic_u64, word_count> m_storage{};

        /// @brief Mask of the valid bits in the last word.
        static constexpr auto last_word_mask() noexcept -> u64 {
            if constexpr (N % bits_per_word == 0) return ~0ULL;
            else return bit_range_mask_msb<u64>(0, (N % bits_per_word) - 1);
        }

    public:
        constexpr static_bitmap() noexcept = default;

        /// @brief Atomically set a bit.
        auto set(usize bit,
                 std::memory_order order = std::memory_order::seq_cst) noexcept -> void {
            if (bit >= N) [[unlikely]] return;
            discard_value m_storage[bit / bits_per_word].fetch_or(
                bit_mask_msb<u64>(bit % bits_per_word), order);
        }

        /// @brief Atomically clear a bit.
        auto clear(usize bit,
                   std::memory_order order = std::memory_order::seq_cst) noexcept -> void {
            if (bit >= N) [[unlikely]] return;
            discard_value m_storage[bit / bits_per_word].fetch_and(
                ~bit_mask_msb<u64>(bit % bits_per_word), order);
        }

        /// @brief Atomically test a bit.
        [[nodiscard]] auto test(
            usize bit,
            std::memory_order order = std::memory_order::relaxed
        ) const noexcept -> bool {
            if (bit >= N) [[unlikely]] return false;
            return bit_test_msb(
                m_storage[bit / bits_per_word].load(order),
                static_cast<u32>(bit % bits_per_word));
        }

        /// @brief Non-atomic set (caller holds exterior lock).
        auto set_relaxed(usize bit) noexcept -> void {
            if (bit >= N) [[unlikely]] return;
            u64 val = m_storage[bit / bits_per_word].load(std::memory_order::relaxed);
            val |= bit_mask_msb<u64>(bit % bits_per_word);
            m_storage[bit / bits_per_word].store(val, std::memory_order::relaxed);
        }

        /// @brief Non-atomic clear (caller holds exterior lock).
        auto clear_relaxed(usize bit) noexcept -> void {
            if (bit >= N) [[unlikely]] return;
            u64 val = m_storage[bit / bits_per_word].load(std::memory_order::relaxed);
            val &= ~bit_mask_msb<u64>(bit % bits_per_word);
            m_storage[bit / bits_per_word].store(val, std::memory_order::relaxed);
        }

        /// @brief Find first set bit.
        [[nodiscard]] auto find_first_set() const noexcept -> std::optional<usize> {
            for (usize i = 0; i < word_count; ++i) {
                u64 val = m_storage[i].load(std::memory_order::relaxed);
                if (i == word_count - 1) val &= last_word_mask();
                if (val != 0) {
                    const usize bit = static_cast<usize>(std::countl_zero(val));
                    return i * bits_per_word + bit;
                }
            }
            return std::nullopt;
        }

        /// @brief Find first set bit strictly after @p after.
        [[nodiscard]] auto find_next_set(usize after) const noexcept -> std::optional<usize> {
            const usize start = after + 1;
            if (start >= N) return std::nullopt;
            const usize start_word = start / bits_per_word;
            const usize start_bit  = start % bits_per_word;

            for (usize i = start_word; i < word_count; ++i) {
                u64 val = m_storage[i].load(std::memory_order::relaxed);
                if (i == word_count - 1) val &= last_word_mask();
                if (i == start_word && start_bit != 0) {
                    // Ignore bits at or before `after` in the first word.
                    val &= bit_range_mask_msb<u64>(start_bit, bits_per_word - 1);
                }
                if (val != 0) {
                    const usize bit = static_cast<usize>(std::countl_zero(val));
                    const usize res  = i * bits_per_word + bit;
                    if (res < N) return res;
                }
            }
            return std::nullopt;
        }

        /// @brief Find first unset bit.
        [[nodiscard]] auto find_first_unset() const noexcept -> std::optional<usize> {
            for (usize i = 0; i < word_count; ++i) {
                u64 val = ~m_storage[i].load(std::memory_order::relaxed);
                if (i == word_count - 1) val &= last_word_mask();
                if (val != 0) {
                    const usize bit = static_cast<usize>(std::countl_zero(val));
                    const usize res  = i * bits_per_word + bit;
                    if (res < N) return res;
                }
            }
            return std::nullopt;
        }

        /// @brief Count set bits.
        [[nodiscard]] auto count() const noexcept -> usize {
            usize total = 0;
            for (usize i = 0; i < word_count; ++i) {
                u64 val = m_storage[i].load(std::memory_order::relaxed);
                if (i == word_count - 1) val &= last_word_mask();
                total += static_cast<usize>(std::popcount(val));
            }
            return total;
        }

        [[nodiscard]] auto none() const noexcept -> bool {
            for (usize i = 0; i < word_count; ++i) {
                u64 val = m_storage[i].load(std::memory_order::relaxed);
                if (i == word_count - 1) val &= last_word_mask();
                if (val != 0) return false;
            }
            return true;
        }

        [[nodiscard]] auto any() const noexcept -> bool { return !none(); }
        [[nodiscard]] auto all() const noexcept -> bool { return count() == N; }

        /// @brief Clear the entire bitmap.
        auto reset() noexcept -> void {
            for (usize i = 0; i < word_count; ++i) {
                m_storage[i].store(0, std::memory_order::relaxed);
            }
        }
    };

} // namespace lib

} // end export
