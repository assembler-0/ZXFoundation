/// SPDX-License-Identifier: Apache-2.0
/// @file arch/s390x/cpu/ptf.cxxm
/// @brief PTF (PERFORM TOPOLOGY FUNCTION) kernel API.

export module arch.s390x.cpu.ptf;
import arch.s390x.cpu.features;
import zxfoundation.base.types;
import lib.bit;
import lib.stl;

#define __zxmacro_want_asm
#include macro_extensions

export {

namespace arch::s390x::cpu::ptf {

    enum class polarization : u8 {
        horizontal = 0,
        vertical   = 1,
    };

    enum class rejection_reason : u8 {
        unspecified       = 0,
        already_polarized = 1,
        change_in_process = 2,
    };

    enum class function_code : u8 {
        horizontal_polarization  = 0,
        vertical_polarization    = 1,
        check_topo_change_status = 2,
    };

    namespace detail {

        /// @brief Raw decoded PTF result.
        struct ptf_result {
            condition_code cc{};
            u8 rc{};
        };

        /// @brief Invoke PTF raw
        template <function_code Fc>
        [[nodiscard]] auto invoke() noexcept -> ptf_result {
            u64 r1{};
            lib::bit_insert_msb<u64>(r1, 56, 63, std::to_underlying(Fc));

            condition_code cc;
            __asm__ volatile(
                "   ptf %[r1]\n"
                __asm_capture_cc()
                : [r1] "+r" (r1), __asm_cc_out(cc)
                :
                : "cc", "memory"
            );

            return {
                .cc = cc,
                .rc = static_cast<u8>(lib::bit_extract_msb<u64>(r1, 48, 55)),
            };
        }

    } // namespace detail

    /// @brief Request that all CPUs in the configuration be moved to
    ///        the given polarization.
    template <polarization Pol>
    [[nodiscard]] auto set_polarization() noexcept
        -> std::expected<void, rejection_reason> {
        switch (const auto [cc, rc] = detail::invoke<Pol>(); cc) {
            case 0:  return {};
            case 2:  return std::unexpected(static_cast<rejection_reason>(rc));
            default: std::unreachable();
        }
    }

    /// @brief Check (and, if pending, consume) the topology-change-
    ///        report-pending condition for this configuration.
    [[nodiscard]] auto consume_topology_change_pending() noexcept -> bool {
        if (!features::has(features::facility::configuration_topology)) return false;
        switch (const auto [cc, _] = detail::invoke<function_code::check_topo_change_status>(); cc) {
            case 0:  return false;
            case 1:  return true;
            default: std::unreachable();
        }
    }

} // namespace arch::s390x::cpu::ptf

} // end export