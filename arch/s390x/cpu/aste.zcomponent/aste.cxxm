/// @file arch/s390x/cpu/aste.zcomponent/aste.cxxm
/// @brief z/Architecture ASTE/ALE/ALT type definitions

export module arch.s390x.cpu.aste;
export import arch.s390x.cpu.aste.consts;
export import :common;
import zxfoundation.base.types;
import lib.structure;
import lib.bitfield;

export {

namespace arch::s390x::cpu::aste {

    /// @brief ASTE accessors over the DSL layout
    template<class T>
    struct aste_ext {
        [[nodiscard]] auto is_invalid(this const T& self) noexcept -> bool {
            return self.template get<R"(word0\asx_invalid)">();
        }
        auto set_invalid(this T& self, bool inv) noexcept -> void {
            self.template set<R"(word0\asx_invalid)">(inv);
        }
        [[nodiscard]] auto asce(this const T& self) noexcept -> u64 {
            return self.template get<"asce">();
        }
        auto set_asce(this T& self, u64 val) noexcept -> void {
            self.template set<"asce">(val);
        }
        [[nodiscard]] auto ald(this const T& self) noexcept -> u64 {
            return self.template get<"ald">().underlying();
        }
        auto set_ald(this T& self, u64 val) noexcept -> void {
            self.template set<"ald">(lib::record<u32, lib::msb0_t,
                lib::rw<"alo", lib::bits<0, 25>, u32>,
                lib::rw<"all", lib::bits<26, 31>, u8>>{static_cast<u32>(val)});
        }
        [[nodiscard]] auto astesn(this const T& self) noexcept -> u32 {
            return self.template get<"astesn">();
        }
        auto set_astesn(this T& self, u32 val) noexcept -> void {
            self.template set<"astesn">(val);
        }
        auto clear(this T& self) noexcept -> void {
            for (usize off = 0; off < 64; off += 8)
                self.template raw_write<u64>(off, 0);
        }
        [[nodiscard]] auto authorization_index(this const T& self) noexcept -> u16 {
            return self.template get<R"(word0\ax)">();
        }
        auto set_authorization_index(this T& self, u16 ax) noexcept -> void {
            self.template set<R"(word0\ax)">(ax);
        }
        [[nodiscard]] auto ltd_raw(this const T& self) noexcept -> u32 {
            return static_cast<u32>(self.template get<"ltd">().underlying());
        }
        auto set_ltd_raw(this T& self, u32 ltd) noexcept -> void {
            self.template set<"ltd">(lib::record<u32, lib::msb0_t,
                lib::rw<"v",   lib::bits<0, 0>>,
                lib::rw<"lto", lib::bits<1, 24>, u32>,
                lib::rw<"ltl", lib::bits<25, 31>, u8>>{ltd});
        }
        [[nodiscard]] auto ltd_valid(this const T& self) noexcept -> bool {
            return self.template get<R"(ltd\v)">();
        }
        auto set_ltd_valid(this T& self, bool v) noexcept -> void {
            self.template set<R"(ltd\v)">(v);
        }
        [[nodiscard]] auto ltd_origin(this const T& self) noexcept -> u64 {
            return static_cast<u64>(self.template get<R"(ltd\lto)">()) << 7U;
        }
        auto set_ltd_origin(this T& self, u64 addr) noexcept -> void {
            self.template set<R"(ltd\lto)">(static_cast<u32>(addr >> 7U));
        }
        [[nodiscard]] auto ltd_length(this const T& self) noexcept -> u8 {
            return self.template get<R"(ltd\ltl)">();
        }
        auto set_ltd_length(this T& self, u8 ltl) noexcept -> void {
            self.template set<R"(ltd\ltl)">(ltl);
        }
        /// @brief Write the designation word in linkage-first-table form
        ///        (ASN-and-LX-reuse, PoP 5-36): V bit 0, LFT origin bits 1-23
        ///        with eight zeros appended, LFTL bits 24-31 in 256-byte units.
        /// @param lft_phys  Origin of the linkage-first table (page aligned).
        /// @param lftl      Length code: (LFTL+1) * 256 B (15 = one 4 KiB page).
        auto set_lftd(this T& self, u64 lft_phys, u8 lftl) noexcept -> void {
            // Fields are set through the DSL record — hand-packed shifts
            // put the origin in the wrong bit window (special-op 0x0013
            // on every PC; PoP 5-36 LFTD layout).
            lib::record<u32, lib::msb0_t,
                lib::rw<"v",    lib::bits<0, 0>>,
                lib::rw<"lfto", lib::bits<1, 23>, u32>,
                lib::rw<"lftl", lib::bits<24, 31>, u8>> packed{};
            packed.set<"v">(true);
            packed.set<"lfto">(static_cast<u32>(lft_phys >> 8U));
            packed.set<"lftl">(lftl);
            self.template set<"ltd">(packed);
        }
    };

    /// @brief ASN Second Table Entry
    using aste = lib::structure<64, 64, lib::endian::big,
        lib::extensions<aste_ext>,
        lib::rw<"word0", lib::bytes<0, 7>, lib::record<u64, lib::msb0_t,
            lib::rw<"asx_invalid", lib::bits<0, 0>>,
            lib::rw<"ato",         lib::bits<1, 29>, u32>,
            lib::rw<"base_space",  lib::bits<31, 31>>,
            lib::rw<"ax",          lib::bits<32, 47>, u16>,
            lib::rw<"atl",         lib::bits<48, 60>, u16>,
            lib::rw<"cr",          lib::bits<62, 62>>,
            lib::rw<"aa",          lib::bits<63, 63>>
        >>,
        lib::rw<"asce", lib::bytes<8, 15>, u64>,
        lib::rw<"ald",  lib::bytes<16, 19>, lib::record<u32, lib::msb0_t,
            lib::rw<"alo", lib::bits<0, 25>, u32>,
            lib::rw<"all", lib::bits<26, 31>, u8>
        >>,
        lib::rw<"astesn", lib::bytes<20, 23>, u32>,
        lib::rw<"ltd",  lib::bytes<24, 27>, lib::record<u32, lib::msb0_t,
            lib::rw<"v",   lib::bits<0, 0>>,
            lib::rw<"lto", lib::bits<1, 24>, u32>,
            lib::rw<"ltl", lib::bits<25, 31>, u8>
        >>,
        lib::rw<"astein", lib::bytes<28, 31>, u32>
    >;

    static_assert(sizeof(aste) == 64, "ASTE must be exactly 64 bytes (PoP §3.8.4)");

    /// @brief Access List Entry — 16 bytes.
    struct [[gnu::packed]] ale {
        u64 words[2]{};

        /// @brief Test the I-bit (invalid) in word 0.
        [[nodiscard]] auto is_invalid() const noexcept -> bool;

        /// @brief Set or clear the I-bit (invalid) in word 0.
        auto set_invalid(bool inv) noexcept -> void;

        /// @brief Return the real address of the referenced ASTE.
        [[nodiscard]] auto aste_origin() const noexcept -> u64;

        /// @brief Set the ASTE origin (must be 64-byte aligned).
        auto set_aste_origin(u64 addr) noexcept -> void;

        /// @brief Return the ALE sequence number used to validate an ALET.
        [[nodiscard]] auto sequence() const noexcept -> u8;

        /// @brief Set the ALE sequence number used to validate an ALET.
        auto set_sequence(u8 val) noexcept -> void;

        /// @brief Set whether the ALE prohibits store access.
        auto set_fetch_only(bool fetch_only) noexcept -> void;

        /// @brief Set the ASTE sequence number checked after ALE lookup.
        auto set_aste_sequence(u32 val) noexcept -> void;

        /// @brief Zero all words.
        auto clear() noexcept -> void;
    };

    static_assert(sizeof(ale) == 16, "ALE must be exactly 16 bytes (PoP §3.8.3)");

    /// @brief Allocate the DUCT and dispatchable-unit access list for one domain.
    [[nodiscard]] auto art_context_init(art_context& context) noexcept
        -> ::std::expected<void, ::lib::kernel_error>;

    /// @brief Release per-domain DUCT and access-list backing after every ALE
    /// referring to it has been revoked.
    auto art_context_destroy(art_context& context) noexcept -> void;

    /// @brief Install a domain's DUCT in CR2 on the current CPU.
    auto art_context_load(const art_context& context) noexcept -> void;

    /// @brief Allocate an ASTE slot and populate it with a target ASCE.
    /// @param target_asce  The Address Space Control Element of the target domain.
    /// @param auth_index   Authorization Index (AX) for this ASTE.
    /// @return The ASTE index on success, or an error.
    [[nodiscard]] auto aste_alloc(
        u64 target_asce,
        u16 auth_index
    ) noexcept -> ::std::expected<u32, ::lib::kernel_error>;

    /// @brief Free an ASTE slot, marking it as invalid.
    /// @param aste_index  The ASTE slot index to release.
    /// @return Success, or an error if the index is invalid.
    [[nodiscard]] auto aste_free(
        u32 aste_index
    ) noexcept -> ::std::expected<void, ::lib::kernel_error>;

    /// @brief Create an ALE in @p context that points to the given ASTE.
    /// @param aste_index  The ASTE slot that this ALE will reference.
    /// @return The ALET value (ALE slot index) on success, or an error.
    [[nodiscard]] auto ale_create(
        art_context& context,
        u32 aste_index
    ) noexcept -> ::std::expected<u32, ::lib::kernel_error>;

    /// @brief Invalidate an ALE and purge the ALB.
    /// @param alet  The ALET value (ALE slot index) to destroy.
    /// @return Success, or an error if the ALET is invalid.
    [[nodiscard]] auto ale_destroy(
        art_context& context,
        u32 alet
    ) noexcept -> ::std::expected<void, ::lib::kernel_error>;

    /// @brief The ASN-first-table origin field value for CR14 (phys >> 12).
    [[nodiscard]] auto aft_origin() noexcept -> u64;

    /// @brief Return the real (physical) origin of the ASTE slot.
    [[nodiscard]] auto aste_origin(u32 index) noexcept -> u64;

    /// @brief Return a pointer to the ASTE at the given index.
    /// @param index  The ASTE slot index (0 to MAX_ASTE_ENTRIES-1).
    /// @return Pointer to the ASTE, or nullptr if the index is out of range
    ///         or the subsystem is not initialized.
    [[nodiscard]] auto aste_find(u32 index) noexcept -> aste*;

} // namespace arch::s390x::cpu::aste

} // end export
