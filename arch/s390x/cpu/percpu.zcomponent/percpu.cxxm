/// SPDX-License-Identifier: Apache-2.0
/// @file arch/s390x/cpu/percpu.zcomponent/percpu.cxxm
/// @brief s390x per-CPU data block.

export module arch.s390x.cpu.percpu;
import arch.s390x.cpu.types;
import zxfoundation.base.types;
import zxfoundation.sync.qspinlock.mcs;
import zxfoundation.memory.pmm.types;
import lib.stl;

export {

namespace arch::s390x::cpu::percpu {

    using zxfoundation::memory::pmm::pcp_pool;

    /// @brief Explicit interrupt context classification.
    enum class irq_class : u8 {
        none      = 0,  ///< Not in any interrupt handler.
        ext       = 1,  ///< External interrupt (SAVE_FRAME from LC_EXT_OLD_PSW).
        io        = 2,  ///< I/O interrupt (SAVE_FRAME from LC_IO_OLD_PSW).
        pgm       = 3,  ///< Program check (SAVE_FRAME from LC_PGM_OLD_PSW).
        svc       = 4,  ///< Supervisor call (SAVE_NUCLEUS_FRAME from LC_SVC_OLD_PSW).
        mcck      = 5,  ///< Machine check (SAVE_FRAME from LC_MCCK_OLD_PSW).
        nucleus   = 6,  ///< Program-call (PC) gate entry.
    };

    /// @brief Read-only mirror of the authoritative lowcore current_domain
    ///        record
    struct attached_domain_snapshot {
        u64     asce{0};        ///< ASCE attached to CR1 for DGP tracking.
        u64     domain_ptr{0};  ///< VA of the attached domain struct (lowcore mirror).
        u32     domain_id{0};   ///< Domain ID owning attached_asce, or nucleus for idle/kernel.
        u8      dgp_state{0};   ///< Lifecycle snapshot admitted by the scheduler.
        u8      _pad[3]{0};
        u16     space_asn{0};   ///< Current PASN (space leg; != owner on a borrowed space).
        u8      space_borrowed{0};
        u8      _pad_space[5]{0};

        auto publish(u64 asce_v, u64 domain_ptr_v, u32 id, u8 state) noexcept -> void {
            asce = asce_v;
            domain_ptr = domain_ptr_v;
            domain_id = id;
            dgp_state = state;
        }

        auto publish_space(u16 asn, u8 borrowed) noexcept -> void {
            space_asn = asn;
            space_borrowed = borrowed;
        }
    };

    /// @brief s390x per-CPU data block.  See file-level comment for placement rationale.
    struct alignas(processor::CACHE_LINE_SIZE) percpu_data {
        u64     self_phys{};           ///< Physical address of this percpu_data instance (used for cross-CPU MCS node addressing by qspinlock; NOT the lowcore's physical address).

        u16     cpu_id{};              ///< Logical CPU ID (0 = BSP, dense, 0-based).
        u16     cpu_addr{};            ///< Hardware CPU address (from STAP instruction).
        u32     _pad0{};               ///< Explicit padding to align next u64.

        u8      _pad_domain[8]{};      ///< Former write-only current_domain mirror; see attached.
        u64     current_strand{};      ///< Virtual address of the currently executing strand.
        u64     kernel_stack{};        ///< Top of this CPU's kernel stack (virtual).
        u64     user_asce{};           ///< User ASCE (CR1 value for user address space).

        i32     preempt_count{};       ///< Preemption depth. >0 means non-preemptible.  Raw entry.S access via PCP_PREEMPT_COUNT.
        u32     irq_nesting{};         ///< Hardware IRQ/MCCK nesting depth (0 = not in IRQ handler).  Raw entry.S access via PCP_IRQ_NESTING.
        u32     nucleus_nesting{};     ///< Synchronous SVC/PC nucleus-call nesting depth.  Raw entry.S access via PCP_NUCLEUS_NESTING.
        u32     lock_depth{};          ///< Current qspinlock MCS node allocation depth.
        irq_class current_irq_class{}; ///< Explicit interrupt class being serviced (set by entry.S).  Raw entry.S access via PCP_IRQ_CLASS.
        u8      _pad_irq_class[3]{};   ///< Pad to u32 alignment.
        std::atomic<u64> ec_bits{};

        zxfoundation::sync::qspinlock::mcs_node qnodes[zxfoundation::sync::qspinlock::MCS_MAX_LOCK_DEPTH]{};

        u64     rcu_gp_seq{};          ///< Last observed RCU grace-period sequence number.
        u64     rcu_qs_seq{};          ///< Last quiescent-state sequence number.
        u8      in_rcu_read_side{};    ///< Non-zero if inside read_unlock().
        u8      _pad1[7]{};            ///< Pad to u64 alignment.

        void*   rcu_pending_cbs{nullptr};    ///< Head of pending rcu_head list (rcu_head*).
        u64     rcu_pending_gp{0};           ///< Grace period at which pending_cbs mature.
        u32     rcu_pending_count{0};        ///< Number of callbacks pending.
        u32     _pad_rcu{};

        u32     ipi_pending_count{};   ///< Counter of pending IPI completion events.
        u32     _pad2{};

        u64     ap_stack_phys{};       ///< Physical address of AP's initial stack top.

        pcp_pool pcp{};

        u8      drawer_id{0};
        u8      cpu_type{0};           ///< ZXFL_CPU_TYPE_* for this CPU (CP, IFL, zIIP, etc.)
        u8      core_id{0};            ///< Scheduler core-group ID from ZXFL/STSI or degraded fallback.
        u8      smt_id{0};             ///< SMT sibling ID inside core-group, zero when unproven.
        u8      topology_evidence{0};  ///< ZXFL_CPU_EVIDENCE_* provenance flags.
        u8      capacity{100};         ///< Scheduler capacity percentage, 100 when unknown.
        u8      _pad_drawer[2]{};

        attached_domain_snapshot attached{}; ///< §10.5 mirror (single writer: publish()).

        u64     watchdog_heartbeat{0}; ///< Monotonic counter bumped by scheduler_tick().

        u32     pgm_fixup_applied{0};     ///< Non-zero if last PGM applied a fixup (set by pgm handler).
        u64     pgm_fixup_addr{0};        ///< Fixup recovery label address set by try_applying_fixup.

        u32     ipd_count{0};             ///< Nullifying IPD event counter within sliding window.
        u64     ipd_window_deadline{0};   ///< Absolute TOD deadline resetting the IPD window.

        /// @brief Deferred-interrupt work bitmap
        std::atomic<u32> deferred_pending{};

        u8      _pad_fixup[2]{};

        u8      lockgraph_depth{0};
        u8      lockgraph_recursion{0};
        u8      _pad_lg[6]{};
        const void* lockgraph_held_inst[8]{nullptr};
        void*   lockgraph_held_map[8]{nullptr};
        u64     pending_dead_strand{};
    };

    /// @brief self_phys must be first — qspinlock and early bringup code rely
    ///        on this being readable without walking past other fields.
    static_assert(__builtin_offsetof(percpu_data, self_phys) == 0,
        "self_phys must be at offset 0 within percpu_data");
    static_assert(__builtin_offsetof(percpu_data, cpu_id) == 8,
        "cpu_id must be at offset 8 within percpu_data");
    static_assert(__builtin_offsetof(percpu_data, preempt_count) == 48,
        "preempt_count offset must match PCP_PREEMPT_COUNT in lowcore.h");
    static_assert(__builtin_offsetof(percpu_data, irq_nesting) == 52,
        "irq_nesting offset must match PCP_IRQ_NESTING in lowcore.h");
    static_assert(__builtin_offsetof(percpu_data, nucleus_nesting) == 56,
        "nucleus_nesting offset must match PCP_NUCLEUS_NESTING in lowcore.h");
    static_assert(__builtin_offsetof(percpu_data, current_irq_class) == 64,
        "current_irq_class offset must match PCP_IRQ_CLASS in lowcore.h");

    /// @brief Finish BSP per-CPU initialization.
    auto init_bsp() noexcept -> void;

    /// @brief Finish AP per-CPU initialization.
    /// @param pcp  Reference to the AP's percpu_data slot (percpu::at(cpu_id)).
    auto init_ap(percpu_data& pcp) noexcept -> void;

    /// @brief Return a reference to the current CPU's per-CPU block.
    [[nodiscard]] auto this_cpu() noexcept -> percpu_data&;

    /// @brief Direct, unconditional access to a logical CPU's percpu_data slot.
    /// @param[in] cpu_id  Logical CPU ID.
    [[nodiscard]] auto at(u16 cpu_id) noexcept -> percpu_data&;

    /// @brief Get other CPU's percpu
    [[nodiscard]] auto cpu_percpu(u16 cpu_id) noexcept -> percpu::percpu_data*;

    /// @brief get current cpu id
    [[nodiscard]] auto cpu_id() noexcept -> u16;

    /// @brief get current cpu's ZXFL_CPU_TYPE_* value
    [[nodiscard]] auto cpu_type() noexcept -> u8;

    /// @brief Return the lowercase short prefix for the current CPU type.
    [[nodiscard]] auto cpu_type_prefix() noexcept -> std::string_view;

} // namespace arch::s390x::cpu::percpu

} // end export
