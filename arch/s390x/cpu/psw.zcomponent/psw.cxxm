/// @file arch/s390x/cpu/psw.zcomponent/psw.cxxm
/// @brief z/Architecture PSW (Program Status Word) bit definitions.

export module arch.s390x.cpu.psw;
import zxfoundation.base.types;
import lib.bitfield;
import lib.structure;

export {

namespace arch::s390x::cpu::psw {

    /// @brief DAT (Dynamic Address Translation) enable bit
    constexpr u64 PSW_BIT_DAT        = 0x0400000000000000ULL;

    /// @brief I/O interrupt enable bit
    constexpr u64 PSW_BIT_IO         = 0x0200000000000000ULL;

    /// @brief External interrupt enable bit
    constexpr u64 PSW_BIT_EXT        = 0x0100000000000000ULL;

    /// @brief Machine-check interrupt enable bit
    constexpr u64 PSW_BIT_MCCK       = 0x0004000000000000ULL;

    /// @brief Wait state bit
    constexpr u64 PSW_BIT_WAIT       = 0x0002000000000000ULL;

    /// @brief Problem state (user mode) bit
    constexpr u64 PSW_BIT_PSTATE     = 0x0001000000000000ULL;

    /// @brief Extended addressing (EA) bit
    constexpr u64 PSW_BIT_EA         = 0x0000000100000000ULL;

    /// @brief Basic addressing (BA) bit
    constexpr u64 PSW_BIT_BA         = 0x0000000080000000ULL;

    /// @brief Primary Space Mode (ASC = 00) — no bits set.
    constexpr u64 PSW_ASC_PRIMARY    = 0x0000000000000000ULL;

    /// @brief Secondary Space Mode (ASC = 01).
    constexpr u64 PSW_ASC_SECONDARY  = 0x0000800000000000ULL;

    /// @brief Access register mode (ASC = 10).
    constexpr u64 PSW_ASC_ACCREG     = 0x0000400000000000ULL;

    /// @brief Home Space Mode (ASC = 11) — CR13 is the effective ASCE.
    constexpr u64 PSW_ASC_HOME       = 0x0000C00000000000ULL;

    /// @brief Default PSW storage key (key 0 — master key, unrestricted).
    constexpr u64 PSW_DEFAULT_KEY   = 0ULL;

    /// @brief 64-bit mode bits that MUST be present in every valid z/Arch PSW.
    constexpr u64 PSW_ARCH_BITS      = PSW_BIT_EA | PSW_BIT_BA;

    /// @brief Kernel execution mask: supervisor, DAT off, all interrupts disabled, 64-bit.
    constexpr u64 PSW_MASK_KERNEL    = PSW_DEFAULT_KEY | PSW_ARCH_BITS | PSW_ASC_PRIMARY;

    /// @brief Kernel DAT-on mask: supervisor, DAT on, all interrupts disabled, 64-bit.
    constexpr u64 PSW_MASK_KERNEL_DAT = PSW_DEFAULT_KEY | PSW_BIT_DAT | PSW_ARCH_BITS | PSW_ASC_HOME;

    /// @brief Kernel DAT-on mask with interrupts enabled (normal execution).
    constexpr u64 PSW_MASK_KERNEL_ENABLED =
        PSW_DEFAULT_KEY | PSW_BIT_DAT | PSW_BIT_IO | PSW_BIT_EXT | PSW_BIT_MCCK |
        PSW_ARCH_BITS | PSW_ASC_HOME;

    /// @brief User-mode PSW mask for entering a domain in problem state.
    constexpr u64 PSW_MASK_USER =
        PSW_DEFAULT_KEY |
        PSW_BIT_PSTATE  |
        PSW_BIT_DAT     |
        PSW_BIT_IO      |
        PSW_BIT_EXT     |
        PSW_BIT_MCCK    |
        PSW_ARCH_BITS   |
        PSW_ASC_PRIMARY;

    /// @brief PSW key field shift — bits 8–11 of the PSW mask word.
    constexpr u32 PSW_KEY_SHIFT = 52;

    /// @brief Disabled-wait PSW mask: wait state, no interrupts, 64-bit.
    constexpr u64 PSW_MASK_DISABLED_WAIT = PSW_DEFAULT_KEY | PSW_BIT_WAIT | PSW_ARCH_BITS;

    /// @brief Enabled-wait PSW mask.
    constexpr u64 PSW_MASK_ENABLED_WAIT =
        PSW_DEFAULT_KEY | PSW_BIT_DAT   | PSW_BIT_IO | PSW_BIT_EXT | PSW_BIT_MCCK |
        PSW_BIT_WAIT    | PSW_ARCH_BITS | PSW_ASC_HOME;

    /// @brief Standard halt address (appears in disabled-wait PSW during normal shutdown).
    constexpr u64 PSW_STD_HALT_ADDR  = 0x0000000000DEAD00ULL;

    constexpr u64 PSW_LC_RESTART     = 0x01A0ULL; ///< Restart new PSW
    constexpr u64 PSW_LC_EXTERNAL    = 0x01B0ULL; ///< External new PSW.
    constexpr u64 PSW_LC_SVC         = 0x01C0ULL; ///< Supervisor-call new PSW.
    constexpr u64 PSW_LC_PROGRAM     = 0x01D0ULL; ///< Program-check new PSW.
    constexpr u64 PSW_LC_MCCK        = 0x01E0ULL; ///< Machine-check new PSW.
    constexpr u64 PSW_LC_IO          = 0x01F0ULL; ///< I/O new PSW.

    enum class psw_basic_addressing_modes : u64 {
        amode24    = 0b00,
        amode31    = 0b01,
        amode64    = 0b11,
    };

    using psw_mask = lib::record<u64, lib::msb0_t,
        lib::rw<"per_mask", lib::bits<1, 1>>,
        lib::rw<"dat_mode", lib::bits<5, 5>>,
        lib::rw<"io_mask", lib::bits<6, 6>>,
        lib::rw<"external_mask", lib::bits<7, 7>>,
        lib::rw<"psw_key", lib::bits<8, 11>>,
        lib::rw<"machine_check_mask", lib::bits<13, 13>>,
        lib::rw<"wait_state", lib::bits<14, 14>>,
        lib::rw<"problem_state", lib::bits<15, 15>>,
        lib::rw<"address_space_control", lib::bits<16, 17>>,
        lib::rw<"condition_code", lib::bits<18, 19>>,
        lib::overlay_rw<"pgm_mask", lib::bits<20, 23>>,
        lib::rw<R"(pgm_mask\fixed_point_overflow)", lib::bits<20, 20>>,
        lib::rw<R"(pgm_mask\decimal_overflow)", lib::bits<21, 21>>,
        lib::rw<R"(pgm_mask\hfp_exponent_underflow)", lib::bits<22, 22>>,
        lib::rw<R"(pgm_mask\hfp_significance)", lib::bits<23, 23>>,
        lib::overlay_rw<"addressing_mode", lib::bits<31, 32>, psw_basic_addressing_modes>,
        lib::rw<"extended_addressing_mode", lib::bits<31, 31>>,
        lib::rw<"basic_addressing_mode", lib::bits<32, 32>>
    >;

    using psw_mask_view = lib::record_ref<u64, lib::msb0_t,
        lib::rw<"per_mask", lib::bits<1, 1>>,
        lib::rw<"dat_mode", lib::bits<5, 5>>,
        lib::rw<"io_mask", lib::bits<6, 6>>,
        lib::rw<"external_mask", lib::bits<7, 7>>,
        lib::rw<"psw_key", lib::bits<8, 11>>,
        lib::rw<"machine_check_mask", lib::bits<13, 13>>,
        lib::rw<"wait_state", lib::bits<14, 14>>,
        lib::rw<"problem_state", lib::bits<15, 15>>,
        lib::rw<"address_space_control", lib::bits<16, 17>>,
        lib::rw<"condition_code", lib::bits<18, 19>>,
        lib::overlay_rw<"pgm_mask", lib::bits<20, 23>>,
        lib::rw<R"(pgm_mask\fixed_point_overflow)", lib::bits<20, 20>>,
        lib::rw<R"(pgm_mask\decimal_overflow)", lib::bits<21, 21>>,
        lib::rw<R"(pgm_mask\hfp_exponent_underflow)", lib::bits<22, 22>>,
        lib::rw<R"(pgm_mask\hfp_significance)", lib::bits<23, 23>>,
        lib::overlay_rw<"addressing_mode", lib::bits<31, 32>, psw_basic_addressing_modes>,
        lib::rw<"extended_addressing_mode", lib::bits<31, 31>>,
        lib::rw<"basic_addressing_mode", lib::bits<32, 32>>
    >;

    using zpsw = lib::structure<16, 8, lib::endian::big,
        lib::rw<"mask", lib::auto_layout, psw_mask>,
        lib::rw<"address", lib::auto_layout, u64>
    >;

    using zpsw_view = lib::structure_ref<16, 8, lib::endian::big,
        lib::rw<"mask", lib::auto_layout, psw_mask>,
        lib::rw<"address", lib::auto_layout, u64>
    >;

    using short_psw = lib::record<u64, lib::msb0_t,
        lib::rw<"per_mask", lib::bits<1, 1>>,
        lib::rw<"dat_mode", lib::bits<5, 5>>,
        lib::rw<"io_mask", lib::bits<6, 6>>,
        lib::rw<"external_mask", lib::bits<7, 7>>,
        lib::rw<"psw_key", lib::bits<8, 11>>,
        lib::rw<"machine_check_mask", lib::bits<13, 13>>,
        lib::rw<"wait_state", lib::bits<14, 14>>,
        lib::rw<"problem_state", lib::bits<15, 15>>,
        lib::rw<"address_space_control", lib::bits<16, 17>>,
        lib::rw<"condition_code", lib::bits<18, 19>>,
        lib::overlay_rw<"pgm_mask", lib::bits<20, 23>>,
        lib::rw<R"(pgm_mask\fixed_point_overflow)", lib::bits<20, 20>>,
        lib::rw<R"(pgm_mask\decimal_overflow)", lib::bits<21, 21>>,
        lib::rw<R"(pgm_mask\hfp_exponent_underflow)", lib::bits<22, 22>>,
        lib::rw<R"(pgm_mask\hfp_significance)", lib::bits<23, 23>>,
        lib::overlay_rw<"addressing_mode", lib::bits<31, 32>, psw_basic_addressing_modes>,
        lib::rw<"extended_addressing_mode", lib::bits<31, 31>>,
        lib::rw<"basic_addressing_mode", lib::bits<32, 32>>,
        lib::rw<"instruction_address", lib::bits<33, 63>>
    >;

    using short_psw_view = lib::record_ref<u64, lib::msb0_t,
        lib::rw<"per_mask", lib::bits<1, 1>>,
        lib::rw<"dat_mode", lib::bits<5, 5>>,
        lib::rw<"io_mask", lib::bits<6, 6>>,
        lib::rw<"external_mask", lib::bits<7, 7>>,
        lib::rw<"psw_key", lib::bits<8, 11>>,
        lib::rw<"machine_check_mask", lib::bits<13, 13>>,
        lib::rw<"wait_state", lib::bits<14, 14>>,
        lib::rw<"problem_state", lib::bits<15, 15>>,
        lib::rw<"address_space_control", lib::bits<16, 17>>,
        lib::rw<"condition_code", lib::bits<18, 19>>,
        lib::overlay_rw<"pgm_mask", lib::bits<20, 23>>,
        lib::rw<R"(pgm_mask\fixed_point_overflow)", lib::bits<20, 20>>,
        lib::rw<R"(pgm_mask\decimal_overflow)", lib::bits<21, 21>>,
        lib::rw<R"(pgm_mask\hfp_exponent_underflow)", lib::bits<22, 22>>,
        lib::rw<R"(pgm_mask\hfp_significance)", lib::bits<23, 23>>,
        lib::overlay_rw<"addressing_mode", lib::bits<31, 32>, psw_basic_addressing_modes>,
        lib::rw<"extended_addressing_mode", lib::bits<31, 31>>,
        lib::rw<"basic_addressing_mode", lib::bits<32, 32>>,
        lib::rw<"instruction_address", lib::bits<33, 63>>
    >;

    using esa390_psw = lib::record<u64, lib::msb0_t,
        lib::rw<"per_mask", lib::bits<1, 1>>,
        lib::rw<"dat_mode", lib::bits<5, 5>>,
        lib::rw<"io_mask", lib::bits<6, 6>>,
        lib::rw<"external_mask", lib::bits<7, 7>>,
        lib::rw<"psw_key", lib::bits<8, 11>>,
        lib::rw<"machine_check_mask", lib::bits<13, 13>>,
        lib::rw<"wait_state", lib::bits<14, 14>>,
        lib::rw<"problem_state", lib::bits<15, 15>>,
        lib::rw<"address_space_control", lib::bits<16, 17>>,
        lib::rw<"condition_code", lib::bits<18, 19>>,
        lib::overlay_rw<"pgm_mask", lib::bits<20, 23>>,
        lib::rw<R"(pgm_mask\fixed_point_overflow)", lib::bits<20, 20>>,
        lib::rw<R"(pgm_mask\decimal_overflow)", lib::bits<21, 21>>,
        lib::rw<R"(pgm_mask\hfp_exponent_underflow)", lib::bits<22, 22>>,
        lib::rw<R"(pgm_mask\hfp_significance)", lib::bits<23, 23>>,
        lib::rw<"addressing_mode", lib::bits<32, 32>>,
        lib::rw<"instruction_address", lib::bits<33, 63>>
    >;

    using esa390_psw_view = lib::record_ref<u64, lib::msb0_t,
        lib::rw<"per_mask", lib::bits<1, 1>>,
        lib::rw<"dat_mode", lib::bits<5, 5>>,
        lib::rw<"io_mask", lib::bits<6, 6>>,
        lib::rw<"external_mask", lib::bits<7, 7>>,
        lib::rw<"psw_key", lib::bits<8, 11>>,
        lib::rw<"machine_check_mask", lib::bits<13, 13>>,
        lib::rw<"wait_state", lib::bits<14, 14>>,
        lib::rw<"problem_state", lib::bits<15, 15>>,
        lib::rw<"address_space_control", lib::bits<16, 17>>,
        lib::rw<"condition_code", lib::bits<18, 19>>,
        lib::overlay_rw<"pgm_mask", lib::bits<20, 23>>,
        lib::rw<R"(pgm_mask\fixed_point_overflow)", lib::bits<20, 20>>,
        lib::rw<R"(pgm_mask\decimal_overflow)", lib::bits<21, 21>>,
        lib::rw<R"(pgm_mask\hfp_exponent_underflow)", lib::bits<22, 22>>,
        lib::rw<R"(pgm_mask\hfp_significance)", lib::bits<23, 23>>,
        lib::rw<"addressing_mode", lib::bits<32, 32>>,
        lib::rw<"instruction_address", lib::bits<33, 63>>
    >;

    struct [[gnu::packed]] alignas(u64) epsw_words {
        u32 hi;
        u32 lo;
    };

    static_assert(sizeof(zpsw) == 16,       "zx_psw must be exactly 16 bytes");
    static_assert(alignof(zpsw) == 8,       "zx_psw must be 8-byte aligned");

    /// @brief Extract the current PSW mask via EPSW. addr is unavailable; set to 0.
    [[nodiscard]] auto extract_psw() noexcept -> zpsw;

    [[noreturn]] auto load_psw(const zpsw& psw) noexcept -> void;

    [[noreturn]] auto disabled_wait() noexcept -> void;

    /// @brief Enter enabled-wait state — the z/Architecture idle primitive.
    auto enabled_wait() noexcept -> void;

    auto write_psw_to_lowcore(u64 lc_offset, zpsw psw) noexcept -> void;

    [[nodiscard]] auto make_handler_psw(u64 entry_virt) noexcept -> zpsw;
    [[nodiscard]] auto make_ap_restart_psw(u64 entry_phys) noexcept -> zpsw;

} // namespace arch::s390x::cpu::psw

} // end export
