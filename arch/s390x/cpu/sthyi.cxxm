		u16 infyscps{};
		u16 infydcps{};
		u16 infysifl{};
		u16 infydifl{};
		std::array<inf0hyp_infyins, 8> infyinsf{};
		std::array<inf0hyp_infyaut, 8> infyautf{};
		uchar infyziipt{};
		bytersvd(1){};
		i16 infysziip{};
		bytersvd(4){};
	};
	assert_size(inf0hyp, 0x38);

	enum class inf0gst_infgcpdt : u8 {
		infgpuccp   = 0x00,
		infgpucifl  = 0x03,
		infgpuczip  = 0x05,
		infgpuczcp  = 0xff,
	};

	enum class inf0gst_infgifdt : u8 {
