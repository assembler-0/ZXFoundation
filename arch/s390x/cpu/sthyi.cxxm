	struct [[gnu::packed]] inf0gst {
		union {
			uchar infgflg1{};
			struct {
				bitfield(infgmob);
				bitfield(infgmcpt);
				bitfield(infgcplh);
				bitfield(infgiglh);
				bitfield(infgvpt);
