		u16 inf1gof{};
		u16 inf1gln{};
		u16 inf1gvr{};
		bytersvd(2){};
	};
	assert_size(inf1yghd, 0x10);

	struct [[gnu::packed]] inf1hdr {
		union {
			uchar inf1hfl1{};
			struct {
				bitfield(inf1gdpu);
				bitfield(inf1sthy);
				bitfield(inf1vsi);
				bitfield(inf1basc);
				bitfield(inf1fcfc);
				bitfield(inf1fcau);
				bitrsvd(2);
			};
		};
		uchar inf1hfl2{};
		uchar inf1hvl1{};
		uchar inf1hvl2{};
		bytersvd(3){};
		u8 inf1hygc{};
		u16 inf1moff{};
		u16 inf1mlen{};
		u16 infpoff{};
		u16 infplen{};
		inf1yghd inf1hyg[3];
