	assert_size(inf0gst, 0x48);

	template <>
	struct hvg_leveled_traits<inf0hdr> {
		static auto count(const inf0hdr& h) -> u8 { return std::min<u8>(h.infhygct, 3); }
		static auto at(const inf0hdr& h, u8 i) -> hvg_pair {
			auto& e = h.infhygs[i];
			return { e.infyoff, e.infylen, 0, e.infgoff, e.infglen, 0 };
		}
	};

	template <>
	struct machine_traits<inf0hdr> {
		static auto at(const inf0hdr& h) -> machine_pair {
			return { h.infmoff, h.infmlen };
		}
	};

	template <>
	struct partition_traits<inf0hdr> {
		static auto at(const inf0hdr& h) -> partition_pair {
			return { h.infpoff, h.infplen };
		}
	};

	using inf0hdr_layout = infhdr_layout<NoBase, inf0hdr>;
	using inf0view = hv_view<inf0hdr_layout, inf0mac, inf0par, inf0hyp, inf0gst>;

	struct [[gnu::packed]] infchdr {
		u16 infcvrsn{};
		u16 infchdln{};
		u32 infctotl{};
		u16 infcrqsz{};
		u16 infclsof{};
		u16 infcenln{};
		bytersvd(2){};
		u32 infccten{};
		bytersvd(4){};
		bytersvd(24){};
		std::array<u64, 2> infcfcus{};
	};
	assert_size(infchdr, 0x40);

	struct inf1yghd {
		u16 inf1yof{};
