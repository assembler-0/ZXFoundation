/// SPDX-License-Identifier: Apache-2.0
/// @file arch/s390x/cpu/sthyi.cxxm
/// @brief STHYI (Store Hypervisor Information) types and constants.
/// @ref IBM z/VM 7.3 CP Programming (chapter 29. STHYI - STORE HYPERVISOR INFORMATION)

export module arch.s390x.cpu.sthyi;
import zxfoundation.base.types;
import arch.s390x.cpu.types;
import arch.s390x.cpu.features;
import lib.cstring;
import lib.bit;
import lib.error;
import lib.charconv;
import std;

__endian__(BIG);

export {

namespace arch::s390x::cpu::sthyi {

	enum class sthyi_fc : u8 {
		processor_capability_function = 0x0,
		hypervisor_environment_info   = 0x1,
		guest_list					  = 0x2,
		designated_guest_info		  = 0x3,
		resource_pool_list 			  = 0x4,
		designated_resource_pool_info = 0x5,
		resource_pool_member_list	  = 0x6
	};

	enum class sthyi_rc : u32 {
		ok          		      = 0x00,
		unsupported_fc		      = 0x04,
		not_authorized		      = 0x08,
		invalid_name		      = 0x0c,
		unknown_none			  = 0x10,
		response_buffer_too_small = 0x14,
		unknown					  = 0xff
	};

	struct sthyi_result {
		sthyi_rc rc{};
		condition_code cc{};
	};

	struct NoBase {};
	struct NoExt {};

	template <typename Base = NoBase, typename Ext = NoExt>
	struct infhdr_layout {
		using base_type = Base;
		using ext_type  = Ext;
		static constexpr bool has_base = !std::same_as<Base, NoBase>;
		static constexpr bool has_ext  = !std::same_as<Ext,  NoExt>;
	};

	template <typename L> concept has_base_hdr = L::has_base;
	template <typename L> concept has_ext_hdr  = L::has_ext;

	template <typename L>
	class infhdr_view {
	public:
		explicit infhdr_view(std::span<const std::byte> buf) : buf_(buf) {}

		auto header() const -> const L::base_type& requires has_base_hdr<L> {
			return *reinterpret_cast<const L::base_type*>(buf_.data());
		}
		auto extended_header() const -> const L::ext_type& requires has_ext_hdr<L> {
			constexpr usize off = has_base_hdr<L> ? sizeof(typename L::base_type) : 0;
			return *reinterpret_cast<const L::ext_type*>(buf_.data() + off);
		}

	private:
		std::span<const std::byte> buf_;
	};

	struct hvg_pair {
		u16 hyp_off{}, hyp_len{}, hyp_ver{};
		u16 gst_off{}, gst_len{}, gst_ver{};
	};

	struct machine_pair {
		u16 mac_off{}, mac_len{};
	};

	struct partition_pair {
		u16 poff{}, plen{};
	};

	template <typename HeaderT> struct hvg_leveled_traits;
	template <typename HeaderT> struct machine_traits;
	template <typename HeaderT> struct partition_traits;

	template <typename T>
	[[nodiscard]] auto bounded_section(std::span<const std::byte> buf, u16 off, u16 len) -> std::optional<T> {
	    if (!len || static_cast<usize>(off) + len > buf.size()) return std::nullopt;
	    T out{};
	    lib::memcpy(&out, buf.data() + off, std::min<usize>(len, sizeof(T)));
	    return out;
	}

	template <typename LayoutT, typename MacT, typename ParT, typename HypT, typename GstT>
	class hv_view {
	public:
	    explicit hv_view(std::span<const std::byte> buf) : buf_(buf) {}

		[[nodiscard]] auto header() const -> const LayoutT::base_type& requires has_base_hdr<LayoutT> {
	    	return infhdr_view<LayoutT>{buf_}.header();
	    }

		[[nodiscard]] auto extended_header() const -> const LayoutT::ext_type& requires has_ext_hdr<LayoutT> {
	    	return infhdr_view<LayoutT>{buf_}.extended_header();
	    }

		[[nodiscard]] auto machine() const -> std::optional<MacT> {
		    auto p = machine_traits<typename LayoutT::ext_type>::at(extended_header());
			return bounded_section<MacT>(buf_, p.mac_off, p.mac_len);
	    }

		[[nodiscard]] auto partition() const -> std::optional<ParT> {
	    	auto p = partition_traits<typename LayoutT::ext_type>::at(extended_header());
	    	return bounded_section<ParT>(buf_, p.poff, p.plen);
	    }

	    struct level { std::optional<HypT> hyp{}; std::optional<GstT> gst{}; };

	    class level_iterator {
	    public:
	        using value_type = level;
	    	using difference_type = std::ptrdiff_t;
	        using iterator_category = std::forward_iterator_tag;
	        level_iterator() = default;
	        level_iterator(const hv_view* v, u8 i) : v_(v), i_(i) {}
	        auto operator*() const -> level {
	            auto p = hvg_leveled_traits<typename LayoutT::ext_type>::at(v_->extended_header(), i_);
	            return { bounded_section<HypT>(v_->buf_, p.hyp_off, p.hyp_len),
	                     bounded_section<GstT>(v_->buf_, p.gst_off, p.gst_len) };
	        }
	        auto operator++() -> level_iterator& { ++i_; return *this; }
	        auto operator++(int) -> level_iterator { auto t = *this; ++i_; return t; }
	        auto operator==(const level_iterator&) const -> bool = default;
	    private:
	        const hv_view* v_ = nullptr; u8 i_ = 0;
	    };

	    [[nodiscard]] auto begin() const -> level_iterator { return {this, 0}; }
	    [[nodiscard]] auto end()   const -> level_iterator { return {this, hvg_leveled_traits<typename LayoutT::ext_type>::count(extended_header())}; }

	private:
	    std::span<const std::byte> buf_;
	};

	template <typename LayoutT, typename EntryT>
	class list_view {
	public:
		explicit list_view(std::span<const std::byte> buf) : buf_(buf) {}

		[[nodiscard]] auto header() const -> const LayoutT::base_type& requires has_base_hdr<LayoutT> {
			return infhdr_view<LayoutT>{buf_}.header();
		}

		[[nodiscard]] auto extended_header() const -> const LayoutT::ext_type& requires has_ext_hdr<LayoutT> {
			return infhdr_view<LayoutT>{buf_}.extended_header();
		}

		[[nodiscard]] auto required_pages() const -> u16 { return header().infcrqsz; }

		class iterator {
		public:
			using value_type        = EntryT;
			using difference_type   = std::ptrdiff_t;
			using iterator_category = std::forward_iterator_tag;

			iterator() = default;
			iterator(const std::byte* base, u16 stride, u32 idx) : base_(base), stride_(stride), idx_(idx) {}

			auto operator*() const -> EntryT {
				EntryT out{};
				lib::memcpy(&out, base_ + static_cast<usize>(idx_) * stride_,
							std::min<usize>(stride_, sizeof(EntryT)));
				return out;
			}
			auto operator++() -> iterator& { ++idx_; return *this; }
			auto operator++(int) -> iterator { auto t = *this; ++idx_; return t; }
			auto operator==(const iterator&) const -> bool = default;

		private:
			const std::byte* base_ = nullptr;
			u16 stride_ = 0;
			u32 idx_ = 0;
		};

		[[nodiscard]] auto begin() const -> iterator {
			auto& c = header();
			if (!c.infclsof || !c.infcenln || !c.infccten) return end();
			return { buf_.data() + c.infclsof, c.infcenln, 0 };
		}
		[[nodiscard]] auto end() const -> iterator {
			auto& c = header();
			u32 max_fit = (c.infcenln && c.infclsof <= buf_.size())
				? static_cast<u32>((buf_.size() - c.infclsof) / c.infcenln) : 0;
			return { buf_.data() + c.infclsof, c.infcenln, std::min(c.infccten, max_fit) };
		}

	private:
		std::span<const std::byte> buf_;
	};

	template <sthyi_fc Fc> struct sthyi_traits;

	template <> struct sthyi_traits<sthyi_fc::processor_capability_function> {
		using pb_type = std::array<std::byte, PAGE_SIZE>;
		static constexpr bool fixed_size   = true;
		static constexpr bool requires_key = false;
	};
	template <> struct sthyi_traits<sthyi_fc::hypervisor_environment_info> {
		using pb_type = std::array<std::byte, PAGE_SIZE>;
		static constexpr bool fixed_size   = true;
		static constexpr bool requires_key = false;
	};
	template <> struct sthyi_traits<sthyi_fc::guest_list> {
		using pb_type = std::span<std::byte>;
		static constexpr bool fixed_size   = false;
		static constexpr bool requires_key = false;
	};
	template <> struct sthyi_traits<sthyi_fc::designated_guest_info> {
		using pb_type = std::array<std::byte, PAGE_SIZE>;
		static constexpr bool fixed_size   = true;
		static constexpr bool requires_key = true;
	};
	template <> struct sthyi_traits<sthyi_fc::resource_pool_list> {
		using pb_type = std::span<std::byte>;
		static constexpr bool fixed_size   = false;
		static constexpr bool requires_key = false;
	};
	template <> struct sthyi_traits<sthyi_fc::designated_resource_pool_info> {
		using pb_type = std::array<std::byte, PAGE_SIZE>;
		static constexpr bool fixed_size   = true;
		static constexpr bool requires_key = true;
	};
	template <> struct sthyi_traits<sthyi_fc::resource_pool_member_list> {
		using pb_type = std::span<std::byte>;
		static constexpr bool fixed_size   = false;
		static constexpr bool requires_key = true;
	};

	namespace detail {

		template <sthyi_fc Fc>
		auto invoke(void* buf, u16 num_pages, u64 key) -> std::expected<sthyi_result, lib::kernel_error> {
			if (!features::has(features::facility::store_hypervisor_info))
				return std::unexpected(lib::kernel_error::from_generic(lib::generic_error::not_supported));
			processor::register_pair r1{ .odd = key };
			lib::bit_insert_msb<u64>(r1.even, 48, 63, std::to_underlying(Fc));
			if constexpr (!sthyi_traits<Fc>::fixed_size)
				lib::bit_insert_msb<u64>(r1.even, 32, 47, num_pages);

			processor::register_pair r2{ .even = reinterpret_cast<u64>(buf), .odd = 0 };
			condition_code cc;

			__asm__ volatile(
				".insn   rre,0xB2560000,%[r1],%[r2]\n"
				"ipm     %[cc]\n"
				"srl     %[cc],28\n"
				: [cc] "=d" (cc), [r2] "+&d" (r2.pair)
				: [r1] "d" (r1.pair)
				: "cc", "memory");

			auto rc = static_cast<sthyi_rc>(r2.odd);
			return sthyi_result { cc == 0 ? sthyi_rc::ok : rc, cc };
		}

	} // namespace detail

	struct sthyi_key {
		u64 raw{};

		static constexpr auto from_ascii(std::string_view name) -> sthyi_key {
			u64 v = 0;
			for (usize i = 0; i < 8; ++i)
				v = (v << 8) | (i < name.size() ? lib::charconv::ascii_to_ebcdic(name[i]) : 0x40);
			return { v };
		}
	};

	template <sthyi_fc Fc>
		requires (sthyi_traits<Fc>::fixed_size && !sthyi_traits<Fc>::requires_key)
	auto invoke(typename sthyi_traits<Fc>::pb_type& pb)
		-> std::expected<sthyi_result, lib::kernel_error>
	{
		if (reinterpret_cast<u64>(pb.data()) & 0xFFF)
			return std::unexpected(lib::kernel_error::from_memory(lib::memory_error::alignment_error));
		return detail::invoke<Fc>(pb.data(), 0, 0);
	}

	template <sthyi_fc Fc>
		requires (sthyi_traits<Fc>::fixed_size && sthyi_traits<Fc>::requires_key)
	auto invoke(typename sthyi_traits<Fc>::pb_type& pb, sthyi_key key)
		-> std::expected<sthyi_result, lib::kernel_error>
	{
		if (reinterpret_cast<u64>(pb.data()) & 0xFFF)
			return std::unexpected(lib::kernel_error::from_memory(lib::memory_error::alignment_error));
		return detail::invoke<Fc>(pb.data(), 0, key.raw);
	}

	template <sthyi_fc Fc>
		requires (!sthyi_traits<Fc>::fixed_size && !sthyi_traits<Fc>::requires_key)
	auto invoke(typename sthyi_traits<Fc>::pb_type& pb)
		-> std::expected<sthyi_result, lib::kernel_error>
	{
		if (!(pb.size() && !(pb.size() % PAGE_SIZE)))
			return std::unexpected(lib::kernel_error::from_memory(lib::memory_error::alignment_error));
		return detail::invoke<Fc>(pb.data(), static_cast<u16>(pb.size() / PAGE_SIZE), 0);
	}

	template <sthyi_fc Fc>
		requires (!sthyi_traits<Fc>::fixed_size && sthyi_traits<Fc>::requires_key)
	auto invoke(typename sthyi_traits<Fc>::pb_type& pb, sthyi_key key) -> std::expected<sthyi_result, lib::kernel_error> {
		if (!(pb.size() && !(pb.size() % PAGE_SIZE)))
			return std::unexpected(lib::kernel_error::from_memory(lib::memory_error::alignment_error));
		return detail::invoke<Fc>(pb.data(), static_cast<u16>(pb.size() / PAGE_SIZE), key.raw);
	}

	struct [[gnu::packed]] inf0hdyg {
		u16 infyoff{};
		u16 infylen{};
		u16 infgoff{};
		u16 infglen{};
	};
	assert_size(inf0hdyg, 0x8);

	constexpr u8 INF0YGMX = 3;

	struct [[gnu::packed]] inf0hdr {
		union {
			uchar infhflg1{};
			struct {
				bitfield(infgpdu);
				bitfield(infsthyi);
				bitfield(infvsi);
				bitfield(infbasic);
				bitrsvd(4);
			};
		};
		uchar infhflg2{};
		uchar infhval1{};
		uchar infhval2{};
		bytersvd(3){};
		u8 infhygct{};
		u16 infhtotl{};
		u16 infhdln{};
		u16 infmoff{};
		u16 infmlen{};
		u16 infpoff{};
		u16 infplen{};
		std::array<inf0hdyg, 3> infhygs{};
		bytersvd(4){};
	};
	assert_size(inf0hdr, 0x30);

	struct [[gnu::packed]] inf0mac {
		union {
			uchar infmflg1{};
			struct {
				bitfield(infmpool);
				bitrsvd(7);
			};
		};
		uchar infmflg2{};
		union {
			uchar infmval1{};
			struct {
				bitfield(infmproc);
				bitfield(infmmid);
				bitfield(infmmnam);
				bitfield(infmplnv);
				bitfield(infmziipv);
				bitrsvd(3);
			};
		};
		uchar infmval2{};
		u16 infmscps{};
		u16 infmdcps{};
		u16 infmsifl{};
		u16 infmdifl{};
		std::array<uchar, 8> infmname{};
		std::array<uchar, 4> infmtype{};
		std::array<uchar, 16> infmmanu{};
		std::array<uchar, 16> infmseq{};
		std::array<uchar, 4> infmpman{};
		bytersvd(4){};
		u64 infmplnm{};
		u16 infmsziip{};
		u16 infmdziip{};
		bytersvd(4){};
	};
	assert_size(inf0mac, 0x50);

	struct [[gnu::packed]] inf0par {
		union {
			uchar infpflg1{};
			struct {
				bitfield(infpmten);
				bitfield(infppool);
				bitrsvd(6);
			};
		};
		uchar infpflg2{};
		union {
			uchar infpval1{};
			struct {
				bitfield(infpproc);
				bitfield(infpwbcc);
				bitfield(infpacc);
				bitfield(infppid);
				bitfield(infplgvl);
				bitfield(infpplnv);
				bitfield(infpziipv);
				bitrsvd(1);
			};
		};
		uchar infpval2{};
		u16 infppnum{};
		u16 infpscps{};
		u16 infpdcps{};
		u16 infpsifl{};
		u16 infpdifl{};
		bytersvd(2){};
		std::array<uchar, 8> infppnam{};
		u32 infpwbcp{};
		u32 infpabcp{};
		u32 infpwbif{};
		u32 infpabif{};
		std::array<uchar, 8> infplgnm{};
		u32 infplgcp{};
		u32 infplgif{};
		std::array<uchar, 8> infpplnm{};
		i16 infpsziip{};
		i16 infpdziip{};
		i16 infpwbziip{};
		bytersvd(2){};
		i32 infpabziip{};
		i32 infplgziip{};
	};
	assert_size(inf0par, 0x50);

	enum class inf0hyp_infytype : u8 {
		infytvm   = 0x1,
		infytkvm  = 0x2,
		infytzcx  = 0x3
	};

	union [[gnu::packed]] inf0hyp_infyins {
