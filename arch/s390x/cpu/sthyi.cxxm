	template <>
	struct hvg_leveled_traits<inf1hdr> {
		static auto count(const inf1hdr& h) -> u8 { return std::min<u8>(h.inf1hygc, 3); }
		static auto at(const inf1hdr& h, u8 i) -> hvg_pair {
			auto& e = h.inf1hyg[i];
			return { e.inf1yof, e.inf1yln, e.inf1yvr, e.inf1gof, e.inf1gln, e.inf1gvr };
		}
	};

	template <>
	struct machine_traits<inf1hdr> {
		static auto at(const inf1hdr& h) -> machine_pair {
			return { h.inf1moff, h.inf1mlen };
		}
	};

	template <>
	struct partition_traits<inf1hdr> {
		static auto at(const inf1hdr& h) -> partition_pair {
			return { h.infpoff, h.infplen };
		}
	};

	using inf1hdr_layout = infhdr_layout<infchdr, inf1hdr>;
	using inf1view = hv_view<inf1hdr_layout, inf1mac, inf1par, inf1hyp, inf1gst>;

