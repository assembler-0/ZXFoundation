    enum class asce_type : u8 {
        region_table_destination   = 0,
        segment_table_destination  = 1,
        real_space_destination     = 3,
    };

    template <typename T>
    struct primary_asce_extension {
        [[nodiscard]] auto asce_type(this const T& self) noexcept -> asce_type {
            if (self.template get<"primary_real_space_ctl">()) return asce_type::real_space_destination;
            if (self.template get<"primary_degsination_type_ctl">() == 0b00) return asce_type::segment_table_destination;
            return asce_type::region_table_destination;
        }
    };

    using cr1 = lib::record<u64, lib::msb0_t,
        lib::extensions<primary_asce_extension>,
        lib::rw<"primary_origin", lib::bits<0, 51>>,
        lib::rw<"primary_subspace_group_ctl", lib::bits<54, 54>>,
        lib::rw<"primary_private_space_ctl", lib::bits<55, 55>>,
