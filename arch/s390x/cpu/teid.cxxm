/// SPDX-License-Identifier: Apache-2.0
/// @file teid_types.cxxm
/// @brief Translation-Exception Identification (TEID) layout

export module arch.s390x.cpu.teid;
import zxfoundation.base.types;
import lib.bitfield;
import lib.stl;

#define __zxmacro_want_bits
#include macro_extensions

export {

namespace arch::s390x::cpu::teid {

    enum class teid_aefsi : u8 {
        could_not_determine  = 0b00,
        store_operation      = 0b01,
        fetch_operation      = 0b10,
    };

    enum class teid_asce_id : u8 {
        primary_asce   = 0b00,
        ar_mode        = 0b01,
        secondary_asce = 0b10,
        home_asce      = 0b11
    };

    /// @name Translation-Exception Identification for DAT Exceptions
    /// @{

    using teid_dat = lib::record<u64, lib::msb0_t,
        lib::rw<"translation_exception_address", lib::bits<0, 51>>,
        lib::rw<"access_exec_fs_id", lib::bits<52, 53>, teid_aefsi>,
        lib::rw<"side_effect_indication", lib::bits<54, 54>>,
        lib::rw<"move_page_indication", lib::bits<61, 61>>,
        lib::rw<"asce_identifier", lib::bits<62, 63>, teid_asce_id>
    >;

    using teid_dat_view = lib::record_ref<u64, lib::msb0_t,
        lib::rw<"translation_exception_address", lib::bits<0, 51>>,
        lib::rw<"access_exec_fs_id", lib::bits<52, 53>, teid_aefsi>,
        lib::rw<"side_effect_indication", lib::bits<54, 54>>,
        lib::rw<"move_page_indication", lib::bits<61, 61>>,
        lib::rw<"asce_identifier", lib::bits<62, 63>, teid_asce_id>
    >;

    /// @}

    /// @name Translation-Exception Identification for Protection Exceptions:
    /// @{

    enum class teid_protection_cause : u8 {
        keyctl_lowaddr_protection = 0b000,
        dat_protection            = 0b001,
        key_controlled_protection = 0b010,
        alc_protection            = 0b011,
        low_address_protection    = 0b100,
        execution_protection      = 0b101,
    };

    using teid_prot_except = lib::record<u64, lib::msb0_t,
        lib::rw<"translation_exception_address", lib::bits<0, 51>>,
        lib::rw<"access_exec_fs_id", lib::bits<52, 53>, teid_aefsi>,
        lib::rw<"side_effect_indication", lib::bits<54, 54>>,
        lib::rw<"!protection_cause", std::tuple<lib::bit_span<56, 56>, lib::bit_span<60, 60>, lib::bit_span<61, 61>>, teid_protection_cause>,
        lib::rw<R"(protection_code\esop2)", lib::bits<56, 56>>,
        lib::rw<R"(protection_code\alc)", lib::bits<60, 60>>,
        lib::rw<R"(protection_code\esop1)", lib::bits<61, 61>>,
        lib::rw<"asce_identifier", lib::bits<62, 63>, teid_asce_id>
    >;

    using teid_prot_except_view = lib::record_ref<u64, lib::msb0_t,
        lib::rw<"translation_exception_address", lib::bits<0, 51>>,
        lib::rw<"access_exec_fs_id", lib::bits<52, 53>, teid_aefsi>,
        lib::rw<"side_effect_indication", lib::bits<54, 54>>,
        lib::rw<"!protection_cause", std::tuple<lib::bit_span<56, 56>, lib::bit_span<60, 60>, lib::bit_span<61, 61>>, teid_protection_cause>,
        lib::rw<R"(protection_code\esop2)", lib::bits<56, 56>>,
        lib::rw<R"(protection_code\alc)", lib::bits<60, 60>>,
        lib::rw<R"(protection_code\esop1)", lib::bits<61, 61>>,
        lib::rw<"asce_identifier", lib::bits<62, 63>, teid_asce_id>
    >;

    /// @}

    /// @name Translation-Exception Identification for ASN-Translation Exceptions
    /// @{

    struct [[gnu::packed]] teid_asn_view {
        bytersvd(tobytes(b, 6)){};
        u16 asn_location{};
    };

    /// @}

    /// @name Translation-Exception Identification During PC-Number Translation
    /// @{

    struct [[gnu::packed]] teid_pcnum_view {
        bytersvd(tobytes(b, 4)){};
        u32 second_operand_address{};

        [[nodiscard]] auto operand_address() noexcept -> u32 {
            lib::bf32 view{second_operand_address};
            return view.extract<12, 31>();
        }
    };

    /// @}

    /// @name Translation-Exception Identification for DAT Exceptions
    /// @{

    using teid_secure_storage = lib::record<u64, lib::msb0_t,
        lib::rw<"translation_exception_address", lib::bits<0, 51>>,
        lib::rw<"access_exec_fs_id", lib::bits<52, 53>, teid_aefsi>,
        lib::rw<"teid_valid", lib::bits<61, 61>>,
        lib::rw<"asce_identifier", lib::bits<62, 63>, teid_asce_id>
    >;

    using teid_secure_storage_view = lib::record_ref<u64, lib::msb0_t,
        lib::rw<"translation_exception_address", lib::bits<0, 51>>,
        lib::rw<"access_exec_fs_id", lib::bits<52, 53>, teid_aefsi>,
        lib::rw<"teid_valid", lib::bits<61, 61>>,
        lib::rw<"asce_identifier", lib::bits<62, 63>, teid_asce_id>
    >;

    /// @}

    using teid = u64;

} // namespace arch::s390x::cpu::teid

} // end export
