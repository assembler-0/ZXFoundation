/// @file arch/s390x/cpu/tx.zcomponent/tx.cxxm
/// @brief Verified z/Architecture transactional execution primitives.

export module arch.s390x.cpu.tx;
import arch.s390x.cpu.teid;
import arch.s390x.trap.pgm.core;
import zxfoundation.base.types;
import lib.bitfield;
import lib.stl;

#define __zxmacro_want_assert
#define __zxmacro_want_bits
#include macro_extensions

export {

namespace arch::s390x::cpu::tx {

    enum class tdb_format : u8 {
        unpredictable   = 0,
        format1         = 1
    };

    enum class tdb_abort_code : u64 {
        external_int           = 2,
        pgm_int                = 4,
        mcck_int               = 5,
        io_int                 = 6,
        fetch_overflow         = 7,
        store_overflow         = 8,
        fetch_conflict         = 9,
        store_conflict         = 10,
        restricted_inst        = 11,
        pgm_int_condition      = 12,
        nesting_depth_exceeded = 13,
        cache_fetch_related    = 14,
        cache_store_related    = 15,
        cache_other            = 16,
        guarded_storage_event  = 19,
        misc_condition         = 255
    };

    union [[gnu::packed]] tdb_exception_code {
        trap::pgm::data_exception_code dxc;
        trap::pgm::vector_exception_code vxc;
    };

    /// @brief Transaction Diagnostic Block
    struct [[gnu::packed]] tdb {
        tdb_format format{};
        lib::record<u8, lib::msb0_t,
            lib::rw<"conflict_token_validity", lib::bits<0, 0>>,
            lib::rw<"constrained_transaction_indication", lib::bits<1, 1>>
        > flags;
        bytersvd(tobytes(w, 1)){};
        u16 transaction_nesting_depth{};
        tdb_abort_code transaction_abort_code{};
        u64 conflict_token{};
        u64 aborted_transaction_inst_addr{};
        u8 exception_access_id{};
        tdb_exception_code exception_code;
        bytersvd(tobytes(hw, 1)){};
        u32 program_int_id{};
        teid::teid translation_exception_id;
        u64 breaking_event_addr{};
        bytersvd(tobytes(dw, 9)){};
        u64 general_registers[16];
    };
    assert_size(tdb, 256);

    /// @brief CC values returned by tbegin() / tbeginc().
    constexpr i32 TX_CC_SUCCESS          = 0; ///< Transaction initiated.
    constexpr i32 TX_CC_INDETERMINATE    = 1; ///< Indeterminate condition abort.
    constexpr i32 TX_CC_TRANSIENT        = 2; ///< Transient abort (retry may succeed).
    constexpr i32 TX_CC_PERSISTENT       = 3; ///< Persistent abort (retry will not help).
    constexpr i32 TX_CC_UNAVAILABLE      = -1; ///< Facility or CR0.TXC disabled.

    /// @brief Default GR save mask: save register pairs 2-15, no AR/FP mods.
    constexpr u16 TBEGIN_GRSM_DEFAULT   = 0xFE00;

    /// @brief GR save mask that also saves r0 (bits 0-15 of I2).
    constexpr u16 TBEGIN_GRSM_ALL       = 0xFF00;

    /// @brief Allow AR modification in the I2 control field.
    constexpr u16 TBEGIN_AR_ALLOWED     = 0x0008;

    /// @brief Allow floating-point/vector operation in the I2 control field.
    constexpr u16 TBEGIN_FLOAT_ALLOWED  = 0x0004;

    /// @brief Check that TX is installed and enabled for this CPU.
    [[nodiscard]] auto available() noexcept -> bool;

    /// @brief Check that constrained TX is installed and TX is enabled.
    [[nodiscard]] auto constrained_available() noexcept -> bool;

    /// @brief Begin a non-constrained transaction (no TDB).
    /// @tparam Ctrl  I2 control field (GRSM | A | F | PIFC).
    /// @return CC: 0=started, 1=indeterminate abort, 2=transient abort.
    template <u16 Ctrl = TBEGIN_GRSM_DEFAULT>
    [[nodiscard]] inline auto tbegin() noexcept -> condition_code {
        if (!available()) return TX_CC_UNAVAILABLE;
        // I2 bits 8-11 are reserved; PIFC=3 is reserved as well.
        if ((Ctrl & 0x00F0U) != 0U || (Ctrl & 0x0003U) == 0x0003U)
            return TX_CC_UNAVAILABLE;
        condition_code cc;
        __asm__ volatile(
            "   .insn   sil,0xe56000000000,0,%[ctrl]\n"
            "   ipm     %[cc]\n"
            "   srl     %[cc],28\n"
            : [cc] "=d" (cc)
            : [ctrl] "i" (static_cast<int>(Ctrl))
            : "cc", "memory"
        );
        return cc;
    }

    /// @brief Begin a non-constrained transaction with TDB diagnostic block.
    /// @param tdb_ref  Reference to a 256-byte-aligned TDB.
    template <u16 Ctrl = TBEGIN_GRSM_DEFAULT>
    [[nodiscard]] inline auto tbegin(tdb& tdb_ref) noexcept -> condition_code {
        if (!available() || (Ctrl & 0x00F0U) != 0U ||
            (Ctrl & 0x0003U) == 0x0003U ||
            (reinterpret_cast<u64>(&tdb_ref) & 0x7U) != 0U)
            return TX_CC_UNAVAILABLE;
        condition_code cc;
        __asm__ volatile(
            "   .insn   sil,0xe56000000000,0(%[tdb]),%[ctrl]\n"
            "   ipm     %[cc]\n"
            "   srl     %[cc],28\n"
            : [cc] "=d" (cc)
            : [tdb] "a" (&tdb_ref), [ctrl] "i" (static_cast<int>(Ctrl))
            : "cc", "memory"
        );
        return cc;
    }

    /// @brief Begin a constrained transaction (facility 50).
    /// @return CC value: 0 = started (first attempt), 2 = restarted after abort.
    [[nodiscard]] inline auto tbeginc() noexcept -> condition_code {
        if (!constrained_available()) return TX_CC_UNAVAILABLE;
        condition_code cc;
        __asm__ volatile(
            // TBEGINC 0,I2 — opcode 0xE561, TDB address must be 0
            "   .insn   sil,0xe56100000000,0,0xFE00\n"
            "   ipm     %[cc]\n"
            "   srl     %[cc],28\n"
            : [cc] "=d" (cc)
            :
            : "cc", "memory"
        );
        return cc;
    }

    /// @brief Commit the innermost transaction.
    /// @return false when TX is unavailable; true after issuing TEND.
    [[nodiscard]] inline auto tend() noexcept -> bool {
        if (!available()) return false;
        __asm__ volatile(
            // TEND — opcode 0xB2F8
            "   .insn   s,0xb2f80000,0\n"
            ::: "cc", "memory"
        );
        return true;
    }

    /// @brief Abort the current transaction with the given abort code.
    [[nodiscard]] inline auto depth() noexcept -> u32;

    [[noreturn]] inline auto tabort(u64 code) noexcept -> void {
        if (!available() || depth() == 0U || code < 256U) __builtin_trap();
        __asm__ volatile(
            // TABORT D2(B2) — opcode 0xB2FC, abort code = address
            "   .insn   s,0xb2fc0000,0(%[code])\n"
            :
            : [code] "a" (code)
        );
        __builtin_unreachable();
    }

    /// @brief Nontransactional store — writes a 64-bit value outside the
    ///        transaction's isolation domain (useful for abort counters, logs).
    [[nodiscard]] inline auto nontx_store(u64* addr, u64 value) noexcept -> bool {
        if (!available() || !addr) return false;
        __asm__ volatile(
            // NTSTG R1,D2(X2,B2) — opcode 0xE325
            "   .insn   rxy,0xe30000000025,%[val],0(%[addr])\n"
            :
            : [val] "d" (value), [addr] "a" (addr)
            : "memory"
        );
        return true;
    }

    /// @brief Extract Transaction Nesting Depth (ETND).
    /// @return Current nesting depth (0 = not in a transaction).
    [[nodiscard]] inline auto depth() noexcept -> u32 {
        if (!available()) return 0U;
        u32 d;
        __asm__ volatile(
            // ETND — opcode 0xB2EC
            "   .insn   rre,0xb2ec0000,%[out],0\n"
            : [out] "=d" (d)
            :
        );
        return d;
    }

} // namespace arch::s390x::cpu::tx

} // end export
