/// SPDX-License-Identifier: Apache-2.0
/// @file arch/s390x/io/types.cxxm
/// @brief z/Architecture Channel Subsystem hardware data structures (PoP Chapter 14).

export module arch.s390x.io.types;
import zxfoundation.base.types;
import lib.bitfield;
import lib.structure;
import lib.stl;

export {

namespace arch::s390x::io {

    /// @brief Maximum number of subchannels in the subchannel number space.
    inline constexpr u32 MAX_SUBCHANNELS = 65536;

    /// @brief Maximum valid subchannel number (0-based).
    inline constexpr u16 MAX_SCHID = 0xFFFF;

    inline constexpr u8 CCW_FLAG_CD      = 0x80; ///< Chain data (PoP bit 8).
    inline constexpr u8 CCW_FLAG_CC      = 0x40; ///< Command chaining (PoP bit 9).
    inline constexpr u8 CCW_FLAG_SLI     = 0x20; ///< Suppress length indication (PoP bit 10).
    inline constexpr u8 CCW_FLAG_SKIP    = 0x10; ///< Skip data transfer (PoP bit 11).
    inline constexpr u8 CCW_FLAG_PCI     = 0x08; ///< Program-controlled interruption (PoP bit 12).
    inline constexpr u8 CCW_FLAG_IDA     = 0x04; ///< Indirect data addressing (PoP bit 13).
    inline constexpr u8 CCW_FLAG_SUSPEND = 0x02; ///< Suspend channel program (PoP bit 14).
    inline constexpr u8 CCW_FLAG_MIDA    = 0x01; ///< Modified IDA (PoP bit 15).

    inline constexpr u8 DEV_STAT_ATTN = 0x80; ///< Attention.
    inline constexpr u8 DEV_STAT_MOD  = 0x40; ///< Status modifier.
    inline constexpr u8 DEV_STAT_CUE  = 0x20; ///< Control unit end.
    inline constexpr u8 DEV_STAT_BUSY = 0x10; ///< Busy.
    inline constexpr u8 DEV_STAT_CE   = 0x08; ///< Channel end.
    inline constexpr u8 DEV_STAT_DE   = 0x04; ///< Device end.
    inline constexpr u8 DEV_STAT_UC   = 0x02; ///< Unit check.
    inline constexpr u8 DEV_STAT_UX   = 0x01; ///< Unit exception.

    inline constexpr u8 SCH_STAT_PCI  = 0x80; ///< Program-controlled interruption.
    inline constexpr u8 SCH_STAT_INCL = 0x40; ///< Incorrect length.
    inline constexpr u8 SCH_STAT_PROG = 0x20; ///< Program check.
    inline constexpr u8 SCH_STAT_PROT = 0x10; ///< Protection check.
    inline constexpr u8 SCH_STAT_CHD  = 0x08; ///< Channel data check.
    inline constexpr u8 SCH_STAT_CHC  = 0x04; ///< Channel control check.
    inline constexpr u8 SCH_STAT_ICC  = 0x02; ///< Interface control check.
    inline constexpr u8 SCH_STAT_CC   = 0x01; ///< Chaining check.

    inline constexpr u8 FCTL_START = 0x4; ///< Start function (PoP bit 17).
    inline constexpr u8 FCTL_HALT  = 0x2; ///< Halt function (PoP bit 18).
    inline constexpr u8 FCTL_CLEAR = 0x1; ///< Clear function (PoP bit 19).

    inline constexpr u8 STCTL_ALERT        = 0x10; ///< Alert status (PoP bit 27).
    inline constexpr u8 STCTL_INTERMEDIATE = 0x08; ///< Intermediate status (PoP bit 28).
    inline constexpr u8 STCTL_PRIMARY      = 0x04; ///< Primary status (PoP bit 29).
    inline constexpr u8 STCTL_SECONDARY    = 0x02; ///< Secondary status (PoP bit 30).
    inline constexpr u8 STCTL_STATUS_PEND  = 0x01; ///< Status pending (PoP bit 31).

    inline constexpr u8 ACTL_RESUME_PEND = 0x40; ///< Resume pending (PoP bit 20).
    inline constexpr u8 ACTL_START_PEND  = 0x20; ///< Start pending (PoP bit 21).
    inline constexpr u8 ACTL_HALT_PEND   = 0x10; ///< Halt pending (PoP bit 22).
    inline constexpr u8 ACTL_CLEAR_PEND  = 0x08; ///< Clear pending (PoP bit 23).
    inline constexpr u8 ACTL_SCH_ACTIVE  = 0x04; ///< Subchannel active (PoP bit 24).
    inline constexpr u8 ACTL_DEV_ACTIVE  = 0x02; ///< Device active (PoP bit 25).
    inline constexpr u8 ACTL_SUSPENDED   = 0x01; ///< Suspended (PoP bit 26).

    enum class ccw_commands : u8 {
        write           = 0b00000001,
        read            = 0b00000010,
        read_backward   = 0b00001100,
        control         = 0b00000011,
        sense           = 0b00000100,
        sense_id        = 0b11100100,
        tic             = 0b00001000,
        transport       = 0b01000000,
    };

    /// @brief Check if a CCW command is valid
    /// @param cmd unsigned 8 bit command code
    /// @param dcw specify Transport mode, for DCW
    [[nodiscard]] auto ccw_cmd_valid(const u8 cmd, bool dcw = false) noexcept -> bool {
        return lib::bf8{cmd}.extract<4, 7>() != 0 && (dcw ? lib::bf8{cmd}[1] : true);
    }

    using ccw_flags = lib::record<u8, lib::msb0_t,
        lib::rw<"chain_data",       lib::bits<0, 0>>,
        lib::rw<"chain_command",    lib::bits<1, 1>>,
        lib::rw<"suppress_length",  lib::bits<2, 2>>,
        lib::rw<"skip",             lib::bits<3, 3>>,
        lib::rw<"pgm_contolled_interruption", lib::bits<4, 4>>,
        lib::rw<"indirect_data_access",       lib::bits<5, 5>>,
        lib::rw<"suspend",                   lib::bits<6, 6>>,
        lib::rw<"modified_ida",              lib::bits<7, 7>>
    >;

    /// @brief Format-1 CCW: 8 bytes, big-endian, used with Format-1 ORB.
    using ccw1 = lib::structure<8, 8, lib::endian::big,
        lib::rw<"cmd_code",  lib::bytes<0, 0>, ccw_commands>,
        lib::rw<"flags",     lib::bytes<1, 1>, ccw_flags>,
        lib::rw<"count",     lib::bytes<2, 3>, u16>,
        lib::rw<"data_addr", lib::bytes<4, 7>, u32>
    >;

    /// @brief Format-0 Channel Command Word (CCW0)
    using ccw0 = lib::structure<8, 8, lib::endian::big,
        lib::rw<"cmd_code",     lib::bytes<0, 0>, ccw_commands>,
        lib::rw<"data_address", lib::at_byte<1>::at_bits<0, 23>, u32>,
        lib::rw<"flags",        lib::bytes<4, 4>, ccw_flags>,
        lib::rw<"count",        lib::bytes<6, 7>, u16>
    >;

    /// @brief Format-1/0 Channel Command Word
    using ccw_common = lib::structure<8, 8, lib::endian::big,
        lib::overlay_rw<"f0",     lib::bytes<0, 7>, ccw0>,
        lib::overlay_rw<"f1",     lib::bytes<0, 7>, ccw1>
    >;

    template <typename T>
    struct scsw_extensions {
        [[nodiscard]] auto has_device_error(this const T& self) noexcept -> bool {
            return
                self.template get<R"(dev_status\unit_check)">() ||
                self.template get<R"(dev_status\unit_exception)">();
        }

        [[nodiscard]] auto has_sch_error(this const T& self) noexcept -> bool {
            return
                self.template get<R"(sch_status\pgm_check)">() ||
                self.template get<R"(sch_status\protection_check)">() ||
                self.template get<R"(sch_status\channel_data_check)">() ||
                self.template get<R"(sch_status\channel_control_check)">() ||
                self.template get<R"(sch_status\interface_control_check)">() ||
                self.template get<R"(sch_status\chaining_check)">();
        }
    };

    /// @brief Subchannel Status Word — packed status from TSCH.
    using scsw = lib::structure<12, 4, lib::endian::big,
        lib::extensions<scsw_extensions>,
        lib::overlay_rw<"io_subclass_code",               lib::at_byte<0>::at_bits<0, 3>, u8>,
        lib::overlay_rw<"flags",                          lib::bytes<0, 1>, lib::record<u16, lib::msb0_t,
            lib::rw<"suspend_control",                    lib::bits<4, 4>>,
            lib::rw<"esw_format",                         lib::bits<5, 5>>,
            lib::rw<"deferred_condition_code",            lib::bits<6, 7>>,
            lib::rw<"ccw_format",                         lib::bits<8, 8>>,
            lib::rw<"prefetch",                           lib::bits<9, 9>>,
            lib::rw<"status_interruption_control",        lib::bits<10, 10>>,
            lib::rw<"irb_format_control",                 lib::bits<11, 11>>,
            lib::rw<"suppressed_suspended_int",           lib::bits<12, 12>>,
            lib::rw<"zero_condition",                     lib::bits<13, 13>>,
            lib::rw<"extended_control",                   lib::bits<14, 14>>,
            lib::rw<"path_not_operational",               lib::bits<15, 15>>
        >>,
        lib::rw<"control",                                lib::bytes<2, 3>, lib::record<u16, lib::msb0_t,
            lib::overlay_rw<"function",                   lib::bits<1, 3>>,
                lib::rw<R"(function\start)",              lib::bits<1, 1>>,
                lib::rw<R"(function\halt)",               lib::bits<2, 2>>,
                lib::rw<R"(function\clear)",              lib::bits<3, 3>>,
            lib::overlay_rw<"activity",                   lib::bits<4, 10>>,
                lib::rw<R"(activity\resume_p)",           lib::bits<4, 4>>,
                lib::rw<R"(activity\start_p)",            lib::bits<5, 5>>,
                lib::rw<R"(activity\halt_p)",             lib::bits<6, 6>>,
                lib::rw<R"(activity\clear_p)",            lib::bits<7, 7>>,
                lib::rw<R"(activity\sch_active)",         lib::bits<8, 8>>,
                lib::rw<R"(activity\device_active)",      lib::bits<9, 9>>,
                lib::rw<R"(activity\suspended)",          lib::bits<10, 10>>,
            lib::overlay_rw<"status",                     lib::bits<11, 15>>,
                lib::rw<R"(status\alert)",                lib::bits<11, 11>>,
                lib::rw<R"(status\intermediate)",         lib::bits<12, 12>>,
                lib::rw<R"(status\primary)",              lib::bits<13, 13>>,
                lib::rw<R"(status\secondary)",            lib::bits<14, 14>>,
                lib::rw<R"(status\pending)",              lib::bits<15, 15>>
        >>,
        lib::rw<"ccw_address",                            lib::bytes<4, 7>, u32>,
        lib::rw<"dev_status",                             lib::bytes<8, 8>, lib::record<u8, lib::msb0_t,
            lib::rw<"attention",                          lib::bits<0, 0>>,
            lib::rw<"modifier",                           lib::bits<1, 1>>,
            lib::rw<"control_unit_end",                   lib::bits<2, 2>>,
            lib::rw<"busy",                               lib::bits<3, 3>>,
            lib::rw<"channel_end",                        lib::bits<4, 4>>,
            lib::rw<"device_end",                         lib::bits<5, 5>>,
            lib::rw<"unit_check",                         lib::bits<6, 6>>,
            lib::rw<"unit_exception",                     lib::bits<7, 7>>
        >>,
        lib::rw<"sch_status",                             lib::bytes<9, 9>, lib::record<u8, lib::msb0_t,
            lib::rw<"pgm_controlled_int",                 lib::bits<0, 0>>,
            lib::rw<"incorrect_length",                   lib::bits<1, 1>>,
            lib::rw<"pgm_check",                          lib::bits<2, 2>>,
            lib::rw<"protection_check",                   lib::bits<3, 3>>,
            lib::rw<"channel_data_check",                 lib::bits<4, 4>>,
            lib::rw<"channel_control_check",              lib::bits<5, 5>>,
            lib::rw<"interface_control_check",            lib::bits<6, 6>>,
            lib::rw<"chaining_check",                     lib::bits<7, 7>>
        >>,
        lib::rw<"count",                                  lib::bytes<10, 11>, u16>
    >;

    enum class pmcw_limit_mode : u8 {
        no_limit_checking           = 0b00,
        address_eq_greater_current  = 0b01,
        address_less_current        = 0b10,
    };

    /// @brief Path Management Control Word — subchannel configuration.
    using pmcw = lib::structure<28, 4, lib::endian::big,
        lib::rw<"interruption_parameter",         lib::bytes<0, 3>, u32>,
        lib::rw<"io_subclass_code",               lib::at_byte<4>::at_bits<2, 4>, u8>,
        lib::rw<"flags",                          lib::bytes<5, 5>, lib::record<u8, lib::msb0_t,
            lib::rw<"enabled",                    lib::bits<0, 0>>,
            lib::rw<"limit_mode",                 lib::bits<1, 2>, pmcw_limit_mode>,
            lib::overlay_rw<"measurement_enable", lib::bits<0, 7>, lib::record<u8, lib::msb0_t,
                lib::rw<"block_update",         lib::bits<3, 3>>,
                lib::rw<"device_connect_time",  lib::bits<4, 4>>
            >>,
            lib::rw<"multipath_mode",             lib::bits<5, 5>>,
            lib::rw<"timing_facility",            lib::bits<6, 6>>,
            lib::rw<"device_number_valid",        lib::bits<7, 7>>
        >>,
        lib::rw<"device_number",                  lib::bytes<6, 7>, u16>,
        lib::rw<"logical_path_mask",              lib::bytes<8, 8>, lib::bf8>,
        lib::rw<"path_not_operational_mask",      lib::bytes<9, 9>, lib::bf8>,
        lib::rw<"last_path_used_mask",            lib::bytes<10, 10>, lib::bf8>,
        lib::rw<"path_installed_mask",            lib::bytes<11, 11>, lib::bf8>,
        lib::rw<"measurement_block_index",        lib::bytes<12, 13>, u16>,
        lib::rw<"path_operational_mask",          lib::bytes<14, 14>, lib::bf8>,
        lib::rw<"path_available_mask",            lib::bytes<15, 15>, lib::bf8>,
        lib::rw<"channel_path_identifiers",       lib::bytes<16, 23>, u8[8]>,
        lib::rw<"measurement_block_format",       lib::at_byte<27>::at_bits<5, 5>, u8>,
        lib::rw<"ext_measurement_blk_word_format",lib::at_byte<27>::at_bits<6, 6>, u8>,
        lib::rw<"measurement_block_word_enable",  lib::at_byte<27>::at_bits<7, 7>, u8>
    >;

    /// @brief Subchannel Information Block
    using schib = lib::structure<52, 4, lib::endian::big,
        lib::rw<"pmcw",           lib::bytes<0, 27>, pmcw>,
        lib::rw<"scsw",           lib::bytes<28, 39>, scsw>,
        lib::overlay_rw<"mba",    lib::bytes<40, 47>, u64>,
        lib::overlay_rw<"mda",    lib::bytes<40, 51>, u8[12]>
    >;

    /// @brief Operation Request Block. (Command/Transport)
    using orb = lib::structure<32, 8, lib::endian::big,
        lib::rw<"interruption_parameter",          lib::bytes<0, 3>, u32>,
        lib::rw<"subchannel_key",                  lib::at_byte<4>::at_bits<0, 3>, u8>,
        lib::rw<"control",                         lib::bytes<4, 7>, lib::record<u32, lib::msb0_t,
            lib::rw<"suspend",                     lib::bits<4, 4>>,
            lib::rw<"streaming_mode",              lib::bits<5, 5>>,
            lib::rw<"modification",                lib::bits<6, 6>>,
            lib::rw<"synchronization",             lib::bits<7, 7>>,
            lib::rw<"ccw_format",                  lib::bits<8, 8>>,
            lib::rw<"prefetch",                    lib::bits<9, 9>>,
            lib::rw<"initial_status_interruption", lib::bits<10, 10>>,
            lib::rw<"addr_limit_checking",         lib::bits<11, 11>>,
            lib::rw<"suppress_suspended",          lib::bits<12, 12>>,
            lib::rw<"channel_program_type",        lib::bits<13, 13>>,
            lib::rw<"format2_idaw",                lib::bits<14, 14>>,
            lib::rw<"2k_idaw_control",             lib::bits<15, 15>>,
            lib::rw<"incorrect_length_suppression",lib::bits<24, 24>>,
            lib::rw<"modified_ccw_ida",            lib::bits<25, 25>>,
            lib::rw<"orb_extension",               lib::bits<31, 31>>
        >>,
        lib::rw<"logical_path_mask",       lib::at_byte<6>::at_bits<0, 7>, lib::bf8>,
        lib::rw<"channel_program_address", lib::at_byte<8>::at_bits<1, 31>, u32>,
        lib::rw<"css_priority",            lib::bytes<12, 12>, u8>,
        lib::rw<"cu_priority",             lib::bytes<14, 14>, u8>
    >;
    static_assert(sizeof(orb) == 32, "orb must be exactly 32 bytes");

    /// @brief Extended Measurement Word
    using emw = lib::structure<32, 8, lib::endian::big,
        lib::rw<"device_connect_time",           lib::bytes<0, 3>, u32>,
        lib::rw<"function_pending_time",         lib::bytes<4, 7>, u32>,
        lib::rw<"device_disconnect_time",        lib::bytes<8, 11>, u32>,
        lib::rw<"control_unit_queuing_time",     lib::bytes<12, 15>, u32>,
        lib::rw<"device_active_only_time",       lib::bytes<16, 19>, u32>,
        lib::rw<"device_busy_time",              lib::bytes<20, 23>, u32>,
        lib::rw<"initial_command_response_time", lib::bytes<24, 27>, u32>
    >;

    /// @brief Extended Report Word
    using erw = lib::record<u32, lib::msb0_t,
        lib::rw<"rq_logging_only",            lib::bits<1, 1>>,
        lib::rw<"ext_sch_logout_pending",     lib::bits<2, 2>>,
        lib::rw<"authorization_check",        lib::bits<3, 3>>,
        lib::rw<"path_verification_required", lib::bits<4, 4>>,
        lib::rw<"channel_path_timeout",       lib::bits<5, 5>>,
        lib::rw<"failing_storage_access_v",   lib::bits<6, 6>>,
        lib::rw<"concurrent_sense",           lib::bits<7, 7>>,
        lib::rw<"secondary_ccw_addr_v",       lib::bits<8, 8>>,
        lib::rw<"failing_storage_format",     lib::bits<9, 9>>,
        lib::rw<"concurrent_sense_count",     lib::bits<10, 15>>
    >;

    enum class esw0_storage_access_code : u8 {
        unknown       = 0b00,
        read          = 0b01,
        write         = 0b10,
        read_backward = 0b11,
    };

    enum class esw0_termination_code : u8 {
        halt_sgn           = 0b00,
        normal_termination = 0b01,
        clear_sgn          = 0b10,
    };

    enum class esw0_sequence_code : u8 {
        nz_command_byte        = 0b001,
        accepted_no_transfer   = 0b010,
        polling_state          = 0b011,
        ccw_transmit_error     = 0b100,
        unpredictable_transfer = 0b101,
    };

    /// @brief Extended Status Word Format 0
    using esw0 = lib::structure<20, 4, lib::endian::big,
        lib::rw<"subchannel_logout",             lib::bytes<0, 3>, lib::record<u32, lib::msb0_t,
            lib::rw<"esf",                       lib::bits<0, 7>, lib::record<u8, lib::msb0_t,
                lib::rw<"key_check",             lib::bits<1, 1>>,
                lib::rw<"mm_blk_pgm_check",      lib::bits<2, 2>>,
                lib::rw<"mm_blk_data_check",     lib::bits<3, 3>>,
                lib::rw<"mm_blk_prot_check",     lib::bits<4, 4>>,
                lib::rw<"ccw_check",             lib::bits<5, 5>>,
                lib::rw<"idaw_midaw_check",      lib::bits<6, 6>>
            >>,
            lib::rw<"last_path_used_mask",       lib::bits<8, 15>, lib::bf8>,
            lib::rw<"ancillary_report",          lib::bits<16, 16>>,
            lib::overlay_rw<"fvf",               lib::bits<16, 23>, lib::record<u8, lib::msb0_t,
                lib::rw<"lath_path_used_mask",   lib::bits<1, 1>>,
                lib::rw<"termination_code",      lib::bits<2, 2>>,
                lib::rw<"sequence_code",         lib::bits<3, 3>>,
                lib::rw<"device_status",         lib::bits<4, 4>>,
                lib::rw<"ccw_tcw_address",       lib::bits<5, 5>>
            >>,
            lib::rw<"storage_access_code",       lib::bits<22, 23>, esw0_storage_access_code>,
            lib::rw<"termination_code",          lib::bits<24, 25>, esw0_termination_code>,
            lib::rw<"device_status_check",       lib::bits<26, 26>>,
            lib::rw<"secondary_error",           lib::bits<27, 27>>,
            lib::rw<"io_error_alert",            lib::bits<28, 28>>,
            lib::rw<"sequence_code",             lib::bits<29, 31>, esw0_sequence_code>
        >>,
        lib::rw<"extended_report_word",          lib::bytes<4, 7>, erw>,
        lib::overlay_rw<"failing_storage_address",lib::bytes<8, 15>, u64, lib::attr::unaligned>,
        lib::rw<"ext_sch_logout_descriptor",     lib::bytes<8, 15>, u64, lib::attr::unaligned>,
        lib::overlay_rw<"secondary_ccw_address", lib::at_byte<16>::at_bits<1, 31>, u32>
    >;

    /// @brief Extended Status Word Format 1
    using esw1 = lib::structure<20, 4, lib::endian::big,
        lib::rw<"last_path_used_mask",           lib::bytes<1, 1>, lib::bf8>,
        lib::rw<"extended_report_word",          lib::bytes<4, 7>, erw>
    >;

    /// @brief Extended Status Word Format 2
    using esw2 = lib::structure<20, 4, lib::endian::big,
        lib::rw<"last_path_used_mask",           lib::bytes<1, 1>, lib::bf8>,
        lib::rw<"device_connect_time_intv",      lib::bytes<2, 3>, u16>,
        lib::rw<"extended_report_word",          lib::bytes<4, 7>, erw>
    >;

    /// @brief Extended Status Word Format 3
    using esw3 = esw1;

    /// @brief Format-0/1/2/3 Extended Status Word
    using esw_common = lib::structure<20, 4, lib::endian::big,
        lib::overlay_rw<"f0",     lib::bytes<0, 19>, esw0>,
        lib::overlay_rw<"f1",     lib::bytes<0, 19>, esw1>,
        lib::overlay_rw<"f2",     lib::bytes<0, 19>, esw2>,
        lib::overlay_rw<"f3",     lib::bytes<0, 19>, esw3>
    >;

    enum class irb_ecw_information : u8 {
        unpredictable    = 0,
        concurrent_sense = 1,
        model_dependent  = 2,
    };

    template <typename T>
    struct irb_extensions {
        [[nodiscard]] auto ecw_information_type(this const T& self) noexcept -> irb_ecw_information {
            if (self.template get<R"(scsw\flags\esw_format)">()) {
                if (self.template get<R"(scsw\flags\extended_control)">())
                    return self.template get<R"(erw\concurrent_sense)">() ?
                        irb_ecw_information::concurrent_sense :
                        irb_ecw_information::model_dependent;
                return irb_ecw_information::unpredictable;
            }
            if (self.template get<R"(scsw\flags\extended_control)">())
                return self.template get<R"(erw\concurrent_sense)">() ?
                    irb_ecw_information::concurrent_sense :
                    irb_ecw_information::unpredictable;
            return irb_ecw_information::unpredictable;
        }
    };

    /// @brief Interruption Response Block
    using irb = lib::structure<96, 8, lib::endian::big,
        lib::extensions<irb_extensions>,
        lib::rw<"scsw",           lib::bytes<0, 11>, scsw>,
        lib::rw<"esw",            lib::bytes<12, 31>, esw_common>,
        lib::rw<"ecw",            lib::bytes<32, 63>, u32[8]>,
        lib::rw<"emw",            lib::bytes<64, 95>, emw>
    >;

    /// @brief Subchannel Identifier Record
    using subchannel_id =    lib::record<u32, lib::msb0_t,
        lib::rw<"ssid",   lib::bits<13, 14>, u8>,
        lib::rw<"one",    lib::bits<15, 15>, u8, lib::attr::fixed<1>>,
        lib::rw<"sch_no", lib::bits<16, 31>, u16>
    >;

    /// @brief Sense ID response data returned by CCW_CMD_SENSE_ID.
    struct [[gnu::packed]] senseid_data {
        u8  _reserved{0};  ///< Reserved (0xFF when valid).
        u16 cu_type{0};    ///< Control unit type.
        u8  cu_model{0};   ///< Control unit model.
        u16 dev_type{0};   ///< Device type.
        u8  dev_model{0};  ///< Device model.
    };
    static_assert(sizeof(senseid_data) == 7, "senseid_data must be exactly 7 bytes");

    using iiw = lib::record<u32, lib::msb0_t,
        lib::rw<"pending_type",             lib::bits<0, 0>>,
        lib::rw<"io_interruption_subclass", lib::bits<2, 4>>
    >;

    using io_interruption_code = lib::structure<12, 4, lib::endian::native,
        lib::rw<"sid",                    lib::auto_layout, subchannel_id>,
        lib::rw<"interruption_parameter", lib::auto_layout, u32>,
        lib::rw<"interruption_id_word",   lib::auto_layout, iiw>
    >;

    enum class crw_rsc : u8 {
        monitoring_facility    = 0b0010,
        subchannel             = 0b0011,
        channel_path           = 0b0100,
        config_alert_facility  = 0b1001,
        channel_subsystem      = 0b1011,
    };

    enum class crw_erc : u8 {
        event_info_pending   = 0b000000,
        available            = 0b000001,
        initialized          = 0b000010,
        temporary_error      = 0b000011,
        installed_param_init = 0b000100,
        terminal             = 0b000101,
        perma_err_fac_not_init   = 0b000110,
        perma_err_fac_init       = 0b000111,
        installed_param_modified = 0b001000,
        installed_param_restored = 0b001010,
    };

    template <typename T>
    struct crw_extensions {
        /// @return optionally a pair of subchannel id and subchannel-set ID
        [[nodiscard]] auto sch_no(this const T& self) noexcept -> std::optional<std::pair<u16, u8>> {
            return self.template get<"reporting_source_code">() == crw_rsc::subchannel ?
                std::pair<u16, u8> {
                    self.template get<"reporting_source_id">(),
                    lib::bf32{self.template get<"reporting_source_id">()}.extract<10, 11>()
                } : std::nullopt;
        }

        /// @return optionally a channel-path ID
        [[nodiscard]] auto chpid(this const T& self) noexcept -> std::optional<u8> {
            return self.template get<"reporting_source_code">() == crw_rsc::channel_path ||
                   self.template get<"reporting_source_code">() == crw_rsc::config_alert_facility ?
                lib::bf32{self.template get<"reporting_source_id">()}.extract<8, 15>() : std::nullopt;
        }
    };

    using crw = lib::record<u32, lib::msb0_t,
        lib::extensions<crw_extensions>,
        lib::rw<"solicited",               lib::bits<1, 1>>,
        lib::rw<"overflow",                lib::bits<2, 2>>,
        lib::rw<"chaining",                lib::bits<3, 3>>,
        lib::rw<"reporting_source_code",   lib::bits<4, 7>, crw_rsc>,
        lib::rw<"ancillary_report",        lib::bits<8, 8>>,
        lib::rw<"error_recovery_code",     lib::bits<10, 15>, crw_erc>,
        lib::rw<"reporting_source_id",     lib::bits<16, 31>>
    >;

    using tcw = lib::structure<64, 8,      lib::endian::big,
        lib::rw<"flags",                lib::bytes<0, 0>, lib::record<u32, lib::msb0_t,
            lib::rw<"format",           lib::bits<0, 1>>,
            lib::rw<"tida",             lib::bits<13, 13>>,
            lib::rw<"tccb_tida",        lib::bits<14, 14>>,
            lib::rw<"output_tida",      lib::bits<15, 15>>,
            lib::rw<"tidaw_format",     lib::bits<16, 17>>
        >>,
        lib::rw<"tccb_length",          lib::at_word<1>::at_bits<8, 13>>,
        lib::overlay_rw<"operations",   lib::bytes<5, 5>, lib::record<u8, lib::msb0_t,
            lib::rw<"read",             lib::bits<6, 6>>,
            lib::rw<"write",            lib::bits<7, 7>>
        >>,
        lib::rw<"output_data_address",  lib::bytes<7, 15>, u64>,
        lib::rw<"input_data_address",   lib::bytes<16, 23>, u64>,
        lib::rw<"tsb_address",          lib::bytes<24, 31>, u64>,
        lib::rw<"tccb_address",         lib::bytes<32, 39>, u64>,
        lib::rw<"input_count",          lib::bytes<40, 43>, u32>,
        lib::rw<"output_count",         lib::bytes<44, 47>, u32>,
        lib::rw<"interrogate_tcw_addr", lib::bytes<60, 63>, u32>
    >;

} // namespace arch::s390x::io

} // end export
