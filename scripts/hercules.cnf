ARCHLVL      z/Arch
CPUMODEL     $(z16)
LPARNUM      1
LPARNAME     ZXF
PLANT        ZZ
MODEL        Z16
MANUFACTURER IBM
MAINSIZE     4G
MAXCPU       256
NUMCPU       256
ENGINES      32*CP,16*IL,8*IP,8*AP
DIAG8CMD     ENABLE
PANOPT       NAMEONLY RATE=FAST "TITLE=ZXFoundation"
LOGOPT       NOTIMESTAMP
CNSLPORT     3270
PGMPRDOS     RESTRICTED
FACILITY     ENABLE 74
0009         3215-C  /
001C         SYSG
001F         3270

0100         3390 core.zxfoundation.sysdsk00.cckd cu=2107

IPL 0100
