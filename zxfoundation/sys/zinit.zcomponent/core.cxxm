/// @file zinit.cxxm
/// @brief initcall system

export module zxfoundation.sys.zinit.core;
import zxfoundation.base.types;
import lib.error;
import std;

export {

namespace zxfoundation::sys::zinit {

    enum class zi_class : u8 {
        prelink   =    0,
        early     =    1,
        mm        =    2,
        core      =    3,
        fs        =    4,
        bus       =    5,
        device    =    6,
        late      =    7,
        max       =    8
    };

    enum class zi_prio : u8 {
        high      =    0,
        normal    =   50,
        low       =   99,
    };

    enum class zi_action : u8 {
        warn      =  0x1,
        fatal     =  0x2,
        silent    =  0x4,
    };

    constexpr auto operator|(zi_action a, zi_action b) noexcept -> zi_action {
        if consteval {
            return static_cast<zi_action>(static_cast<u8>(a) | static_cast<u8>(b));
        }
        return static_cast<zi_action>(static_cast<u8>(a) | static_cast<u8>(b));
    }

    constexpr auto operator&(zi_action a, zi_action b) noexcept -> bool {
        if consteval {
            return static_cast<u8>(a) & static_cast<u8>(b);
        }
        return static_cast<u8>(a) & static_cast<u8>(b);
    }

    struct zi_desc;

    using zi_fn = auto (*)(const zi_desc&) noexcept -> std::expected<void, lib::kernel_error>;

    struct zi_desc {
        std::string_view name{}; ///< Name of the method
        zi_fn            init{}; ///< Function pointer
        zi_class          cls{}; ///< Class
        zi_prio          prio{}; ///< Prority
        zi_action      action{}; ///< Failure action
    };

    [[nodiscard]] auto run_class(zi_class cls) noexcept -> u32;

} // namespace zxfoundation::sys::zinit

} // end export