/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sys/io_types.cxxm
/// @brief I/O binding type definitions — device capability management
///        for the DGP kernel's channel-subsystem-based I/O model.

export module zxfoundation.sys.io_types;
import zxfoundation.base.types;
import zxfoundation.scoms.scoms_types;
import zxfoundation.memory.memory_objects;
import std;

export {

namespace zxfoundation::sys::io {

    /// @brief Maximum number of simultaneous I/O bindings system-wide.
    constexpr u32 MAX_IO_BINDINGS = 256;

    /// @brief Bounded kernel-owned completion records per device binding.
    /// A driver consumes these through the I/O gate; it never writes kernel
    /// completion state directly through a shared page.
    constexpr u32 IO_COMPLETION_DEPTH = 32;

    /// @brief Maximum number of segments in a DMA scatter-gather list.
    constexpr u32 IO_DMA_MAX_SEGMENTS = 32;

    /// @brief Maximum linear format-1 CCWs accepted in one verified request.
    constexpr u16 IO_MAX_CCWS = 64;

    /// @brief Operational substate for I/O bindings.
    ///
    /// The SCOMS lifecycle (ko.state) is authoritative.
    /// This encodes operational state only while ko.state == lifecycle_state::active.
    enum class io_substate : u8 {
        bound   = 0, ///< Device bound, idle.
        pending = 1, ///< Channel program submitted, awaiting completion.
        error   = 2, ///< Device in error state (recoverable).
        revoking = 3, ///< New submissions blocked while unbind fences DMA.
    };

    /// @brief User-visible request descriptor copied into the nucleus before
    /// CSS submission. Offsets are relative to the binding's capability-mapped
    /// DMA extent; the kernel owns a separate, unmapped CCW staging page.
    struct io_request {
        u64 request_id{0};
        u32 ccw_offset{0};
        u16 ccw_count{0};
        u8  flags{0};
        u8  _reserved{0};
    };

    static_assert(sizeof(io_request) == 16U,
        "io_request must remain a fixed user/kernel ABI record");

    /// @brief Completion record copied from the kernel-owned binding ring.
    /// Status bytes are CSS IRB summaries; no privileged CSS structure or
    /// physical address crosses the user ABI.
    struct io_completion {
        u64 request_id{0};
        u32 residual_count{0};
        u8  device_status{0};
        u8  subchannel_status{0};
        u16 flags{0};
    };

    static_assert(sizeof(io_completion) == 16U,
        "io_completion must remain a fixed user/kernel ABI record");

    /// @brief Describes the binding of a CSS device to a user domain.
    /// @note CSS types are privileged — io_binding stores only the opaque
    ///       device number (dev_no), never a subchannel_id directly.
    struct io_binding {
        scoms::kobject    ko{};                    ///< SCOMS identity (offset 0).
        u16               dev_no{};                ///< Device number (opaque handle, CSS-IO boundary).
        u16               sch_index{0xFFFF};       ///< Subchannel table index.
        io_substate       op_state{io_substate::bound};
        u32               owner_domain{~0U};       ///< Domain that owns this binding.
        u64               dma_base{0};             ///< DMA-able memory base (physical).
        u64               dma_size{0};             ///< DMA memory size.
        /// @brief Canonical storage-policy authority for the DMA allocation.
        memory::objects::memory_object_ref dma_storage{};
        memory::objects::memory_object_ref dma_extent{}; ///< Exact map authority for DMA pages.
        u64               pending_request_id{0};
        u32               storage_key_generation{0};
        u8                storage_key{0};
        u8                allowed_lpm{0};
        bool              teardown_started{false};
        u8                _reserved{0};

        io_completion     completions[IO_COMPLETION_DEPTH]{};
        u32               completion_head{0};
        u32               completion_tail{0};
        u32               completion_count{0};
        u32               completion_dropped{0};

        io_binding() noexcept = default;
    };

    static_assert(__builtin_offsetof(io_binding, ko) == 0);

    /// @brief Unprivileged format-1 CCW descriptor.
    /// @note @c data_offset is relative to the binding's public DMA extent;
    ///       the nucleus translates it to a device address after validation.
    struct io_ccw {
        u8  cmd{0};
        u8  flags{0};
        u16 count{0};
        u32 data_offset{0};
    };

    static_assert(sizeof(io_ccw) == 8U,
        "io_ccw must remain a fixed user/kernel ABI record");

} // namespace zxfoundation::sys::io

} // end export
