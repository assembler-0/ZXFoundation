/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/smp/smp_types.cxxm
/// @brief Cross-CPU function-call IPI data structures.

export module zxfoundation.smp.smp_types;
import zxfoundation.base.types;
import std;
import zxfoundation.rcu.rcu_types;

export {

namespace zxfoundation::smp {

    /// @brief Function pointer invoked by the target CPU on a CSD node.
    /// @param[in] info The @c csd.info field (caller-supplied fixed-width word).
    /// @param[in] data The @c csd.data pointer (caller-supplied opaque arg).
    /// @note Must not block; runs in IRQ-disabled softirq/IPI context on
    ///       the target CPU.  Re-entry to the framework is permitted.
    using smp_csd_fn = auto (*)(u64 info, void* data) noexcept -> void;

    /// @brief CSD flag bits.
    /// @{
    constexpr u32 SMP_CSD_F_SYNC      = 1U << 0;  ///< Producer waits for completion.
    constexpr u32 SMP_CSD_F_ASYNC     = 1U << 1;  ///< Fire-and-forget.
    constexpr u32 SMP_CSD_F_DONE      = 1U << 2;  ///< Set by dispatcher on completion.
    constexpr u32 SMP_CSD_F_RCU_FREE  = 1U << 3;  ///< Free via call_rcu on completion.
    constexpr u32 SMP_CSD_F_LOCKED    = 1U << 4;  ///< csd is in-flight (locked + pending).
    constexpr u32 SMP_CSD_F_QUEUED    = 1U << 5;  ///< csd is queued on a target CPU LIFO.
    constexpr u32 SMP_CSD_F_DISPATCH_LEASE = 1U << 6; ///< Holds one target dispatch lease.
    /// @}

    /// @brief One cross-CPU function-call descriptor.
    struct call_single_data {
        std::atomic<call_single_data*> next{nullptr};
        smp_csd_fn                                                  func{nullptr};
        void*                                                       data{nullptr};
        u64                                                          info{0};
        std::atomic<u32>                       flags{0};
        /// @brief Completion scratch word.  For @c SMP_CSD_F_SYNC the
        ///        dispatcher writes @c SMP_CSD_F_DONE on @c flags (release);
        ///        the producer polls @c csd_lock_wait.
        u64                                                          done_atm{0};
    };

    static_assert(sizeof(call_single_data) <= 64U,
        "call_single_data must fit one cache line so the queue head CAS "
        "does not false-share with the dispatcher scratch word");
    static_assert(__builtin_offsetof(call_single_data, next) == 0,
        "call_single_data::next must be at offset 0 — the LIFO drain "
        "treats the queue as a singly-linked chain");

    /// @brief csd queue statistics per CPU (read-only diagnostics).
    struct csd_stats {
        u64 enqueue_count{0};
        u64 dispatch_count{0};
        u64 csd_call_count{0};        ///< Total @c smp_call_function_single invocations on this CPU.
        u64 csd_call_many_count{0};    ///< Total @c smp_call_function_many invocations on this CPU.
    };

} // namespace zxfoundation::smp

} // end export
