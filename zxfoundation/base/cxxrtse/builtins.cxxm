/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/base/cxxrtse/builtins.cxxm
/// @brief Compiler-RT builtins for freestanding — provides 128-bit integer
///        runtime functions that clang emits for u128 arithmetic on s390x.

export module zxfoundation.base.cxxrtse.builtins;
import zxfoundation.base.types;

namespace detail {

    struct u128_pair {
        u64 hi{};
        u64 lo{};
    };

    /// @brief Split a u128 into high and low 64-bit halves.
    [[nodiscard]] static auto split(u128 v) noexcept -> u128_pair {
        union { u128 full; struct { u64 hi; u64 lo; } parts; } u;
        u.full = v;
        return {u.parts.hi, u.parts.lo};
    }

    /// @brief Combine two u64 halves into a u128.
    [[nodiscard]] static auto combine(u64 hi, u64 lo) noexcept -> u128 {
        union { u128 full; struct { u64 hi; u64 lo; } parts; } u;
        u.parts.hi = hi;
        u.parts.lo = lo;
        return u.full;
    }

} // namespace detail

extern "C" {

/// @brief 128-bit logical shift left.
auto __ashlti3(u128 a, int b) noexcept -> u128 {
    if (b == 0) return a;

    auto [hi, lo] = detail::split(a);

    if (b >= 128) return detail::combine(0, 0);

    if (b >= 64) {
        return detail::combine(lo << (b - 64), 0);
    }

    // 0 < b < 64
    const u64 new_hi = (hi << b) | (lo >> (64 - b));
    const u64 new_lo = lo << b;
    return detail::combine(new_hi, new_lo);
}

/// @brief 128-bit logical shift right.
auto __lshrti3(u128 a, int b) noexcept -> u128 {
    if (b == 0) return a;

    auto [hi, lo] = detail::split(a);

    if (b >= 128) return detail::combine(0, 0);

    if (b >= 64) {
        return detail::combine(0, hi >> (b - 64));
    }

    // 0 < b < 64
    const u64 new_hi = hi >> b;
    const u64 new_lo = (lo >> b) | (hi << (64 - b));
    return detail::combine(new_hi, new_lo);
}

/// @brief 128-bit arithmetic shift right.
auto __ashrti3(u128 a, int b) noexcept -> u128 {
    if (b == 0) return a;

    auto [hi, lo] = detail::split(a);
    const auto shi = static_cast<long long>(hi);

    if (b >= 128) {
        const auto fill = static_cast<u64>(shi >> 63);
        return detail::combine(fill, fill);
    }

    if (b >= 64) {
        return detail::combine(
            static_cast<u64>(shi >> 63),
            static_cast<u64>(shi >> (b - 64)));
    }

    // 0 < b < 64
    const u64 new_hi = static_cast<u64>(shi >> b);
    const u64 new_lo = (lo >> b) | (hi << (64 - b));
    return detail::combine(new_hi, new_lo);
}

auto __udivti3(u128 a, u128 b) noexcept -> u128 {
    if (b == 0) return 0;
    if (a < b)  return 0;
    if (a == b) return 1;

    // Fast path: both fit in 64 bits.
    auto [ah, al] = detail::split(a);
    auto [bh, bl] = detail::split(b);
    if (ah == 0 && bh == 0) {
        return detail::combine(0, al / bl);
    }

    // General case: binary long-division using the shift stubs above.
    u128 quot = 0;
    u128 rem  = 0;
    for (int i = 127; i >= 0; --i) {
        rem = __ashlti3(rem, 1);
        rem |= __lshrti3(a, i) & 1;
        if (rem >= b) {
            rem -= b;
            quot |= __ashlti3(static_cast<u128>(1), i);
        }
    }
    return quot;
}

auto __umodti3(u128 a, u128 b) noexcept -> u128 {
    if (b == 0) return 0;
    if (a < b)  return a;
    if (a == b) return 0;

    // Fast path.
    auto [ah, al] = detail::split(a);
    auto [bh, bl] = detail::split(b);
    if (ah == 0 && bh == 0) {
        return detail::combine(0, al % bl);
    }

    // General case.
    u128 rem = 0;
    for (int i = 127; i >= 0; --i) {
        rem = __ashlti3(rem, 1);
        rem |= __lshrti3(a, i) & 1;
        if (rem >= b) {
            rem -= b;
        }
    }
    return rem;
}

/// @brief Signed 128-bit division — @c __divti3.
/// @details clang emits this for @c i128 division.  We compute the magnitude
///          quotient via @c __udivti3 and apply the XOR-of-signs rule to the
///          result.  The @c INT128_MIN / -1 overflow is guarded (returns
///          INT128_MIN) so the operation is total, matching the freestanding
///          "no trap" expectation for this kernel runtime.
auto __divti3(i128 a, i128 b) noexcept -> i128 {
    if (b == 0) return 0;

    // INT128_MIN / -1 would overflow; clamp to INT128_MIN.
    if (a == static_cast<i128>((__uint128_t)1 << 127)
        && b == static_cast<i128>(-1)) {
        return static_cast<i128>((__uint128_t)1 << 127);
    }

    const bool neg_a = a < 0;
    const bool neg_b = b < 0;
    const auto ua = static_cast<u128>(neg_a ? -a : a);
    const auto ub = static_cast<u128>(neg_b ? -b : b);
    const auto uq = __udivti3(ua, ub);
    const auto sq = static_cast<i128>(uq);
    return (neg_a != neg_b) ? -sq : sq;
}

/// @brief Signed 128-bit modulo — @c __modti3.
/// @details clang emits this for @c i128 remainder.  The magnitude is computed
///          via @c __umodti3 and the sign of the result follows the dividend
///          (C truncated-toward-zero convention).
auto __modti3(i128 a, i128 b) noexcept -> i128 {
    if (b == 0) return 0;

    const bool neg_a = a < 0;
    const auto ua = static_cast<u128>(neg_a ? -a : a);
    const auto ub = static_cast<u128>((b < 0) ? -b : b);
    const auto ur = __umodti3(ua, ub);
    const auto sr = static_cast<i128>(ur);
    return neg_a ? -sr : sr;
}

/// @brief 128-bit multiply (needed by some codegen paths).
auto __multi3(u128 a, u128 b) noexcept -> u128 {
    auto [ah, al] = detail::split(a);
    auto [bh, bl] = detail::split(b);

    // (ah*2^64 + al) * (bh*2^64 + bl)
    // = ah*bh*2^128 (overflows, discard)
    //   + (ah*bl + al*bh)*2^64
    //   + al*bl
    const u128 lo_lo = static_cast<u128>(al) * static_cast<u128>(bl);
    const u128 cross = static_cast<u128>(ah) * static_cast<u128>(bl)
                     + static_cast<u128>(al) * static_cast<u128>(bh);

    auto [ll_hi, ll_lo] = detail::split(lo_lo);
    auto [cr_hi, cr_lo] = detail::split(cross);

    const u64 res_lo = ll_lo;
    const u64 res_hi = ll_hi + cr_lo;
    discard_value cr_hi; // overflow discarded

    return detail::combine(res_hi, res_lo);
}

} // extern "C"
