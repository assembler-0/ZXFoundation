/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/dgp/authorize.zcomponent/core.cxxm
/// @brief Unified DGP authorization.

export module zxfoundation.dgp.authorize.core;
import zxfoundation.base.types;
import zxfoundation.base.typestate;
import zxfoundation.dgp.isolation.types;
import zxfoundation.dgp.domain.types;
import zxfoundation.dgp.cap.types;
import zxfoundation.scoms.kobject.base;
import lib.error;
import lib.stl;
export import zxfoundation.dgp.gate.types;

export {

namespace zxfoundation::dgp {

    /// @brief Fine-grained metadata supplied alongside an authorization check.
    struct authorization_metadata {
        ::zxfoundation::dgp::right_mask   requested_rights{::zxfoundation::dgp::right::none};
        u64                target_va_start{0};
        u64                target_va_end{0};
        u32                gate_id{0};
        ::zxfoundation::dgp::cap::cap_token token{};
        ::zxfoundation::dgp::right_mask   token_rights{::zxfoundation::dgp::right::none};
    };

    /// @brief Short-lived authorization proof bound to object generations.
    struct authorization_lease {
        const scoms::kobject::bobject* caller{nullptr};
        const scoms::kobject::bobject* target{nullptr};
        u32 caller_generation{0};
        u32 target_generation{0};
        operation_kind operation{operation_kind::none};
        ::zxfoundation::dgp::right_mask rights{::zxfoundation::dgp::right::none};
        bool consumed{false};

        [[nodiscard]] auto valid() const noexcept -> bool {
            return !consumed && caller && target &&
                   caller->generation == caller_generation &&
                   target->generation == target_generation &&
                   caller->state == zxfoundation::base::lifecycle_state::active &&
                   target->state == zxfoundation::base::lifecycle_state::active;
        }

        [[nodiscard]] auto consume() noexcept -> bool {
            if (!valid()) return false;
            consumed = true;
            return true;
        }
    };

    /// @brief Unified DGP authorization chokepoint.
    /// @param[in] caller  Domain initiating the operation.
    /// @param[in] target  Domain being acted upon.
    /// @param[in] op      Operation kind.
    /// @param[in] meta    Additional metadata (rights, VAs, gate IDs).
    /// @return Success when both domains are active and the caller holds
    ///         the requested isolation rights.
    [[nodiscard]] auto authorize(
        const zxfoundation::dgp::domain::domain& caller,
        const zxfoundation::dgp::domain::domain& target,
        operation_kind op,
        const authorization_metadata& meta
    ) noexcept -> std::expected<authorization_lease, lib::kernel_error>;

} // namespace zxfoundation::dgp

} // end export
