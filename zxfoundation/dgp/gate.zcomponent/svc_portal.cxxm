/// @file zxfoundation/dgp/gate.zcomponent/svc_portal.cxxm
/// @brief Portal namespace dispatch handler.

export module zxfoundation.dgp.gate.registration:svc_portal;
import zxfoundation.dgp.gate.types;
import zxfoundation.dgp.svc;
import zxfoundation.base.types;
import zxfoundation.dgp.authorize;
import zxfoundation.dgp.isolation.types;
import zxfoundation.dgp.domain.types;
import zxfoundation.dgp.domain.core;
import zxfoundation.sys.printk.core;
import zxfoundation.dgp.portal.core;
import zxfoundation.dgp.portal.types;
import arch.s390x.cpu.lowcore;
import lib.error;
import lib.stl;

using zxfoundation::dgp::domain::domain;

namespace zxfoundation::dgp::gate::svc_portal::detail {

    [[nodiscard]] auto current_domain() noexcept -> domain::domain* {
        auto* lc = arch::s390x::cpu::lowcore::get_current();
        if (!lc) [[unlikely]] return nullptr;
        return reinterpret_cast<domain::domain*>(lc->get<"current_domain">());
    }

    auto svc_portal_create(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        discard_value a0; // validated admin cap token (dispatch_table already checked it)
        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto target_id = static_cast<u32>(a1);
        const u64  va_start  = a2;
        const u64  va_end    = a3;
        const auto prot      = static_cast<zxfoundation::dgp::portal::portal_prot>(a4);
        const u8   ar_num    = 0;

        // Look up target domain for cross-domain DGP check.
        auto* target = zxfoundation::dgp::domain::domain_find(target_id);
        if (!target) {
            zxfoundation::sys::printk::perr("portal_create: target domain {} not found", target_id);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::unknown));
        }

                auto result = zxfoundation::dgp::portal::portal_create(
            d->ko.id, target_id, va_start, va_end, prot, ar_num, nullptr);
        if (!result) {
            zxfoundation::sys::printk::perr("portal_create: portal_create failed");
            return svc::fail(result.error());
        }

        return *result;
    }

    auto svc_portal_destroy(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        discard_value a0; // validated admin cap token
        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto pid = static_cast<u32>(a1);

        auto result = zxfoundation::dgp::portal::portal_destroy(pid);
        if (!result) {
            zxfoundation::sys::printk::perr("portal_destroy: portal_destroy({}) failed", pid);
            return svc::fail(result.error());
        }

        return 0;
    }

} // namespace zxfoundation::dgp::gate::svc_portal::detail

export {

namespace zxfoundation::dgp::gate::svc_portal {

    auto dispatch(u32 op, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        using zxfoundation::dgp::gate::portal_op;

        switch (static_cast<portal_op>(op)) {
        case portal_op::create:
            return zxfoundation::dgp::gate::svc_portal::detail::svc_portal_create(a0, a1, a2, a3, a4);
        case portal_op::destroy:
            return zxfoundation::dgp::gate::svc_portal::detail::svc_portal_destroy(a0, a1, a2, a3, a4);
        default:
            zxfoundation::sys::printk::perr("portal_dispatch: unknown op {}", op);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::unknown));
        }
    }


    template <portal_op Op>
    auto dispatch_wrap(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        return dispatch(static_cast<u32>(Op), a0, a1, a2, a3, a4);
    }

} // namespace zxfoundation::dgp::gate::svc_portal

} // end export
