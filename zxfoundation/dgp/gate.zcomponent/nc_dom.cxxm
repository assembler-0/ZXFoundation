/// @file zxfoundation/dgp/gate.zcomponent/nc_dom.cxxm
/// @brief Domain namespace dispatch handler — Pure DGP (cap-gated).

export module zxfoundation.dgp.gate.registration:nc_dom;
import zxfoundation.dgp.gate.types;
import zxfoundation.dgp.domain.types;
import zxfoundation.dgp.domain.types;
import zxfoundation.dgp.domain.core;
import zxfoundation.base.types;
import zxfoundation.base.config;
import zxfoundation.base.typestate;
import zxfoundation.scoms.kobject.ref;
import zxfoundation.dgp.cap.types;
import zxfoundation.dgp.cap.core;
import zxfoundation.sys.printk.core;
import zxfoundation.dgp.authorize;
import zxfoundation.dgp.isolation.types;
import zxfoundation.sched.core;
import zxfoundation.sched.policy;
import arch.s390x.cpu.lowcore;
import arch.s390x.cpu.uaccess;
import lib.error;
import lib.stl;

static constexpr u64 NC_DOM_ERROR = ~0ULL;

using zxfoundation::dgp::domain::domain;
using zxfoundation::dgp::domain::domain_id;
using zxfoundation::dgp::domain::domain_flags;
using zxfoundation::dgp::domain::strand;
using zxfoundation::dgp::cap::cap_token;
using zxfoundation::dgp::cap::cap_rights;
using zxfoundation::dgp::cap::cap_type;

namespace zxfoundation::dgp::gate::nc_dom::detail {

    [[nodiscard]] auto current_domain() noexcept -> domain::domain* {
        auto* lc = arch::s390x::cpu::lowcore::get_current();
        if (!lc) [[unlikely]] return nullptr;
        return reinterpret_cast<domain::domain*>(lc->get<"current_domain">());
    }

    auto copy_from_user(void* dst, u64 src, u64 len, domain::domain* d) noexcept -> i32 {
        return arch::s390x::cpu::uaccess::copy_from_user(
            dst, src, len, d->root_phys);
    }

    /// @brief Validate that a capability token confers admin authority.
    [[nodiscard]] auto validate_admin(cap_token token, u32 owner_id) noexcept -> bool {
        auto dgp_r = zxfoundation::dgp::cap::cap_validate_generic_for(
            token, cap_rights::admin, owner_id);
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("dom: admin cap ownership validation failed");
            return false;
        }
        auto d_r = zxfoundation::dgp::cap::cap_validate<domain::domain>(
            token, cap_rights::admin);
        if (!d_r) {
            zxfoundation::sys::printk::perr("dom: admin cap validation failed");
            return false;
        }
        return true;
    }

    auto nc_domain_create(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        // a0 = admin capability token, a1 = user-space name pointer
        auto* caller = current_domain();
        if (!caller || !validate_admin(cap_token{a0}, caller->ko.id)) {
            return NC_DOM_ERROR;
        }

        auto* d = caller;
        if (!d) [[unlikely]] return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::domain_create,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::lifecycle,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("domain_create: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        const u64 user_name_ptr = a1;
        if (user_name_ptr == 0) {
            zxfoundation::sys::printk::perr("domain_create: null name pointer");
            return NC_DOM_ERROR;
        }

        char name_buf[64]{};
        if (copy_from_user(name_buf, user_name_ptr, 63, d) != 0) {
            zxfoundation::sys::printk::perr("domain_create: copy_from_user failed");
            return NC_DOM_ERROR;
        }
        name_buf[63] = '\0';

        auto result = zxfoundation::dgp::domain::domain_create(name_buf);
        if (!result) {
            zxfoundation::sys::printk::perr("domain_create: domain_create failed");
            return NC_DOM_ERROR;
        }

        const u32 new_id = (*result)->ko.id;
        return static_cast<u64>(new_id);
    }

    auto nc_domain_destroy(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        // a0 = admin capability token, a1 = target domain ID
        auto* caller = current_domain();
        if (!caller || !validate_admin(cap_token{a0}, caller->ko.id)) {
            return NC_DOM_ERROR;
        }

        auto* d = caller;
        if (!d) [[unlikely]] return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::domain_destroy,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::lifecycle,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("domain_destroy: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        const auto target_id = static_cast<domain_id>(a1);

        if (target_id == d->ko.id) {
            zxfoundation::sys::printk::perr("domain_destroy: cannot destroy self");
            return NC_DOM_ERROR;
        }

        auto result = zxfoundation::dgp::domain::domain_destroy(target_id);
        if (!result) {
            zxfoundation::sys::printk::perr(
                "domain_destroy: domain_destroy({}) failed: {}", target_id,
                result.error());
            return NC_DOM_ERROR;
        }

        return 0;
    }

    auto nc_domain_exit(u64, u64, u64, u64, u64) noexcept -> u64 {
        auto* d = current_domain();
        if (!d) [[unlikely]] return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::domain_exit,
            zxfoundation::dgp::authorization_metadata{});
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("domain_exit: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        discard_value zxfoundation::scoms::kobject::mark_dying(d);
        d->flags = d->flags | domain_flags::need_resched;

        return 0;
    }

    auto nc_domain_info(u64, u64, u64, u64, u64) noexcept -> u64 {
        auto* d = current_domain();
        if (!d) [[unlikely]] return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::domain_info,
            zxfoundation::dgp::authorization_metadata{});
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("domain_info: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        return static_cast<u64>(d->ko.id) |
               (static_cast<u64>(d->primary_strand.cpu) << 32);
    }

    auto nc_domain_strand_create(u64 a0, u64 a1, u64 a2, u64, u64) noexcept -> u64 {
        // a0 = admin capability token, a1 = cpu affinity, a2 = owner domain ID
        auto* caller = current_domain();
        if (!caller || !validate_admin(cap_token{a0}, caller->ko.id)) {
            return NC_DOM_ERROR;
        }

        auto* self = caller;
        if (!self) [[unlikely]] return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *self, *self,
            zxfoundation::dgp::operation_kind::strand_create,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::lifecycle
                                  | zxfoundation::dgp::isolation::isolation_rights::sched,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("domain_strand_create: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        const auto cpu_affinity = static_cast<u16>(a1 & 0xFFFFU);
        if (cpu_affinity >= zxfoundation::base::config::CONFIG_ZX_MAX_CPUS) {
            zxfoundation::sys::printk::perr("domain_strand_create: invalid CPU affinity {}", static_cast<u32>(cpu_affinity));
            return NC_DOM_ERROR;
        }

        domain::domain* owner = self;
        const auto owner_id = static_cast<domain_id>(a2);
        if (owner_id != 0U && owner_id != self->ko.id) {
            zxfoundation::sys::printk::perr("domain_strand_create: cross-domain spawn denied for {}", owner_id);
            return NC_DOM_ERROR;
        }

        zxfoundation::dgp::domain::strand_create_request request{};
        request.owner_domain = owner->ko.id;
        request.entry        = nullptr;  // Bare mode: SCOMS bookkeeping only.
        request.uregs        = nullptr;  // No user start frame either.
        request.cpu          = cpu_affinity;
        request.stack_order  = 2U;
        request.enqueue      = false;    // Idle strand — do NOT admit to run queue.

        auto result = zxfoundation::sched::strand_spawn(request);
        if (!result) {
            zxfoundation::sys::printk::perr("domain_strand_create: failed");
            return NC_DOM_ERROR;
        }

        strand* s = *result;
        return static_cast<u64>(s->ko.id);
    }

    auto nc_domain_query(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        auto* self = current_domain();
        if (!self) [[unlikely]] return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *self, *self,
            zxfoundation::dgp::operation_kind::domain_query,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::debug,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("domain_query: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        const auto query_id = static_cast<u32>(a0);

        domain::domain* target = self;
        if (query_id != 0 && query_id != self->ko.id) {
            target = zxfoundation::dgp::domain::domain_find(query_id);
            if (!target) {
                zxfoundation::sys::printk::perr("domain_query: domain {} not found", query_id);
                return NC_DOM_ERROR;
            }
        }

        const u32 state  = static_cast<u32>(target->ko.state);
        const u32 type   = static_cast<u32>(target->ko.type);
        const u32 result = (state & 0xFF) | ((type & 0xFF) << 8)
                         | (target->gate_count << 16)
                         | (target->portal_count << 24);

        return static_cast<u64>(result);
    }

    /// @brief dom_op::strand_set_policy — (admin cap, strand_id, &policy_u64...)
    auto nc_dom_strand_set_policy(u64 a0, u64 a1, u64 a2, u64, u64) noexcept -> u64 {
        auto* caller = current_domain();
        if (!caller || !validate_admin(cap_token{a0}, caller->ko.id)) return NC_DOM_ERROR;

        auto* self = caller;
        if (!self) [[unlikely]] return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *self, *self,
            zxfoundation::dgp::operation_kind::strand_set_policy,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::sched,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("strand_set_policy: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        const auto sid = static_cast<zxfoundation::dgp::domain::strand_id>(a1);
        if (sid != 0U) {
            // Only primary-strand policy updates are supported in this phase.
            zxfoundation::sys::printk::perr("strand_set_policy: non-primary strand {}", sid);
            return NC_DOM_ERROR;
        }

        zxfoundation::sched::sched_policy pol{};
        if (copy_from_user(&pol, a2, sizeof(pol), self) != 0) {
            zxfoundation::sys::printk::perr("strand_set_policy: copy_from_user failed");
            return NC_DOM_ERROR;
        }

        auto& s = self->primary_strand;
        const bool was_on_rq = s.on_rq;
        if (was_on_rq) {
            zxfoundation::sched::dequeue_strand(&s);
        }
        s.sched_policy = pol;
        s.sched_admission = {};
        if (auto r = zxfoundation::sched::strand_admit_policy(s, pol); !r) {
            zxfoundation::sys::printk::perr("strand_set_policy: admit_policy failed");
            // Roll back to fair default policy to avoid leaving strand in limbo.
            s.sched_policy = zxfoundation::sched::sched_policy{};
            s.sched_admission = {};
        } else {
            s.sched_admission = *r;
        }
        if (was_on_rq) {
            zxfoundation::sched::enqueue_strand(&s);
        }
        return 0;
    }

    /// @brief dom_op::strand_set_affinity — (admin cap, strand_id, sched_mask_bits)
    auto nc_dom_strand_set_affinity(u64 a0, u64 a1, u64 a2, u64, u64) noexcept -> u64 {
        auto* self = current_domain();
        if (!self || !validate_admin(cap_token{a0}, self->ko.id)) return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *self, *self,
            zxfoundation::dgp::operation_kind::strand_set_affinity,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::sched,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("strand_set_affinity: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        const auto sid = static_cast<zxfoundation::dgp::domain::strand_id>(a1);
        if (sid != 0U) {
            zxfoundation::sys::printk::perr("strand_set_affinity: non-primary strand {}", sid);
            return NC_DOM_ERROR;
        }

        const u64 bits = a2;
        self->primary_strand.sched_policy.allowed_cpus.bits = bits;
        return 0;
    }

    /// @brief dom_op::strand_query_state — (admin cap, strand_id)
    /// @details Returns a packed u64
    auto nc_dom_strand_query_state(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        auto* self = current_domain();
        if (!self || !validate_admin(cap_token{a0}, self->ko.id)) return NC_DOM_ERROR;

        auto dgp_r = zxfoundation::dgp::authorize(
            *self, *self,
            zxfoundation::dgp::operation_kind::strand_query_state,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::sched
                                  | zxfoundation::dgp::isolation::isolation_rights::debug,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("strand_query_state: DGP authorization denied");
            return NC_DOM_ERROR;
        }

        const auto sid = static_cast<zxfoundation::dgp::domain::strand_id>(a1);
        if (sid != 0U) {
            zxfoundation::sys::printk::perr("strand_query_state: non-primary strand {}", sid);
            return NC_DOM_ERROR;
        }

        const auto& s = self->primary_strand;
        const u64 sub   = static_cast<u64>(static_cast<u8>(s.substate)) & 0xFFULL;
        const u64 cls   = (static_cast<u64>(static_cast<u8>(s.sched_policy.class_id)) & 0x0FULL) << 8;
        const u64 on_rq = s.on_rq ? (1ULL << 11) : 0ULL;
        const u64 prio  = (static_cast<u64>(s.sched_policy.rt_priority) & 0xFFULL) << 16;
        const u64 cpu   = (static_cast<u64>(s.cpu) & 0xFFFFULL) << 24;
        return sub | cls | on_rq | prio | cpu;
    }

} // namespace zxfoundation::dgp::gate::nc_dom::detail

export {

namespace zxfoundation::dgp::gate::nc_dom {

    /// @brief Dispatch a domain operation.
    auto dispatch(u32 op, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        using zxfoundation::dgp::gate::dom_op;

        switch (static_cast<dom_op>(op)) {
        case dom_op::create:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_domain_create(a0, a1, a2, a3, a4);
        case dom_op::destroy:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_domain_destroy(a0, a1, a2, a3, a4);
        case dom_op::exit:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_domain_exit(a0, a1, a2, a3, a4);
        case dom_op::info:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_domain_info(a0, a1, a2, a3, a4);
        case dom_op::query:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_domain_query(a0, a1, a2, a3, a4);
        case dom_op::strand_create:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_domain_strand_create(a0, a1, a2, a3, a4);
        case dom_op::strand_set_policy:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_dom_strand_set_policy(a0, a1, a2, a3, a4);
        case dom_op::strand_set_affinity:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_dom_strand_set_affinity(a0, a1, a2, a3, a4);
        case dom_op::strand_query_state:
            return zxfoundation::dgp::gate::nc_dom::detail::nc_dom_strand_query_state(a0, a1, a2, a3, a4);
        default:
            zxfoundation::sys::printk::perr("dom_dispatch: unknown op {}", op);
            return NC_DOM_ERROR;
        }
    }

    /// @brief Static dispatch wrapper for a specific dom_op.
    template <dom_op Op>
    auto dispatch_wrap(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        return dispatch(static_cast<u32>(Op), a0, a1, a2, a3, a4);
    }

} // namespace zxfoundation::dgp::gate::nc_dom

} // end export
