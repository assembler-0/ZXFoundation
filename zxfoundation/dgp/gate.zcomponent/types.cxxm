/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/dgp/gate.zcomponent/types.cxxm
/// @brief Gate subsystem types — per-namespace call IDs, the gate descriptor,
///        and the flat dispatch-table types.

export module zxfoundation.dgp.gate.types;
import zxfoundation.base.types;
import zxfoundation.scoms.kobject.base;
import zxfoundation.dgp.authorize;

export {

namespace zxfoundation::dgp::gate {

    constexpr u32 MAX_GATES = 512U;

    enum class gate_type : u8 {
        nucleus = 0,
        domain  = 1,
    };

    enum class gate_auth : u8 {
        any   = 0,
        keyed = 1,
        owner = 2,
    };

    /// @brief Namespace identifiers for dispatch.
    enum class call_namespace : u8 {
        dom    = 0,
        mem    = 1,
        gate   = 2,
        portal = 3,
        io     = 4,
        sgn    = 5,
        cap    = 6,
        sys    = 7,
        _count = 8,
    };

    constexpr auto pack_call(call_namespace ns, u32 op) noexcept -> u32 {
        return (static_cast<u32>(ns) << 5) | (op & 0x1FU);
    }

    /// @brief Per-namespace operation IDs.

    enum class dom_op : u32 {
        create       = 0,
        destroy      = 1,
        exit         = 2,
        info         = 3,
        query        = 4,
        strand_create = 5,
        strand_set_policy   = 6,  ///< (strand_id, &sched_policy, ctx) — change class/prio/affinity.
        strand_set_affinity = 7,  ///< (strand_id, sched_mask_bits) — restrict CPU placement.
        strand_query_state  = 8,  ///< (strand_id, &out) — read cpu/on_rq/substate/prio/vruntime.
        _count       = 9,
    };

    enum class mem_op : u32 {
        alloc   = 0,
        free    = 1,
        map     = 2,
        unmap   = 3,
        protect = 4,
        share   = 5,
        _count  = 6,
    };

    enum class gate_op : u32 {
        create  = 0,
        destroy = 1,
        _count  = 2,
    };

    enum class portal_op : u32 {
        create  = 0,
        destroy = 1,
        _count  = 2,
    };

    enum class io_op : u32 {
        bind               = 0,
        unbind             = 1,
        submit             = 2,
        irq_bind           = 3, ///< Retired: hard IRQs never enter user gates.
        dma_extent         = 4,
        completion_dequeue = 5,
        _count             = 6,
    };

    enum class sgn_op : u32 {
        register_handler = 0,
        poll             = 1,
        ack              = 2,
        send             = 3,  ///< Cross-domain signal delivery: target_domain_id, kind, data.
        mask_set         = 4,  ///< Update blocked_mask (sigprocmask-style).
        mask_get         = 5,  ///< Read current blocked_mask.
        wait             = 6,  ///< Block current strand until any unblocked signal arrives.
        _count           = 7,
    };

    enum class cap_op : u32 {
        acquire  = 0,
        release  = 1,
        validate = 2,
        revoke   = 3,  ///< Admin-side revoke of a capability token (or its underlying rights bundle).
        _count   = 4,
    };

    enum class sys_op : u32 {
        time_yield         = 0,
        time_deadline      = 1,
        time_now           = 2,
        console_write      = 3,
        register_service   = 4,
        lookup_service     = 5,
        unregister_service = 6,
        ipc_endpoint_create = 7,
        ipc_endpoint_destroy = 8,
        ipc_send = 9,
        ipc_receive = 10,
        shm_export = 11,
        shm_import = 12,
        shm_map = 13,
        policy_register = 14,
        policy_unregister = 15,
        _count             = 16,
    };

    struct gate_desc {
        scoms::kobject::bobject ko{};
        gate_type type{gate_type::nucleus};
        gate_auth auth{gate_auth::any};
        u8        target_key{0};
        u8        _pad0{0};
        u32       target_domain{0};
        u64       entry_va{0};

        gate_desc() noexcept = default;
    };

    static_assert(__builtin_offsetof(gate_desc, ko) == 0);

} // namespace zxfoundation::dgp::gate

namespace zxfoundation::dgp::gate::dispatch {

    using zxfoundation::dgp::gate::call_namespace;

    /// @brief Gate authorization level enforced at dispatch time.
    enum class gate_auth_level : u8 {
        none        = 0, ///< No capability check — self-domain, time, console.
        capability  = 1, ///< Capability token required in a0.
        admin       = 2, ///< Admin-level capability required.
        domain_map  = 3, ///< Legacy domain capability with map right required.
        storage_key = 4, ///< Storage-key match required between caller and target.
        io          = 5, ///< I/O authority required (a0 is op-specific, not a cap).
        signal      = 6, ///< Signal-send right required (a0 = target domain id).
    };

    /// @brief Metadata attached to each dispatch table entry.
    struct entry_meta {
        u8                              namespace_id{0};
        u8                              operation_id{0};
        gate_auth_level                 auth{gate_auth_level::none};
        bool                            requires_admin{false};
        zxfoundation::dgp::operation_kind op_kind{
            zxfoundation::dgp::operation_kind::none};
    };

    /// @brief Maximum entries: 8 namespaces x 32 operations = 256.
    constexpr u32 DISPATCH_TABLE_SIZE = 256U;

    /// @brief Pack a namespace and operation into a table index.
    [[nodiscard]] constexpr auto pack_index(
        call_namespace ns, u32 op
    ) noexcept -> u32 {
        return (static_cast<u32>(ns) << 5) | (op & 0x1FU);
    }

    /// @brief Handler function signature for all nucleus calls.
    using dispatch_handler = auto (*)(
        u64 a0, u64 a1, u64 a2, u64 a3, u64 a4
    ) noexcept -> u64;

} // namespace zxfoundation::dgp::gate::dispatch_table

} // end export