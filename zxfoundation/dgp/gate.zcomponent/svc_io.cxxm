/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/dgp/gate.zcomponent/svc_io.cxxm
/// @brief I/O namespace dispatch handler.

export module zxfoundation.dgp.gate.registration:svc_io;
import zxfoundation.dgp.gate.types;
import zxfoundation.dgp.svc;
import zxfoundation.base.types;
import zxfoundation.dgp.authorize;
import zxfoundation.dgp.isolation.types;
import zxfoundation.dgp.domain.types;
import zxfoundation.sys.printk.core;
import zxfoundation.dgp.cap.core;
import zxfoundation.dgp.cap.types;
import zxfoundation.sys.zxio.core;
import zxfoundation.sys.zxio.types;
import arch.s390x.cpu.uaccess;
import arch.s390x.cpu.lowcore;
import lib.error;
import lib.stl;

using zxfoundation::dgp::domain::domain;

namespace zxfoundation::dgp::gate::svc_io::detail {

    [[nodiscard]] auto current_domain() noexcept -> domain::domain* {
        auto* lc = arch::s390x::cpu::lowcore::get_current();
        if (!lc) [[unlikely]] return nullptr;
        return reinterpret_cast<domain::domain*>(lc->get<"current_domain">());
    }

    auto copy_from_user(void* dst, u64 src, u64 len, domain::domain* d) noexcept -> i32 {
        return arch::s390x::cpu::uaccess::copy_from_user(
            dst, src, len, d->root_phys);
    }

    auto copy_to_user(u64 dst, const void* src, u64 len, domain::domain* d) noexcept -> i32 {
        return arch::s390x::cpu::uaccess::copy_to_user(
            dst, src, len, d->root_phys);
    }

    auto svc_io_bind(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        if (d->ko.id == 0U) {
            zxfoundation::sys::printk::perr("io_bind: nucleus cannot bind I/O");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        const u16 dev_no = static_cast<u16>(a0 & 0xFFFFU);

        zxfoundation::dgp::cap::cap_token token{};
        auto result = bind(dev_no, d->ko.id, token);
        if (!result) {
            zxfoundation::sys::printk::perr("io_bind: failed for dev_no={:#06x}",
                                           dev_no);
            return svc::fail(result.error());
        }

        return token.raw;
    }

    auto svc_io_unbind(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const zxfoundation::dgp::cap::cap_token token{a0};

        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            zxfoundation::sys::printk::perr("io_unbind: invalid token");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        auto result = unbind(token, d->ko.id);
        if (!result) {
            zxfoundation::sys::printk::perr("io_unbind: unbind failed");
            return svc::fail(result.error());
        }

        return 0;
    }

    auto svc_io_submit(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const zxfoundation::dgp::cap::cap_token token{a0};
        const u64 request_user_ptr = a1;

        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            zxfoundation::sys::printk::perr("io_submit: invalid token");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        if (request_user_ptr == 0) {
            zxfoundation::sys::printk::perr("io_submit: null request pointer");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        zxfoundation::sys::zxio::io_request request{};
        if (copy_from_user(&request, request_user_ptr, sizeof(request), d) != 0) {
            zxfoundation::sys::printk::perr("io_submit: copy_from_user failed");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        auto result = submit(token, d->ko.id, request);
        if (!result) {
            zxfoundation::sys::printk::perr("io_submit: io_submit failed");
            return svc::fail(result.error());
        }

        return 0;
    }

    auto svc_io_dma_extent(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));
        const zxfoundation::dgp::cap::cap_token token{a0};
        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }
        auto result = dma_extent(token, d->ko.id);
        if (!result) return svc::fail(result.error());
        return result->raw;
    }

    /// @brief a0 = I/O binding token, a1 = writable user completion record.
    auto svc_io_completion_dequeue(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d || a1 == 0U) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        const zxfoundation::dgp::cap::cap_token token{a0};
        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }
        auto completion = completion_dequeue(token, d->ko.id);
        if (!completion || copy_to_user(a1, &*completion, sizeof(*completion), d) != 0) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }
        return 0;
    }

} // namespace zxfoundation::dgp::gate::svc_io::detail

export {

namespace zxfoundation::dgp::gate::svc_io {

    auto dispatch(u32 op, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        using zxfoundation::dgp::gate::io_op;

        switch (static_cast<io_op>(op)) {
        case io_op::bind:
            return zxfoundation::dgp::gate::svc_io::detail::svc_io_bind(a0, a1, a2, a3, a4);
        case io_op::unbind:
            return zxfoundation::dgp::gate::svc_io::detail::svc_io_unbind(a0, a1, a2, a3, a4);
        case io_op::submit:
            return zxfoundation::dgp::gate::svc_io::detail::svc_io_submit(a0, a1, a2, a3, a4);
        case io_op::dma_extent:
            return zxfoundation::dgp::gate::svc_io::detail::svc_io_dma_extent(a0, a1, a2, a3, a4);
        case io_op::completion_dequeue:
            return zxfoundation::dgp::gate::svc_io::detail::svc_io_completion_dequeue(a0, a1, a2, a3, a4);
        default:
            zxfoundation::sys::printk::perr("io_dispatch: unknown op {}", op);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::unknown));
        }
    }


    template <io_op Op>
    auto dispatch_wrap(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        return dispatch(static_cast<u32>(Op), a0, a1, a2, a3, a4);
    }

} // namespace zxfoundation::dgp::gate::svc_io

} // end export
