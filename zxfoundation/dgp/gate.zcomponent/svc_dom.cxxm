/// @brief Domain namespace dispatch handler — Pure DGP (cap-gated).

export module zxfoundation.dgp.gate.registration:svc_dom;
import zxfoundation.dgp.gate.types;
import zxfoundation.dgp.svc;
import zxfoundation.dgp.domain.types;
import zxfoundation.dgp.domain.core;
import zxfoundation.base.types;
import zxfoundation.base.config;
import zxfoundation.base.typestate;
import zxfoundation.scoms.kobject.ref;
import zxfoundation.dgp.cap.types;
import zxfoundation.dgp.cap.core;
import zxfoundation.sys.printk.core;
import zxfoundation.dgp.authorize;
import zxfoundation.dgp.isolation.types;
import zxfoundation.sched.core;
import fs.exec.elf;
import zxfoundation.memory.kmalloc;
import zxfoundation.sched.strandctx.core;
import zxfoundation.sched.policy;
import arch.s390x.cpu.lowcore;
import arch.s390x.mmu;
import zxfoundation.memory.hhdm;
import arch.s390x.cpu.percpu;
import zxfoundation.sync.waitqueue.core;
import zxfoundation.sync.waitqueue.types;
import arch.s390x.cpu.uaccess;
import arch.s390x.cpu.psw;
import arch.s390x.sched.types;
import lib.error;
import lib.stl;

using zxfoundation::dgp::domain::domain;
using zxfoundation::dgp::domain::domain_id;
using zxfoundation::dgp::domain::domain_flags;
using zxfoundation::dgp::domain::strand;
using zxfoundation::dgp::cap::cap_token;
using ::zxfoundation::dgp::right_mask;
using zxfoundation::dgp::cap::cap_type;

namespace zxfoundation::dgp::gate::svc_dom::detail {

    [[nodiscard]] auto current_domain() noexcept -> domain::domain* {
        auto* lc = arch::s390x::cpu::lowcore::get_current();
        if (!lc) [[unlikely]] return nullptr;
        return reinterpret_cast<domain::domain*>(lc->get<"current_domain">());
    }

    auto copy_from_user(void* dst, u64 src, u64 len, domain::domain* d) noexcept -> i32 {
        return arch::s390x::cpu::uaccess::copy_from_user(
            dst, src, len, d->root_phys);
    }

    auto svc_domain_create(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        // a0 = admin capability token, a1 = user-space name pointer
        auto* caller = current_domain();
        if (!caller) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));
        }

        auto* d = caller;
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const u64 user_name_ptr = a1;
        if (user_name_ptr == 0) {
            zxfoundation::sys::printk::perr("domain_create: null name pointer");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        char name_buf[64]{};
        if (copy_from_user(name_buf, user_name_ptr, 63, d) != 0) {
            zxfoundation::sys::printk::perr("domain_create: copy_from_user failed");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }
        name_buf[63] = '\0';

        auto result = zxfoundation::dgp::domain::domain_create(name_buf);
        if (!result) {
            zxfoundation::sys::printk::perr("domain_create: domain_create failed");
            return svc::fail(result.error());
        }

        const u32 new_id = (*result)->ko.id;
        return static_cast<u64>(new_id);
    }

    auto svc_domain_destroy(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        // a0 = admin capability token, a1 = target domain ID
        auto* caller = current_domain();
        if (!caller) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));
        }

        auto* d = caller;
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto target_id = static_cast<domain_id>(a1);

        if (target_id == d->ko.id) {
            zxfoundation::sys::printk::perr("domain_destroy: cannot destroy self");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        auto result = zxfoundation::dgp::domain::domain_destroy(target_id);
        if (!result) {
            zxfoundation::sys::printk::perr(
                "domain_destroy: domain_destroy({}) failed: {}", target_id,
                result.error());
            return svc::fail(result.error());
        }

        return 0;
    }

    auto svc_domain_exit(u64, u64, u64, u64, u64) noexcept -> u64 {
        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        discard_value zxfoundation::scoms::kobject::mark_dying(d);
        d->flags = d->flags | domain_flags::need_resched;

        return 0;
    }

    auto svc_domain_info(u64, u64, u64, u64, u64) noexcept -> u64 {
        auto* d = current_domain();
        if (!d) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        return static_cast<u64>(d->ko.id) |
               (static_cast<u64>(d->primary_strand.cpu) << 32);
    }

    auto svc_domain_strand_create(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        // a0 = admin capability token, a1 = cpu affinity, a2 = owner domain ID,
        // a3 = user entry VA
        auto* caller = current_domain();
        if (!caller) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));
        }

        auto* self = caller;
        if (!self) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto cpu_affinity = static_cast<u16>(a1 & 0xFFFFU);
        if (cpu_affinity >= zxfoundation::base::config::CONFIG_ZX_MAX_CPUS) {
            zxfoundation::sys::printk::perr("domain_strand_create: invalid CPU affinity {}", static_cast<u32>(cpu_affinity));
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        domain::domain* owner = self;
        const auto owner_id = static_cast<domain_id>(a2);
        if (owner_id != 0U && owner_id != self->ko.id) {
            zxfoundation::sys::printk::perr("domain_strand_create: cross-domain spawn denied for {}", owner_id);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        if (a3 == 0U) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        arch::s390x::sched::user_regs uregs{};
        uregs.psw_mask = arch::s390x::cpu::psw::PSW_MASK_USER;
        uregs.psw_addr = a3;

        zxfoundation::dgp::domain::strand_create_request request{};
        request.owner_domain = owner->ko.id;
        request.entry        = nullptr;
        request.uregs        = &uregs;
        request.cpu          = cpu_affinity;
        request.enqueue      = true;

        auto result = zxfoundation::sched::strand_spawn(request);
        if (!result) {
            zxfoundation::sys::printk::perr("domain_strand_create: failed");
            return svc::fail(result.error());
        }
        strand* s = *result;
        return static_cast<u64>(s->ko.id);
    }

    /// @brief dom_op::exec — (cap, dom_id, image_va, image_len): exec-analog
    auto svc_domain_exec(u64, u64 a1, u64 a2, u64 a3, u64) noexcept -> u64 {
        auto* caller = current_domain();
        if (!caller) [[unlikely]]
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        auto* target = zxfoundation::dgp::domain::domain_find(static_cast<u32>(a1));
        if (!target) {
            zxfoundation::sys::printk::perr("domain_exec: no domain {}",
                static_cast<u32>(a1));
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::not_found));
        }
        // Fresh-domain contract: identity active, image never loaded.
        if (target->ko.state != zxfoundation::base::lifecycle_state::active ||
            target->primary_strand.on_rq ||
            target->primary_strand.substate
                != zxfoundation::sched::sched_substate::idle) {
            zxfoundation::sys::printk::perr("domain_exec: domain {} not fresh",
                static_cast<u32>(a1));
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }
        if (a2 == 0U || a3 == 0U || a3 > (256U * 1024U)) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        void* image = zxfoundation::memory::kmalloc::kmalloc(a3);
        if (!image) {
            return svc::fail(lib::kernel_error::from_memory(
                lib::memory_error::out_of_memory));
        }
        {
            u64 off = 0U;
            while (off < a3) {
                const u64 chunk = (a3 - off > 4096U) ? 4096U : (a3 - off);
                const i32 cr = copy_from_user(
                    static_cast<u8*>(image) + off, a2 + off, chunk,
                    caller);
                if (cr != 0) {
                    zxfoundation::memory::kmalloc::kfree(image);
                    return svc::fail(lib::kernel_error::from_generic(
                        lib::generic_error::invalid_arg));
                }
                off += chunk;
            }
        }
        auto entry = fs::exec::elf::load(target, image, a3);

        zxfoundation::memory::kmalloc::kfree(image);
        if (!entry) {
            zxfoundation::sys::printk::perr("domain_exec: elf load failed");
            return svc::fail(entry.error());
        }

        target->granted_rights = caller->granted_rights;
        target->primary_strand.cpu = caller->primary_strand.cpu;
        auto admin_r = zxfoundation::dgp::cap::cap_issue(
            zxfoundation::dgp::cap::cap_type::domain,
            static_cast<u16>(target->ko.id),
            ::zxfoundation::dgp::right::all,
            target->ko.id);
        if (!admin_r) {
            zxfoundation::sys::printk::perr("domain_exec: cap issue failed");
            return svc::fail(admin_r.error());
        }
        target->primary_strand.body->uregs.psw_mask =
            arch::s390x::cpu::psw::PSW_MASK_USER;
        target->primary_strand.body->uregs.psw_addr = *entry;
        target->primary_strand.body->uregs.gprs[10] = admin_r->raw;
        zxfoundation::sched::strandctx::setup_primary_strand_context_user(target);
        zxfoundation::sched::enqueue_domain(target);
        return 0U;
    }

    auto svc_domain_query(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        auto* self = current_domain();
        if (!self) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto query_id = static_cast<u32>(a0);

        domain::domain* target = self;
        if (query_id != 0 && query_id != self->ko.id) {
            target = zxfoundation::dgp::domain::domain_find(query_id);
            if (!target) {
                zxfoundation::sys::printk::perr("domain_query: domain {} not found", query_id);
                return svc::fail(lib::kernel_error::from_generic(lib::generic_error::unknown));
            }
        }

        const u32 state  = static_cast<u32>(target->ko.state);
        const u32 type   = static_cast<u32>(target->ko.type);
        const u32 result = (state & 0xFF) | ((type & 0xFF) << 8)
                         | (target->gate_count << 16)
                         | (target->portal_count << 24);

        return static_cast<u64>(result);
    }

    /// @brief dom_op::strand_set_policy — (admin cap, strand_id, &policy_u64...)
    auto svc_dom_strand_set_policy(u64 a0, u64 a1, u64 a2, u64, u64) noexcept -> u64 {
        auto* caller = current_domain();
        if (!caller) return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        auto* self = caller;
        if (!self) [[unlikely]] return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto sid = static_cast<zxfoundation::dgp::domain::strand_id>(a1);
        if (sid != 0U) {
            // Only primary-strand policy updates are supported in this phase.
            zxfoundation::sys::printk::perr("strand_set_policy: non-primary strand {}", sid);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        zxfoundation::sched::sched_policy pol{};
        if (copy_from_user(&pol, a2, sizeof(pol), self) != 0) {
            zxfoundation::sys::printk::perr("strand_set_policy: copy_from_user failed");
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        auto& s = self->primary_strand;
        const bool was_on_rq = s.on_rq;
        if (was_on_rq) {
            zxfoundation::sched::dequeue_strand(&s);
        }
        s.sched_policy = pol;
        s.sched_admission = {};
        if (auto r = zxfoundation::sched::strand_admit_policy(s, pol); !r) {
            zxfoundation::sys::printk::perr("strand_set_policy: admit_policy failed");
            s.sched_policy = zxfoundation::sched::sched_policy{};
            s.sched_admission = {};
        } else {
            s.sched_admission = *r;
        }
        if (was_on_rq) {
            zxfoundation::sched::enqueue_strand(&s);
        }
        return 0;
    }

    /// @brief dom_op::strand_set_affinity — (admin cap, strand_id, sched_mask_bits)
    auto svc_dom_strand_set_affinity(u64 a0, u64 a1, u64 a2, u64, u64) noexcept -> u64 {
        auto* self = current_domain();
        if (!self) return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto sid = static_cast<zxfoundation::dgp::domain::strand_id>(a1);
        if (sid != 0U) {
            zxfoundation::sys::printk::perr("strand_set_affinity: non-primary strand {}", sid);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        const u64 bits = a2;
        self->primary_strand.sched_policy.allowed_cpus.bits = bits;
        return 0;
    }

    /// Wake callback for exit-join parks — canonical wake discipline
    auto strand_wake(void* opaque) noexcept -> void {
        auto* s = static_cast<zxfoundation::dgp::domain::strand*>(opaque);
        if (!s) return;
        zxfoundation::sched::wake_strand(*s);
    }

    /// @brief dom_op::strand_join — (strand_id): park until the target strand exit
    auto svc_dom_strand_join(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        auto* self = current_domain();
        if (!self) return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        auto* target = zxfoundation::dgp::domain::strand_find(
            *self, static_cast<u32>(a0));
        if (!target || !target->body) {
            zxfoundation::sys::printk::perr("strand_join: no strand {}", static_cast<u32>(a0));
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        auto& pcp = arch::s390x::cpu::percpu::this_cpu();
        auto* caller = reinterpret_cast<zxfoundation::dgp::domain::strand*>(pcp.current_strand);
        if (caller == target) {
            zxfoundation::sys::printk::perr("strand_join: self-join {}", static_cast<u32>(a0));
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        zxfoundation::sync::waitqueue::wait_entry entry{};
        entry.node.context = caller;
        entry.node.wake_fn = strand_wake;
        for (;;) {
            if (caller) caller->substate = zxfoundation::sched::sched_substate::blocked;
            if (zxfoundation::sync::waitqueue::prepare_to_wait_event(
                    target->body->exit_wait, entry,
                    zxfoundation::sync::waitqueue::wait_flags::none,
                    [target]() noexcept -> bool {
                        return target->body->exited != 0U;
                    }))
                break;
            zxfoundation::sched::schedule();
        }
        if (caller) caller->substate = zxfoundation::sched::sched_substate::running;
        zxfoundation::sync::waitqueue::finish_wait(target->body->exit_wait, entry);
        return target->body->exit_code;
    }

    /// dom_op::strand_exit — (code): terminate the calling strand. The body
    /// stays allocated for joiners; domain teardown reaps it
    auto svc_dom_strand_exit(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        auto& pcp = arch::s390x::cpu::percpu::this_cpu();
        auto* self = reinterpret_cast<zxfoundation::dgp::domain::strand*>(pcp.current_strand);
        if (!self || !self->body) {
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));
        }

        self->body->exit_code = a0;
        self->body->exited = 1U;
        zxfoundation::sync::waitqueue::wake_up(self->body->exit_wait);

        // Leave the run queue and never come back: the strand is dead (A10).
        zxfoundation::sched::strand_trampoline_exit();
    }

    /// @brief dom_op::strand_query_state — (admin cap, strand_id)
    /// @details Returns a packed u64
    auto svc_dom_strand_query_state(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        auto* self = current_domain();
        if (!self) return svc::fail(lib::kernel_error::from_generic(lib::generic_error::internal_error));

        const auto sid = static_cast<zxfoundation::dgp::domain::strand_id>(a1);
        if (sid != 0U) {
            zxfoundation::sys::printk::perr("strand_query_state: non-primary strand {}", sid);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }

        const auto& s = self->primary_strand;
        const u64 sub   = static_cast<u64>(static_cast<u8>(s.substate)) & 0xFFULL;
        const u64 cls   = (static_cast<u64>(static_cast<u8>(s.sched_policy.class_id)) & 0x0FULL) << 8;
        const u64 on_rq = s.on_rq ? (1ULL << 11) : 0ULL;
        const u64 prio  = (static_cast<u64>(s.sched_policy.rt_priority) & 0xFFULL) << 16;
        const u64 cpu   = (static_cast<u64>(s.cpu) & 0xFFFFULL) << 24;
        return sub | cls | on_rq | prio | cpu;
    }

} // namespace zxfoundation::dgp::gate::svc_dom::detail

export {

namespace zxfoundation::dgp::gate::svc_dom {

    /// @brief Dispatch a domain operation.
    auto dispatch(u32 op, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        using zxfoundation::dgp::gate::dom_op;

        switch (static_cast<dom_op>(op)) {
        case dom_op::create:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_domain_create(a0, a1, a2, a3, a4);
        case dom_op::destroy:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_domain_destroy(a0, a1, a2, a3, a4);
        case dom_op::exit:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_domain_exit(a0, a1, a2, a3, a4);
        case dom_op::info:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_domain_info(a0, a1, a2, a3, a4);
        case dom_op::query:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_domain_query(a0, a1, a2, a3, a4);
        case dom_op::strand_create:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_domain_strand_create(a0, a1, a2, a3, a4);
        case dom_op::strand_set_policy:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_dom_strand_set_policy(a0, a1, a2, a3, a4);
        case dom_op::strand_set_affinity:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_dom_strand_set_affinity(a0, a1, a2, a3, a4);
        case dom_op::strand_query_state:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_dom_strand_query_state(a0, a1, a2, a3, a4);
        case dom_op::strand_join:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_dom_strand_join(a0, a1, a2, a3, a4);
        case dom_op::strand_exit:
            return zxfoundation::dgp::gate::svc_dom::detail::svc_dom_strand_exit(a0, a1, a2, a3, a4);
            case dom_op::exec:
                return zxfoundation::dgp::gate::svc_dom::detail::svc_domain_exec(a0, a1, a2, a3, a4);
        default:
            zxfoundation::sys::printk::perr("dom_dispatch: unknown op {}", op);
            return svc::fail(lib::kernel_error::from_generic(lib::generic_error::unknown));
        }
    }

    /// @brief Static dispatch wrapper for a specific dom_op.
    template <dom_op Op>
    auto dispatch_wrap(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        return dispatch(static_cast<u32>(Op), a0, a1, a2, a3, a4);
    }

} // namespace zxfoundation::dgp::gate::svc_dom

} // end export
