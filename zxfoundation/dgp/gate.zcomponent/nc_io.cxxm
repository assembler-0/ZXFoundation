/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/dgp/gate.zcomponent/nc_io.cxxm
/// @brief I/O namespace dispatch handler.

export module zxfoundation.dgp.gate.nc_io;
import zxfoundation.dgp.gate.types;
import zxfoundation.base.types;
import zxfoundation.dgp.authorize;
import zxfoundation.dgp.isolation.types;
import zxfoundation.dgp.domain.types;
import zxfoundation.sys.printk.core;
import zxfoundation.dgp.cap.core;
import zxfoundation.dgp.cap.types;
import zxfoundation.sys.zxio.core;
import zxfoundation.sys.zxio.types;
import arch.s390x.cpu.uaccess;
import arch.s390x.cpu.lowcore;
import lib.error;
import std;

static constexpr u64 NC_IO_ERROR = ~0ULL;

using zxfoundation::dgp::domain::domain;

namespace zxfoundation::dgp::gate::nc_io::detail {

    [[nodiscard]] auto current_domain() noexcept -> domain::domain* {
        auto* lc = arch::s390x::cpu::lowcore::get_current();
        if (!lc) [[unlikely]] return nullptr;
        return reinterpret_cast<domain::domain*>(lc->current_domain);
    }

    auto copy_from_user(void* dst, u64 src, u64 len, domain::domain* d) noexcept -> i32 {
        return arch::s390x::cpu::uaccess::copy_from_user(
            dst, src, len, d->root_phys);
    }

    auto copy_to_user(u64 dst, const void* src, u64 len, domain::domain* d) noexcept -> i32 {
        return arch::s390x::cpu::uaccess::copy_to_user(
            dst, src, len, d->root_phys);
    }

    auto nc_io_bind(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return NC_IO_ERROR;

        if (d->ko.id == 0U) {
            zxfoundation::sys::printk::perr("io_bind: nucleus cannot bind I/O");
            return NC_IO_ERROR;
        }

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::io_bind,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::io,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("io_bind: DGP authorization denied");
            return NC_IO_ERROR;
        }

        const u16 dev_no = static_cast<u16>(a0 & 0xFFFFU);

        zxfoundation::dgp::cap::cap_token token{};
        auto result = bind(dev_no, d->ko.id, token);
        if (!result) {
            zxfoundation::sys::printk::perr("io_bind: failed for dev_no={:#06x}",
                                           dev_no);
            return NC_IO_ERROR;
        }

        return token.raw;
    }

    auto nc_io_unbind(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return NC_IO_ERROR;

        const zxfoundation::dgp::cap::cap_token token{a0};

        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            zxfoundation::sys::printk::perr("io_unbind: invalid token");
            return NC_IO_ERROR;
        }
        if ((token.rights() & zxfoundation::dgp::cap::cap_rights::destroy)
                == zxfoundation::dgp::cap::cap_rights::none) {
            zxfoundation::sys::printk::perr("io_unbind: token lacks destroy right");
            return NC_IO_ERROR;
        }

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::io_unbind,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::io,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("io_unbind: DGP authorization denied");
            return NC_IO_ERROR;
        }

        auto result = unbind(token, d->ko.id);
        if (!result) {
            zxfoundation::sys::printk::perr("io_unbind: unbind failed");
            return NC_IO_ERROR;
        }

        return 0;
    }

    auto nc_io_submit(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return NC_IO_ERROR;

        const zxfoundation::dgp::cap::cap_token token{a0};
        const u64 request_user_ptr = a1;

        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            zxfoundation::sys::printk::perr("io_submit: invalid token");
            return NC_IO_ERROR;
        }
        if ((token.rights() & zxfoundation::dgp::cap::cap_rights::exec)
                == zxfoundation::dgp::cap::cap_rights::none) {
            zxfoundation::sys::printk::perr("io_submit: token lacks exec right");
            return NC_IO_ERROR;
        }

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::io_submit,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::io,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("io_submit: DGP authorization denied");
            return NC_IO_ERROR;
        }

        if (request_user_ptr == 0) {
            zxfoundation::sys::printk::perr("io_submit: null request pointer");
            return NC_IO_ERROR;
        }

        zxfoundation::sys::zxio::io_request request{};
        if (copy_from_user(&request, request_user_ptr, sizeof(request), d) != 0) {
            zxfoundation::sys::printk::perr("io_submit: copy_from_user failed");
            return NC_IO_ERROR;
        }

        auto result = submit(token, d->ko.id, request);
        if (!result) {
            zxfoundation::sys::printk::perr("io_submit: io_submit failed");
            return NC_IO_ERROR;
        }

        return 0;
    }

    auto nc_io_irq_bind(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return NC_IO_ERROR;

        const zxfoundation::dgp::cap::cap_token token{a0};
        const auto gate_id = static_cast<u32>(a1);

        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            zxfoundation::sys::printk::perr("io_irq_bind: invalid token");
            return NC_IO_ERROR;
        }
        if ((token.rights() & zxfoundation::dgp::cap::cap_rights::write)
                == zxfoundation::dgp::cap::cap_rights::none) {
            zxfoundation::sys::printk::perr("io_irq_bind: token lacks write right");
            return NC_IO_ERROR;
        }

        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d,
            zxfoundation::dgp::operation_kind::io_irq_bind,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::io,
                .gate_id = gate_id,
            });
        if (!dgp_r) {
            zxfoundation::sys::printk::perr("io_irq_bind: DGP authorization denied");
            return NC_IO_ERROR;
        }

        auto result = irq_bind(token, d->ko.id, gate_id);
        if (!result) {
            zxfoundation::sys::printk::perr("io_irq_bind: irq bind failed");
            return NC_IO_ERROR;
        }

        return 0;
    }

    auto nc_io_dma_extent(u64 a0, u64, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d) [[unlikely]] return NC_IO_ERROR;
        const zxfoundation::dgp::cap::cap_token token{a0};
        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            return NC_IO_ERROR;
        }
        auto owner = zxfoundation::dgp::cap::cap_validate_generic_for(
            token, zxfoundation::dgp::cap::cap_rights::read, d->ko.id);
        if (!owner) return NC_IO_ERROR;
        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d, zxfoundation::dgp::operation_kind::io_dma_extent,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::io,
            });
        if (!dgp_r) return NC_IO_ERROR;
        auto result = dma_extent(token, d->ko.id);
        if (!result || !dgp_r->consume()) return NC_IO_ERROR;
        return result->raw;
    }

    /// @brief a0 = I/O binding token, a1 = writable user completion record.
    auto nc_io_completion_dequeue(u64 a0, u64 a1, u64, u64, u64) noexcept -> u64 {
        using namespace zxfoundation::sys::zxio;

        auto* d = current_domain();
        if (!d || a1 == 0U) [[unlikely]] return NC_IO_ERROR;
        const zxfoundation::dgp::cap::cap_token token{a0};
        if (!token || token.type() != zxfoundation::dgp::cap::cap_type::io_device) {
            return NC_IO_ERROR;
        }
        auto owner = zxfoundation::dgp::cap::cap_validate_generic_for(
            token, zxfoundation::dgp::cap::cap_rights::read, d->ko.id);
        if (!owner) return NC_IO_ERROR;
        auto dgp_r = zxfoundation::dgp::authorize(
            *d, *d, zxfoundation::dgp::operation_kind::io_completion_dequeue,
            zxfoundation::dgp::authorization_metadata{
                .requested_rights = zxfoundation::dgp::isolation::isolation_rights::io,
            });
        if (!dgp_r) return NC_IO_ERROR;

        auto completion = completion_dequeue(token, d->ko.id);
        if (!completion || copy_to_user(a1, &*completion, sizeof(*completion), d) != 0 ||
            !dgp_r->consume()) {
            return NC_IO_ERROR;
        }
        return 0;
    }

} // namespace zxfoundation::dgp::gate::nc_io::detail

export {

namespace zxfoundation::dgp::gate::nc_io {

    auto dispatch(u32 op, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        using zxfoundation::dgp::gate::io_op;

        switch (static_cast<io_op>(op)) {
        case io_op::bind:
            return zxfoundation::dgp::gate::nc_io::detail::nc_io_bind(a0, a1, a2, a3, a4);
        case io_op::unbind:
            return zxfoundation::dgp::gate::nc_io::detail::nc_io_unbind(a0, a1, a2, a3, a4);
        case io_op::submit:
            return zxfoundation::dgp::gate::nc_io::detail::nc_io_submit(a0, a1, a2, a3, a4);
        case io_op::irq_bind:
            return zxfoundation::dgp::gate::nc_io::detail::nc_io_irq_bind(a0, a1, a2, a3, a4);
        case io_op::dma_extent:
            return zxfoundation::dgp::gate::nc_io::detail::nc_io_dma_extent(a0, a1, a2, a3, a4);
        case io_op::completion_dequeue:
            return zxfoundation::dgp::gate::nc_io::detail::nc_io_completion_dequeue(a0, a1, a2, a3, a4);
        default:
            zxfoundation::sys::printk::perr("io_dispatch: unknown op {}", op);
            return NC_IO_ERROR;
        }
    }


    template <io_op Op>
    auto dispatch_wrap(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4) noexcept -> u64 {
        return dispatch(static_cast<u32>(Op), a0, a1, a2, a3, a4);
    }

} // namespace zxfoundation::dgp::gate::nc_io

} // end export
