/// @file zxfoundation/locking/rt_mutex.cxxm
/// @brief Real-time mutex with multi-link priority inheritance.

export module zxfoundation.locking.rt_mutex;
import zxfoundation.base.types;
import zxfoundation.base.typestate;
import zxfoundation.locking.qspinlock;
import zxfoundation.locking.lock;
import zxfoundation.domain.strand_types;
import zxfoundation.domain.domain_types;
import zxfoundation.domain.domain;
import zxfoundation.sched.sched;
import zxfoundation.sched.sched_rt;
import zxfoundation.sched.sched_policy_types;
import zxfoundation.sched.context;
import zxfoundation.dgp.isolation_types;
import zxfoundation.dgp.isolation;
import arch.s390x.cpu.lowcore;
import arch.s390x.cpu.irq;
import arch.s390x.cpu.irq_types;
import arch.s390x.lib.atomic;
import lib.list;
import lib.util;
import lib.expected;
import lib.error;

namespace zxfoundation::locking::rt_mutex_detail {

    using zxfoundation::domain::strand;
    using zxfoundation::domain::domain;
    using zxfoundation::sched::sched_class_id;

    /// @brief Recover the enclosing @c strand from its @c pi_waiters node.
    /// @details @c pi_waiters lives on @c strand_body (the cold-storage
    ///          slab), but the rt_mutex code reaches the owning ~strand~
    ///          to read/write @c sched_policy and @c substate.  The
    ///          indirection is: pi_waiters → strand_body via
    ///          @c container_of, then strand_body → strand via
    ///          @c __builtin_offsetof(strand, body).
    [[nodiscard]] inline auto strand_from_pi_waiters(lib::list_node* n) noexcept -> strand* {
        auto* body = lib::container_of<
            zxfoundation::domain::strand_body,
            lib::list_node,
            &zxfoundation::domain::strand_body::pi_waiters>(n);
        return reinterpret_cast<strand*>(
            reinterpret_cast<u8*>(body) -
            __builtin_offsetof(zxfoundation::domain::strand, body));
    }

    /// @brief Defensive upper bound on the PI chain length.  Real lock
    ///        nesting depths are tiny; this is a pure DoS guard.
    static constexpr u32 MAX_PI_DEPTH = 16U;

    /// @brief Forward-declared so the chain walker can refer to it
    ///        before the class body met the compiler.
    class rt_mutex_impl;

    /// @brief Effective RT priority of a strand — boosted_prio if set,
    ///        else @c sched_policy.rt_priority when class is rt, else 0.
    [[nodiscard]] auto effective_rt_prio(const strand& s) noexcept -> u8 {
        if (s.body && s.body->boosted_prio != 0U) {
            return s.body->boosted_prio;
        }
        if (s.sched_policy.class_id == sched_class_id::rt) {
            return s.sched_policy.rt_priority;
        }
        return 0U;
    }

    /// @brief DGP cross-domain PI propagation gate.
    /// @return true when a boost may flow from @c waiter to @c owner.
    ///         Intra-domain: always true.  Cross-domain: requires the
    ///         owner to hold @c delegate and the waiter to hold @c enter.
    [[nodiscard]] auto pi_may_cross(const strand& waiter, const strand& owner) noexcept -> bool {
        const auto* wd = static_cast<const domain*>(waiter.owner);
        const auto* od = static_cast<const domain*>(owner.owner);
        if (!wd || !od) return true;
        if (wd == od) return true;
        using zxfoundation::dgp::isolation_rights;
        using zxfoundation::dgp::has_all_rights;
        return has_all_rights(od->granted_rights, isolation_rights::delegate)
            && has_all_rights(wd->granted_rights, isolation_rights::enter);
    }

    /// @brief Highest effective RT priority among the waiters of @c m.
    ///        Caller must hold @c m.pi_lock.
    [[nodiscard]] auto top_waiter_prio(const lib::list_head& waiters) noexcept -> u8 {
        u8 best = 0U;
        for (auto waiter : waiters) {
            auto* ws = strand_from_pi_waiters(waiter);
            const u8 p = effective_rt_prio(*ws);
            if (p > best) best = p;
        }
        return best;
    }

    /// @brief Re-apply the boost on @c owner given the current top-waiter
    ///        priority @c new_prio of the mutex it holds.
    ///        If @c new_prio is 0, calls @c unboost_prio.
    ///        Honors the DGP cross-domain gate via @c pi_may_cross using
    ///        the top waiter (first in the waiters list) as a representative.
    ///        Caller holds @c mutex.pi_lock.
    auto reboost_owner(strand& owner, u8 new_prio, const strand& top_waiter) noexcept -> void {
        if (new_prio == 0U) {
            zxfoundation::sched::rt::unboost_prio(owner);
            return;
        }
        if (!pi_may_cross(top_waiter, owner)) {
            // DGP boundary — do not propagate.  Owner keeps its own prio.
            return;
        }
        zxfoundation::sched::rt::boost_prio(owner, new_prio);
    }

} // namespace zxfoundation::locking::rt_mutex_detail

export {

namespace zxfoundation::locking::rt_mutex {

    using arch::s390x::lib::atomic::atomic;
    using arch::s390x::lib::atomic::memory_order;
    using zxfoundation::domain::strand;
    using zxfoundation::domain::domain;
    using zxfoundation::domain::sched_substate;
    using zxfoundation::domain::domain_flags;
    using zxfoundation::sched::sched_class_id;

    /// @brief Real-time mutex with multi-link priority inheritance.
    ///
    /// @details Locks are acquired in waiter→owner order along the PI
    ///          chain so there is no cycle in the @c m_pi_lock graph.
    ///          The chain walk is bounded by @c MAX_PI_DEPTH and by the
    ///          DGP cross-domain gate, both at insertion (slow_lock) and at
    ///          release (unlock, top-waiter change).
    class rt_mutex {
        atomic<u32>             m_lock_word{0}; ///< 0 = free, 1 = held.
        locking::qspinlock::qspinlock m_pi_lock{}; ///< Protects m_owner, m_waiters, and serializes the chain walk.
        strand*                 m_owner{nullptr};
        lib::list_head          m_waiters{};

    public:
        constexpr rt_mutex() noexcept = default;

        rt_mutex(const rt_mutex&)           = delete;
        auto operator=(const rt_mutex&)     = delete;
        rt_mutex(rt_mutex&&)                = delete;
        auto operator=(rt_mutex&&)           = delete;

        /// @brief Acquire the mutex, blocking if held.
        /// @pre  can_sleep() (IRQs enabled, not in IRQ, preemption on).
        auto lock() noexcept -> void {
            zxfoundation::sched::context::assert_can_sleep();
            const irqflags flags = arch::s390x::cpu::irq::irq_save_disable();

            u32 expected = 0U;
            if (m_lock_word.compare_exchange_strong(
                    expected, 1U, memory_order::acquire, memory_order::relaxed)) {
                auto& pcp = arch::s390x::cpu::lowcore::this_cpu_percpu();
                m_owner = reinterpret_cast<strand*>(pcp.current_strand);
                arch::s390x::cpu::irq::irq_restore(flags);
                return;
            }

            slow_lock(flags);
        }

        /// @brief Non-blocking attempt.
        [[nodiscard]] auto try_lock() noexcept -> bool {
            u32 expected = 0U;
            if (m_lock_word.compare_exchange_strong(
                    expected, 1U, memory_order::acquire, memory_order::relaxed)) {
                auto& pcp = arch::s390x::cpu::lowcore::this_cpu_percpu();
                m_owner = reinterpret_cast<strand*>(pcp.current_strand);
                return true;
            }
            return false;
        }

        /// @brief Release the mutex.
        /// @details Pops the highest-priority waiter (if any) and hands
        ///          off ownership, then runs the reverse-direction chain
        ///          walk to undo any boost that was applied to @c old_owner
        ///          and its ancestors.  The reverse walk takes each
        ///          ancestor's m_pi_lock as it ascends.
        auto unlock() noexcept -> void {
            using rt_mutex_detail::top_waiter_prio;
            using rt_mutex_detail::reboost_owner;
            using rt_mutex_detail::pi_may_cross;
            using rt_mutex_detail::effective_rt_prio;
            using rt_mutex_detail::MAX_PI_DEPTH;

            strand* new_owner = nullptr;

            {
                strand* old_owner = nullptr;
                locking::irq_lock_guard pi_guard(m_pi_lock);

                if (!m_waiters.empty()) {
                    lib::list_node* node = *m_waiters.begin();
                    lib::list_head::remove(*node);
                    new_owner = rt_mutex_detail::strand_from_pi_waiters(node);
                    new_owner->body->blocked_on = nullptr;
                }

                old_owner = m_owner;
                m_owner   = new_owner;

                if (old_owner) {
                    zxfoundation::sched::rt::unboost_prio(*old_owner);

                    // Reverse walk up old_owner's blocked_on chain: re-evaluate
                    // its boost based on the mutex it's sleeping on.
                    strand* cur = old_owner;
                    rt_mutex* held_lock = this;  // holds lock on `held_lock` already.
                    for (u32 depth = 0U; depth < MAX_PI_DEPTH; ++depth) {
                        void* blk = cur->body ? cur->body->blocked_on : nullptr;
                        if (!blk) break;
                        auto* next_lock = static_cast<rt_mutex*>(blk);

                        // Lock-ordering invariant: take next_lock BEFORE
                        // releasing held_lock.
                        if (next_lock != held_lock) {
                            next_lock->m_pi_lock.lock();
                        }
                        strand* next_owner = next_lock->m_owner;
                        const u8 tp = top_waiter_prio(next_lock->m_waiters);
                        if (next_owner) {
                            // Re-evaluate boost on next_owner using the
                            // (possibly updated) top-waiter of next_lock.
                            const strand* top = nullptr;
                            if (!next_lock->m_waiters.empty()) {
                                top = rt_mutex_detail::strand_from_pi_waiters(*next_lock->m_waiters.begin());
                            }
                            if (top) reboost_owner(*next_owner, tp, *top);
                        }
                        if (held_lock != next_lock && held_lock != this) {
                            held_lock->m_pi_lock.unlock();
                        }
                        held_lock = next_lock;
                        if (!next_owner || next_owner == cur) break;
                        cur = next_owner;
                    }
                    if (held_lock != this) held_lock->m_pi_lock.unlock();
                }

                m_lock_word.store(0U, memory_order::release);
            }

            if (new_owner) {
                zxfoundation::sched::rt::task_wake_pi(*new_owner);
            }
        }

        [[nodiscard]] auto is_locked() const noexcept -> bool {
            return m_lock_word.load(memory_order::relaxed) != 0U;
        }

    private:
        auto slow_lock(const irqflags flags) noexcept -> void {
            using rt_mutex_detail::effective_rt_prio;
            using rt_mutex_detail::pi_may_cross;
            using rt_mutex_detail::top_waiter_prio;
            using rt_mutex_detail::reboost_owner;
            using rt_mutex_detail::MAX_PI_DEPTH;

            auto& pcp = arch::s390x::cpu::lowcore::this_cpu_percpu();
            auto* self = reinterpret_cast<strand*>(pcp.current_strand);

            for (;;) {
                {
                    locking::irq_lock_guard pi_guard(m_pi_lock);

                    u32 expected = 0U;
                    if (m_lock_word.compare_exchange_strong(
                            expected, 1U, memory_order::acquire, memory_order::relaxed)) {
                        m_owner = self;
                        arch::s390x::cpu::irq::irq_restore(flags);
                        return;
                    }

                    // Self-deadlock: bail (no recursive acquisition).
                    if (m_owner == self) {
                        arch::s390x::cpu::irq::irq_restore(flags);
                        return;
                    }

                    // Insert self into waiter list (priority-ordered, desc).
                    // If already queued (re-loop after wake), keep slot.
                    if (self->body->blocked_on != this) {
                        self->body->blocked_on = this;
                        const u8 my_prio = effective_rt_prio(*self);
                        bool inserted = false;
                        lib::list_node* before_node = nullptr;
                        for (const auto m_waiter : m_waiters) {
                            before_node = m_waiter;
                            auto* ws = rt_mutex_detail::strand_from_pi_waiters(before_node);
                            if (effective_rt_prio(*ws) < my_prio) {
                                m_waiters.insert_before(*before_node, self->body->pi_waiters);
                                inserted = true;
                                break;
                            }
                        }
                        if (!inserted) {
                            m_waiters.push_back(self->body->pi_waiters);
                        }
                    }

                    // Forward chain walk: boost upwards while allowed by DGP.
                    strand* cur = m_owner;
                    auto held_lock = this; // we already hold this->m_pi_lock.
                    const strand* waiter_for_gate = self;
                    u8 propagate_prio = effective_rt_prio(*self);
                    for (u32 depth = 0U; depth < MAX_PI_DEPTH; ++depth) {
                        if (!cur) break;
                        if (!pi_may_cross(*waiter_for_gate, *cur)) break;
                        zxfoundation::sched::rt::boost_prio(*cur, propagate_prio);
                        void* blk = cur->body ? cur->body->blocked_on : nullptr;
                        if (!blk) break;
                        auto* next_lock = static_cast<rt_mutex*>(blk);
                        // Lock-ordering: acquire next BEFORE releasing current.
                        if (next_lock != held_lock) {
                            next_lock->m_pi_lock.lock();
                        }
                        strand* next_owner = next_lock->m_owner;
                        const u8 next_top = top_waiter_prio(next_lock->m_waiters);
                        if (next_top > propagate_prio) propagate_prio = next_top;
                        waiter_for_gate = cur;
                        if (held_lock != this) held_lock->m_pi_lock.unlock();
                        held_lock = next_lock;
                        if (!next_owner || next_owner == cur) break;
                        cur = next_owner;
                    }
                    if (held_lock != this) held_lock->m_pi_lock.unlock();
                }

                // Block and yield.  When woken, handoff may have occurred.
                if (self->on_rq) {
                    zxfoundation::sched::dequeue_strand(self);
                }
                self->substate = sched_substate::blocked;
                zxfoundation::sched::schedule();

                // After wake: check whether we now own the mutex.
                locking::irq_lock_guard pi_guard(m_pi_lock);
                if (m_owner == self) {
                    arch::s390x::cpu::irq::irq_restore(flags);
                    return;
                }
            }
        }
    };

    static_assert(sizeof(rt_mutex) <= 64U,
        "rt_mutex should fit in a single cache line for cheap PI-locking");

} // namespace zxfoundation::locking::rt_mutex

} // end export
