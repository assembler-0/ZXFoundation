/// @file mcs_types.cxxm
/// @brief mcs types

export module zxfoundation.locking.mcs_types;
import std;

export {

namespace zxfoundation::locking::mcs {

    /// @brief Maximum MCS spinlock nesting depth.
    constexpr auto MCS_MAX_LOCK_DEPTH = 4U;

    /// @brief MCS node for queued spinlocks.
    struct mcs_node {
        std::atomic<mcs_node*> next{nullptr};
        std::atomic<int>       locked{0};
    };

} // namespace zxfoundation::locking::mcs

} // end export