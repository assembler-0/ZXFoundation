/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sync/qspinlock.zcomponent/mcs.cxxm
/// @brief mcs types

export module zxfoundation.sync.qspinlock.mcs;
import lib.stl;

export {

namespace zxfoundation::sync::qspinlock {

    /// @brief Maximum MCS spinlock nesting depth.
    constexpr auto MCS_MAX_LOCK_DEPTH = 16U;

    /// @brief MCS node for queued spinlocks.
    struct alignas(256) mcs_node {
        std::atomic<mcs_node*> next{nullptr};
        std::atomic<int>       locked{0};
    };

    static_assert(sizeof(mcs_node) == 256U,
        "MCS node must occupy exactly one z/Architecture cache line");

} // namespace zxfoundation::sync::qspinlock

} // end export
