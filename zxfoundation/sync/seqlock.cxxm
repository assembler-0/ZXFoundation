/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sync/seqlock.cxxm
/// @brief Sequence lock for read-heavy, write-rare shared data.

export module zxfoundation.sync.seqlock;
import zxfoundation.base.types;
import zxfoundation.sync.qspinlock.core;
import arch.s390x.cpu.irq;
import arch.s390x.cpu.sync;
import lib.stl;

export {

namespace zxfoundation::sync {

    template<typename T>
        requires std::is_trivially_copyable_v<T>
    class seqlock {
        mutable std::atomic<u64> m_seq{0};
        T                        m_val{};
        qspinlock::qspinlock<lock_rank::seqlock_writer>     m_writer{};

    public:
        constexpr seqlock() noexcept = default;

        constexpr explicit seqlock(const T& initial) noexcept
            : m_seq{0}, m_val{initial} {}

        seqlock(const seqlock&)        = delete;
        seqlock(seqlock&&)             = delete;
        auto operator=(const seqlock&) = delete;
        auto operator=(seqlock&&)      = delete;

        /// @brief Write a new value.
        /// @note  Readers are never blocked; they retry transparently.
        auto write(const T& val) noexcept -> void {
            const auto flags = arch::s390x::cpu::irq::irq_save_disable();
            m_writer.lock();
            const u64 seq = m_seq.load(std::memory_order::relaxed);
            m_seq.store(seq + 1U, std::memory_order::release);  // odd: write in progress
            T copy = val;
            __atomic_store(&m_val, &copy, static_cast<int>(std::memory_order::release));
            m_seq.store(seq + 2U, std::memory_order::release);  // even: write complete
            m_writer.unlock();
            arch::s390x::cpu::irq::irq_restore(flags);
        }

        /// @brief Begin an explicit read-side sequence.
        [[nodiscard]] auto read_begin() const noexcept -> u64 {
            for (;;) {
                const u64 seq = m_seq.load(std::memory_order::acquire);
                if ((seq & 1U) == 0U) return seq;
                arch::s390x::cpu::sync::cpu_relax();
            }
        }

        /// @brief Test whether a read-side sequence was invalidated.
        [[nodiscard]] auto read_retry(const u64 seq) const noexcept -> bool {
            arch::s390x::cpu::sync::barrier();
            return m_seq.load(std::memory_order::acquire) != seq;
        }

        /// @brief Read the current value. Lock-free; retries on torn read.
        [[nodiscard]] auto read() const noexcept -> T {
            while (true) {
                const u64 s1 = read_begin();
                T v{};
                __atomic_load(&m_val, &v, static_cast<int>(std::memory_order::acquire));
                if (!read_retry(s1)) [[likely]] return v;
                arch::s390x::cpu::sync::cpu_relax();
            }
        }

        /// @brief Return the sequence counter (diagnostic).
        [[nodiscard]] auto sequence() const noexcept -> u64 {
            return m_seq.load(std::memory_order::relaxed);
        }
    };

} // namespace zxfoundation::sync

} // end export
