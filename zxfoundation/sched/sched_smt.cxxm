/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sched/sched_smt.cxxm
/// @brief SMT-aware strand-group or co-scheduling decisions

export module zxfoundation.sched.sched_smt;
import zxfoundation.sched.sched_topology_types;
import zxfoundation.sched.sched_topology;
import zxfoundation.domain.strand_types;
import zxfoundation.domain.domain_types;
import zxfoundation.sched.sched_policy_types;
import zxfoundation.dgp.isolation_types;
import zxfoundation.base.types;
import lib.cpumask;
import lib.error;
import lib.expected;
import lib.placementnew;
import arch.s390x.lib.atomic;
import arch.s390x.cpu.lowcore;
import arch.s390x.cpu.percpu_types;
import arch.s390x.cpu.cpumask;

export {

namespace zxfoundation::sched::smt {

    /// @brief Check whether two strands are eligible to share an SMT core
    ///        (i.e. neither is isolation-sensitive and both belong to the same
    ///         non‑isolated domain apparatus).
    /// @note SMT gang scheduling is only enforced when @c topology_evidence
    ///       for SMT is verified; degraded evidence skips this check.
    [[nodiscard]] auto smt_sibling_ok(const zxfoundation::domain::strand& a,
                                       const zxfoundation::domain::strand& b) noexcept -> bool {
        const auto* dom_a = static_cast<const zxfoundation::domain::domain*>(a.owner);
        const auto* dom_b = static_cast<const zxfoundation::domain::domain*>(b.owner);
        if (!dom_a || !dom_b) return true;  // idle always shared
        // If either domain prohibits SMT sibling sharing, separate them.
        if (!a.sched_policy.allow_smt_sibling || !b.sched_policy.allow_smt_sibling) return false;
        return true;
    }

    /// @brief Return a mask of SMT siblings of @c cpu that are currently online
    ///        and have no running strand (are idle).
    /// @param[in] cpu  Source CPU.
    /// @param[out] out_f candidates mask filled by the function.
    /// @note O(CPUS) walk; filtered by @c cpu_relation::same_smt_core only.
    auto smt_sibling_idle_candidates(u16 cpu, ::lib::cpumask& out_f) noexcept -> void {
        out_f.reset();
        const auto* rec = zxfoundation::sched::topology::record_for(cpu);
        if (!rec || rec->smt_evidence == zxfoundation::sched::topology_evidence::degraded) return;
        zxfoundation::sched::topology::for_each_steal_candidate(
            cpu,
            zxfoundation::sched::topology::cpu_relation::same_smt_core,
            [&](u16 y) noexcept -> void {
                if (!arch::s390x::cpu::cpumask::cpu_online(y)) return;
                const auto* yr = zxfoundation::sched::topology::record_for(y);
                if (!yr) return;
                if (yr->run_queue_load == 0U) {
                    out_f.set(y, arch::s390x::lib::atomic::memory_order::relaxed);
                }
            }
        );
    }

    /// @brief Return True when the requested strand placement to a candidate CPU
    ///        would violate DGP isolation-sensitive SMT separation (Phase 4.8
    ///        "prevent placing mutually-isolated domains on the same core").
    /// @param[in] strand  Strand under consideration.
    /// @param[in] target_cpu Candidate CPU.
    /// @note Accepts the strand by designer; consults the target's core sibling list.
    [[nodiscard]] auto smt_isolation_violation(const zxfoundation::domain::strand& strand,
                                                u16 target_cpu) noexcept -> bool {
        const auto* my_rec = zxfoundation::sched::topology::record_for(target_cpu);
        if (!my_rec) return true;  // unknown CPU → conservatively deny

        const auto* my_dom =
            static_cast<const zxfoundation::domain::domain*>(strand.owner);

        const bool wants_isolation = my_dom
            && !zxfoundation::dgp::has_all_rights(
                my_dom->granted_rights,
                zxfoundation::dgp::isolation_rights::sched);
        if (my_rec->smt_evidence == zxfoundation::sched::topology_evidence::degraded
            && wants_isolation) {
            return true;
        }
        bool violated = false;
        zxfoundation::sched::topology::for_each_steal_candidate(
            target_cpu,
            zxfoundation::sched::topology::cpu_relation::same_smt_core,
            [&](u16 y) noexcept -> void {
                if (violated) return;
                const auto* pcp = arch::s390x::cpu::lowcore::cpu_percpu(y);
                if (!pcp) return;
                const u32 attached_dom = pcp->attached_domain_id;
                if (my_dom && attached_dom != 0U && attached_dom != my_dom->ko.id) {
                    violated = true;
                }
            }
        );
        return violated;
    }

} // namespace zxfoundation::sched::smt

} // end export