/// @file zxfoundation/sched/sched_fair.cxxm
/// @brief EEVDF (Earliest Eligible Virtual Deadline First) scheduling class.

export module zxfoundation.sched.sched_fair;
import zxfoundation.sched.sched_entity_types;
import zxfoundation.sched.sched_eevdf;
import zxfoundation.sched.sched_smt;
import zxfoundation.domain.domain_types;
import zxfoundation.domain.strand_types;
import zxfoundation.base.types;
import lib.rbtree;
import lib.error;
import lib.container_of;
import std;

export {

namespace zxfoundation::sched::fair {

    using zxfoundation::domain::domain;
    using zxfoundation::domain::domain_flags;
    using zxfoundation::domain::run_queue;
    using zxfoundation::domain::sched_class;
    using zxfoundation::domain::strand;
    using zxfoundation::sched::sched_entity;

    inline constexpr u64 EEVDF_DEFAULT_SLICE = 40'960'000ULL;

    [[nodiscard]] inline auto rb_node_to_strand(lib::rb_node* node) noexcept -> strand* {
        return lib::container_of_anchor<strand, sched_entity, lib::rb_node,
                                         &strand::se, &sched_entity::fair_node>(node);
    }

    class fair_iterator {
    public:
        explicit fair_iterator(lib::rb_node* n) noexcept
            : current_{n}, next_{n ? lib::rb_next(n) : nullptr} {}

        [[nodiscard]] auto operator*()  const noexcept -> strand& { return *rb_node_to_strand(current_); }
        [[nodiscard]] auto operator->() const noexcept -> strand* { return  rb_node_to_strand(current_); }

        auto operator++() noexcept -> fair_iterator& {
            current_ = next_;
            next_    = current_ ? lib::rb_next(current_) : nullptr;
            return *this;
        }
        auto operator++(int) noexcept -> fair_iterator {
            auto tmp = *this; ++(*this); return tmp;
        }

        [[nodiscard]] friend auto operator==(const fair_iterator& a, const fair_iterator& b) noexcept -> bool {
            return a.current_ == b.current_;
        }

    private:
        lib::rb_node* current_{nullptr};
        lib::rb_node* next_{nullptr};
    };

    class fair_range {
    public:
        explicit fair_range(const run_queue& rq) noexcept
            : first_{const_cast<lib::rb_node*>(rq.fair_tree.leftmost)} {}

        [[nodiscard]] auto begin() const noexcept -> fair_iterator { return fair_iterator{first_}; }
        [[nodiscard]] auto end()   const noexcept -> fair_iterator { return fair_iterator{nullptr}; }
    private:
        lib::rb_node* first_;
    };

    /// @brief Range-for adapter for CFS fair tree traversal.
    [[nodiscard]] inline auto iter(const run_queue& rq) noexcept -> fair_range { return fair_range{rq}; }

    /// @brief Enqueue a strand into the CFS fair scheduling tree.
    /// @param[in,out] rq Run queue (caller holds @c rq.lock).
    /// @param[in,out] s  Strand being enqueued.
    /// @return Success, or @c kernel_error when SMT isolation-sensitive
    ///         placement is violated on the target CPU.
    /// @note Phase 4.8 wiring: fair-class strands with @c sched_policy.allow_smt_sibling = false
    ///       SKIP this CPU when an SMT sibling is already running a different
    ///       isolation-sensitive DGP domain.
    [[nodiscard]] inline auto enqueue(run_queue& rq, strand& s) noexcept -> std::expected<void, lib::kernel_error> {
        if (!s.sched_policy.allow_smt_sibling
            && zxfoundation::sched::smt::smt_isolation_violation(s, rq.cpu_id)) {
            return std::unexpected(lib::kernel_error::from_generic(lib::generic_error::invalid_arg));
        }
        if (s.se.deadline == 0) {
            s.se.vruntime = rq.min_vruntime;
            s.se.slice    = EEVDF_DEFAULT_SLICE;
            s.se.deadline = s.se.vruntime +
                (s.se.slice * 1024 / s.se.weight);
        }

        lib::rb_node** link = &rq.fair_tree.root.node;
        lib::rb_node*  parent = nullptr;
        bool leftmost = true;

        while (*link) {
            parent = *link;
            auto* existing = rb_node_to_strand(parent);
            if (s.se.deadline < existing->se.deadline) {
                link = &parent->left;
            } else {
                link = &parent->right;
                leftmost = false;
            }
        }
        lib::rb_link_node(&s.se.fair_node, parent, link);
        lib::rb_insert_color_cached(&s.se.fair_node, rq.fair_tree, leftmost);

        s.on_rq = true;
        ++rq.nr_running;
        return {};
    }

    inline auto dequeue(run_queue& rq, strand& s) noexcept -> void {
        if (!s.on_rq) return;
        lib::rb_erase_cached(&s.se.fair_node, rq.fair_tree);
        s.on_rq = false;
        --rq.nr_running;
    }

    [[nodiscard]] inline auto pick_next(run_queue& rq) noexcept -> strand* {
        auto* rb_left = rq.fair_tree.leftmost;
        if (!rb_left) return nullptr;

        auto* node = rb_left;
        while (node) {
            auto* s = rb_node_to_strand(node);
            const bool eligible = rq.min_vruntime >= s->se.vruntime ||
                                  (rq.min_vruntime + (1ULL << 63)) < (s->se.vruntime + (1ULL << 63));
            s->se.lag = eligible ? 0 : -1;

            if (eligible) {
                return s;
            }
            node = lib::rb_next(node);
        }

        return rb_node_to_strand(rb_left);
    }

    /// @brief Reference Linux EEVDF calc_delta_fair
    [[nodiscard]] inline auto calc_weighted_delta(u64 delta_exec, u32 weight) noexcept -> u64 {
        if (weight == 0U) return delta_exec;
        constexpr u64 NICE_0_LOAD = 1024ULL;
        const u128 num = static_cast<u128>(delta_exec) * static_cast<u128>(NICE_0_LOAD);
        const u128 den = static_cast<u128>(weight);
        return static_cast<u64>(num / den);
    }

    inline auto tick(run_queue& rq, strand& s) noexcept -> void {
        const u64 delta = EEVDF_DEFAULT_SLICE;
        const u64 weighted_delta = calc_weighted_delta(delta, s.se.weight);
        s.se.vruntime += weighted_delta;

        if (s.se.vruntime > rq.min_vruntime)
            rq.min_vruntime = s.se.vruntime;

        if (s.se.vruntime >= s.se.deadline) {
            auto* owner = static_cast<domain*>(s.owner);
            owner->flags |= domain_flags::need_resched;
            s.se.deadline = s.se.vruntime +
                calc_weighted_delta(s.se.slice, s.se.weight);
        }
    }

    inline auto preempt(run_queue& rq, strand& waking) noexcept -> void {
        if (!rq.curr) return;
        if (waking.se.deadline < rq.curr->se.deadline) {
            auto* owner = static_cast<domain*>(rq.curr->owner);
            owner->flags |= domain_flags::need_resched;
        }
    }

    /// @brief Legacy vtable shim — strips the scheduler-class error result so
    ///        that @c sched_class::enqueue_strand (a @c void fn-ptr) still
    ///        type-matches.  Direct callers should use @c enqueue (returning
    ///        @c expected) instead of routing through @c the_class.
    inline auto vtable_enqueue(run_queue& rq, strand& s) noexcept -> void {
        discard_value enqueue(rq, s);
    }

    inline constexpr sched_class the_class{
        vtable_enqueue, dequeue, pick_next, tick, preempt
    };

} // namespace zxfoundation::sched::fair

} // end export