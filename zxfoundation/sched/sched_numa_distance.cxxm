/// @file zxfoundation/sched/sched_numa_distance.cxxm
/// @brief STSI 15.1.x topology-list probe — feeds PMM's single-source SLIT.

export module zxfoundation.sched.sched_numa_distance;
import zxfoundation.sched.sched_topology_types;
import zxfoundation.sched.sched_topology;
import zxfoundation.memory.numa_types;
import zxfoundation.memory.numa;
import zxfoundation.base.types;
import zxfoundation.base.config;
import lib.cpumask;
import lib.util;
import lib.algorithm;
import lib.error;
import lib.expected;
import arch.s390x.cpu.stsi;
import arch.s390x.cpu.stsi_types;
import arch.s390x.lib.atomic;
import arch.s390x.cpu.cpumask;
import arch.s390x.cpu.lowcore;
import arch.s390x.cpu.percpu_types;
import zxfoundation.sys.syschk;

namespace _internal {

    using namespace zxfoundation::memory::numa;

    /// @brief Per-CPU NUMA node assignment cached for fast topology lookups.
    u8 g_stsi_cpu_to_node[zxfoundation::base::config::CONFIG_ZX_MAX_CPUS]{};

    /// @brief Build a synthetic 16×16 SLIT using @c cpu_relation placement tiers.
    auto build_synthetic_slit_to(slit_matrix& out) noexcept -> void {
        for (u32 a = 0; a < MAX_NUMA_NODES; ++a) {
            for (u32 b = 0; b < MAX_NUMA_NODES; ++b) {
                if (a == b) out.distances[a][b] = 10U;
                else if (a == NUMA_NODE_BOOT || b == NUMA_NODE_BOOT) out.distances[a][b] = 20U;
                else out.distances[a][b] = 40U;
            }
        }
        const auto max_cpus = zxfoundation::base::config::CONFIG_ZX_MAX_CPUS;
        for (u32 i = 0; i < max_cpus; ++i) {
            const auto* rec = zxfoundation::sched::topology::record_for(static_cast<u16>(i));
            if (!rec) {
                g_stsi_cpu_to_node[i] = NUMA_NODE_BOOT;
                continue;
            }
            g_stsi_cpu_to_node[i] = (rec->numa_node < MAX_NUMA_NODES) ? rec->numa_node : NUMA_NODE_BOOT;
        }
    }

    /// @brief Parse one STSI 15.1.x output block into the staging SLIT matrix.
    /// @details Walks the @c sysinfo_15_1_x TLE chain.  Container TLEs
    ///          push their container id onto a nesting-depth stack;
    ///          Core TLEs assign the CPUs specified in their 64-bit mask
    ///          to the NUMA node derived from the outer-most container id.
    auto parse_stsi_15_x_block(
        arch::s390x::cpu::stsi::sysinfo_15_1_x* info,
        u32 length,
        slit_matrix& out_matrix,
        bool& wrote_node
    ) noexcept -> void {
        if (info == nullptr || length < sizeof(*info)) return;
        auto* cur = reinterpret_cast<unsigned char*>(&info->tle[0]);
        auto* end = reinterpret_cast<unsigned char*>(info) + length;

        u8 container_id_stack[arch::s390x::cpu::stsi::TOPOLOGY_NR_MAG];
        u32 stack_top = 0U;

        while (cur < end) {
            auto* ent = reinterpret_cast<arch::s390x::cpu::stsi::topology_entry*>(cur);
            const u8 nl = ent->nl;

            if (nl < arch::s390x::cpu::stsi::TOPOLOGY_NR_MAG - 1U) {
                if (stack_top < arch::s390x::cpu::stsi::TOPOLOGY_NR_MAG) {
                    container_id_stack[stack_top++] = ent->container.id;
                }
                cur += sizeof(arch::s390x::cpu::stsi::topology_container);
                continue;
            }
            // Core TLE.
            if (cur + sizeof(ent->cpu) <= end) {
                u8 node_id = (stack_top > 0) ? container_id_stack[0] : 0U;
                if (node_id >= MAX_NUMA_NODES) node_id = NUMA_NODE_BOOT;
                for (u32 bit = 0; bit < 64U; ++bit) {
                    const u64 b = (ent->cpu.mask >> bit) & 1ULL;
                    if (b != 0ULL) {
                        if (bit < zxfoundation::base::config::CONFIG_ZX_MAX_CPUS) {
                            g_stsi_cpu_to_node[bit] = node_id;
                            wrote_node = true;
                        }
                    }
                }
                cur += sizeof(ent->cpu);
            } else {
                break;
            }
        }

        for (u32 a = 0; a < MAX_NUMA_NODES; ++a) {
            for (u32 b = 0; b < MAX_NUMA_NODES; ++b) {
                if (a == b)            out_matrix.distances[a][b] = 10U;
                else if (a == 0 || b == 0) out_matrix.distances[a][b] = 20U;
                else                   out_matrix.distances[a][b] = 40U;
            }
        }
    }

    /// @brief Probe STSI 15.1.x (information on machine topology nesting
    ///        levels 1..3) by issuing @c stsi(buf, 15, 1, sel2).
    /// @return True on success (CC=0); false on CC=3 (not available).
    auto probe_stsi_15_1_x(
        u32 sel2,
        slit_matrix& out_matrix,
        bool& wrote_node
    ) noexcept -> bool {
        alignas(8) u8 buffer[4096];
        auto* info = reinterpret_cast<arch::s390x::cpu::stsi::sysinfo_15_1_x*>(buffer);
        const auto r = arch::s390x::cpu::stsi::stsi_issue(buffer, 15, 1, static_cast<int>(sel2));
        if (!r) return false;
        if (*r == 3) return false;   // CC=3 → not available
        const u32 length = static_cast<u32>(info->length);
        if (length == 0U || length > sizeof(buffer)) return false;
        parse_stsi_15_x_block(info, length, out_matrix, wrote_node);
        return true;
    }

} // namespace _internal

export {

namespace zxfoundation::sched::numa_distance {

    /// @brief Probe STSI 15.1.x and install the resulting SLIT into PMM.
    auto slit_load() noexcept -> void {
        for (u8& i : _internal::g_stsi_cpu_to_node) {
            i = zxfoundation::memory::numa::NUMA_NODE_BOOT;
        }
        _internal::slit_matrix matrix{};
        bool stsi_ok = false;
        bool wrote_node = false;
        for (u32 sel2 = 1; sel2 <= 3; ++sel2) {
            if (_internal::probe_stsi_15_1_x(sel2, matrix, wrote_node)) {
                stsi_ok = true;
            }
        }
        if (!stsi_ok) {
            _internal::build_synthetic_slit_to(matrix);
        }
        zxfoundation::memory::numa::slit_install(
            matrix,
            stsi_ok && wrote_node);
    }

    /// @brief Read NUMA distance between two nodes.
    /// @param[in] node_a Source node id.
    /// @param[in] node_b Destination node id.
    /// @return Distance (10..255), or 255 (max) when either id is out of range.
    /// @note Thin reader-only re-export that delegates to the single
    ///       source of truth in @c zxfoundation::memory::numa.  Callers in
    ///       the scheduler namespace are encouraged to keep using this name;
    ///       new code should call the PMM NUMA API directly.
    [[nodiscard]] auto numa_distance(u8 node_a, u8 node_b) noexcept -> u8 {
        return zxfoundation::memory::numa::numa_distance(node_a, node_b);
    }

    /// @brief Return the NUMA node id assigned to a logical CPU.
    /// @param[in] cpu Logical CPU id.
    /// @note Thin re-export of @c zxfoundation::memory::numa::numa_node_of_cpu.
    [[nodiscard]] auto numa_node_of(u16 cpu) noexcept -> u8 {
        return zxfoundation::memory::numa::numa_node_of_cpu(cpu);
    }

    /// @brief Distance between two logical CPUs via their NUMA nodes.
    /// @note Thin re-export of @c zxfoundation::memory::numa::cpu_distance.
    [[nodiscard]] auto cpu_distance(u16 cpu_a, u16 cpu_b) noexcept -> u8 {
        return zxfoundation::memory::numa::cpu_distance(cpu_a, cpu_b);
    }

    /// @brief Diagnostics: report the SLIT table source held in PMM NUMA.
    /// @return 0 = uninitialized, 1 = STSI 15.1.x, 2 = synthetic, 3 = degraded.
    [[nodiscard]] auto slit_source_kind() noexcept -> u32 {
        return zxfoundation::memory::numa::slit_source_kind();
    }

} // namespace zxfoundation::sched::numa_distance

} // end export
