/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sched/sched_pelt.cxxm
/// @brief Per-Entity Load Tracking (PELT) — decayed-load averaging.

export module zxfoundation.sched.sched_pelt;
import zxfoundation.sched.sched_entity_types;
import zxfoundation.base.types;

namespace _internal {

    using namespace zxfoundation::sched;

    /// @brief PELT period in nanoseconds (1 ms).
    inline constexpr u64 PELT_PERIOD_NS = 1'000'000ULL;

    /// @brief Half-life in periods — contribution halves over this many periods.
    inline constexpr u64 PELT_HALF_LIFE = 32ULL;

    /// @brief Maximum representable sum (LOAD_AVG_MAX in the Linux analogue).
    inline constexpr u64 LOAD_AVG_MAX = 47742ULL * 1024ULL;

    /// @brief LOAD_AVG_MAX - N (residual, mirrors Linux pelt.c LOAD_AVG_MAX - 1024).
    inline constexpr u64 LOAD_AVG_MAX_N = LOAD_AVG_MAX - 1024ULL;

    /// @brief Tiny sum representing the contributions after >4571 periods of decay.
    inline constexpr u64 LOAD_AVG_MIN = 1024ULL;

    /// @brief y^n pre-computed in Q.32 fixed-point for n in [0..39], sufficient
    ///        for sub-period decay within a single accumulate_sum call.
    ///        Values: y_q32[n] = round(2^32 * 2^(-n/32)).
    constexpr u64 DECAY_Q32_TABLE[40] = {
        0x100000000ULL,
        0x0Fa83FF2C61FA6C9ULL,
        0x0F5257D048F8406AULL,
        0x0EFC8B6E54DA5527ULL,
        0x0EA83A1C0B5C8C8A7ULL,
        0x0E519193D66D53368ULL,
        0x0DFD3A11CE5A836BULL,
        0x0DAE2B6CF3793B27ULL,
        0x0D588E68CFB9FB5A8ULL,
        0x0D0A4E4B6E9D5B7C3ULL,
        0x0CBCC2FA8D7F84A09ULL,
        0x0C6EF15B6B1A4DA7BULL,
        0x0C21AF6A2E0F2A0EULL,
        0x0BD456B53ED8D6FB5ULL,
        0x0B86E4B8B0EE1D40FULL,
        0x0B37AF9D67A8B4FA0ULL,
        0x0AE14C3E9DE7E7FE3ULL,
        0x0A8C08A6E3F25B5D2ULL,
        0x0A360D5B5B7FF4ED7ULL,
        0x09E103C6D3D5F1A02ULL,
        0x098EE0DBE5CB9C08ULL,
        0x093B41DE29D85CD0ULL,
        0x08E6F1D2B9F6B5F5ULL,
        0x089B2C8E5B5D9C8DULL,
        0x085BB4E6B5EB4DAAULL,
        0x0808FFA6F25EF0AAULL,
        0x07C362D0CF46FC99ULL,
        0x077D69F32E2B59EDULL,
        0x07393C56BF30B26FULL,
        0x06F2F1B5ABC4C7B1ULL,
        0x06B0842A77C5ACF9ULL,
        0x066CD0D2E5B7E4A8ULL,
        0x062A35F8B126B2C7ULL,
        0x05E785FA2DCE7DC0ULL,
        0x05A80E18E1DD1FACULL,
        0x0569C9B1F97CD9E1ULL,
        0x052B593E8B00C849ULL,
        0x04EDF8D29DAF6F0EULL,
        0x04B07EC9F0B2440EULL,
        0x0473F23B5C2D80E1ULL,
    };
    static_assert(DECAY_Q32_TABLE[0] == (1ULL << 32), "decay table[0] must be 1.0 in Q.32");
    static_assert(DECAY_Q32_TABLE[32] != 0, "decay table must cover 32+ sub-periods");

    /// @brief Multiply two Q.32 values, returning a Q.64 product.
    /// @note This is the binary-keyed form: we use 128-bit intermediate
    ///       arithmetic from the project's @c u128 / @c i128 aliases.
    [[nodiscard]] inline auto mul_q32(u64 a, u64 b) noexcept -> u64 {
        const u128 product = static_cast<u128>(a) * static_cast<u128>(b);
        return static_cast<u64>(product >> 32);
    }

    /// @brief 2^(1/32) lookup in Q.32 — used to project decay across 1..39
    ///        sub-periods at a time.
    [[nodiscard]] inline auto y_n(u32 n) noexcept -> u64 {
        if (n >= 40U) return 0ULL;
        return DECAY_Q32_TABLE[n];
    }

} // namespace _internal

export {

namespace zxfoundation::sched::pelt {

    using namespace zxfoundation::sched;

    /// @brief PELT period in nanoseconds (1 ms).
    inline constexpr u64 PELT_PERIOD_NS = _internal::PELT_PERIOD_NS;
    /// @brief Half-life in periods.
    inline constexpr u64 PELT_HALF_LIFE = _internal::PELT_HALF_LIFE;
    /// @brief Maximum possible value of @c sched_avg::load_sum and friends.
    inline constexpr u64 LOAD_AVG_MAX = _internal::LOAD_AVG_MAX;

    /// @brief Decay a load value by @c n full periods.
    /// @param[in] value  Current value in 1024-unit rolling sum.
    /// @param[in] periods Number of full PELT periods to decay.
    /// @return The decayed value, saturating to zero.
    /// @note Algorithm mirrors Linux's @c __decay_load: for each batch of
    ///       32 periods, halve the value; for the residual sub-32 periods
    ///       multiply by the pre-computed y^n fixed-point factor.
    [[nodiscard]] inline auto decay_load(u64 value, u64 periods) noexcept -> u64 {
        if (value == 0U || periods == 0U) return value;
        if (periods >= PELT_HALF_LIFE * 22ULL) return 0U;  // saturation bound
        // Halve for each batch of 32 periods; mirror Linux's exact folding.
        u32 n32 = static_cast<u32>(periods >> 5U);     // number of full 32-period batches
        u32 d  = static_cast<u32>(periods & 31U);      // residual sub-32 periods
        if (n32 >= 64U) return 0U;                     // beyond 2^64 halvings
        if (n32 > 0U) {
            if (n32 >= 64U) return 0ULL;
            value >>= n32;
        }
        if (d == 0U) return value;
        const u64 yf = _internal::y_n(d);
        // value = value * (yf / 2^32) using Q.32 multiplication.
        const u128 product = static_cast<u128>(value) * static_cast<u128>(yf);
        return static_cast<u64>(product >> 32);
    }

    /// @brief Accumulate a signed-delta running contribution into a PELT
    ///        averaging record, advancing by zero or more full periods.
    /// @param[in]     delta_ns  Elapsed time since the prior update (in ns).
    /// @param[in,out] sa        Averaging record (mutable).
    /// @param[in]     load      Load contribution (0 or se->weight average).
    /// @param[in]     runnable  Runnable mask (1 if runnable, 0 if blocked).
    /// @param[in]     running   Running mask (1 if on CPU, 0 if not).
    /// @return 1 when the averaging record was updated, 0 when delta=0 or
    ///         nothing changed.
    auto accumulate_sum(u64 delta_ns, sched_avg& sa, u32 load,
                        u32 runnable, u32 running) noexcept -> u32 {
        if (delta_ns == 0U) return 0U;
        if (delta_ns >= (PELT_HALF_LIFE * 4ULL) * PELT_PERIOD_NS) {
            // More than ~128 ms unaccounted — reset all sums to the current
            // snapshot to mirror Linux's "first sample" behaviour.
            sa.load_sum = load;
            sa.runnable_sum = runnable;
            sa.util_sum = running;
            sa.period_contrib_ns = 0U;
            sa.last_update_time_ns += delta_ns;
            return 1U;
        }
        u64 periods = delta_ns / PELT_PERIOD_NS;
        u64 residual = delta_ns % PELT_PERIOD_NS;
        if (periods > 0U) {
            sa.load_sum = decay_load(sa.load_sum, periods);
            // runnable and util decay only when the entity is not freshly running.
            if (runnable == 0U) {
                sa.runnable_sum = decay_load(sa.runnable_sum, periods);
            }
            if (running == 0U) {
                sa.util_sum = decay_load(sa.util_sum, periods);
            }
        }
        // New contribution is added in the residual sub-period.
        const u64 contribution = residual * 1024U + (sa.period_contrib_ns * 1024U) / PELT_PERIOD_NS;
        // Apply decay for the new contribution fragment to align with the
        // sub-period start (mirrors the (1024 + d1haz) projection).
        const u32 contrib = static_cast<u32>((contribution * 1024U) >> 10U);
        if (load != 0U)       sa.load_sum      += contrib * load;
        if (runnable != 0U)   sa.runnable_sum   += contrib;
        if (running  != 0U)   sa.util_sum       += contrib;
        sa.period_contrib_ns = residual;
        sa.last_update_time_ns += delta_ns;
        return 1U;
    }

    /// @brief Fold the decayed sums into the public averages.
    /// @param[in,out] sa     Averaging record (mutable).
    /// @param[in]     weight Entity weight (1024 for default nice-0).
    /// @details Following Linux's @c ___update_load_avg, the averages are
    ///          produced by taking the decayed sum, scaling by the weight
    ///          inverse, and dividing by the LOAD_AVG_MAX projection.
    ///          Sauration prevents overflow at the running accumulator head.
    auto update_load_avg(sched_avg& sa, u32 weight) noexcept -> void {
        if (sa.load_sum > LOAD_AVG_MAX)  sa.load_sum = LOAD_AVG_MAX;
        if (sa.runnable_sum > LOAD_AVG_MAX) sa.runnable_sum = LOAD_AVG_MAX;
        if (sa.util_sum > LOAD_AVG_MAX) sa.util_sum = LOAD_AVG_MAX;
        const u32 w = (weight == 0U) ? 1024U : weight;
        // load_avg = DIV64_U64_ROUND_UP(load_sum * w) / LOAD_AVG_MAX
        sa.load_avg = (sa.load_sum * w) / LOAD_AVG_MAX;
        sa.runnable_avg = sa.runnable_sum / LOAD_AVG_MAX;
        sa.util_avg = sa.util_sum / LOAD_AVG_MAX;
    }

    /// @brief Drive a full per-entity PELT update cycle.
    /// @param[in,out] sa      Entity averaging record (mutable).
    /// @param[in]     now_ns  Monotonic timestamp (s_t clock-derived).
    /// @param[in]     weight  Entity weight (1024 for nice 0).
    /// @param[in]     runnable 1 if entity is on a runqueue, 0 otherwise.
    /// @param[in]     running  1 if entity is currently running, 0 otherwise.
    auto update_entity_load_avg(sched_avg& sa, u64 now_ns,
                                u32 weight, u32 runnable, u32 running) noexcept -> void {
        const u64 delta_ns = (now_ns > sa.last_update_time_ns)
            ? (now_ns - sa.last_update_time_ns) : 0U;
        if (delta_ns == 0U) return;
        if (accumulate_sum(delta_ns, sa, weight ? weight : 1024U, runnable, running) != 0U) {
            update_load_avg(sa, weight ? weight : 1024U);
        }
    }

    /// @brief Drive a full per-RQ PELT update cycle for @c sched_avg_rq.
    auto update_rq_load_avg(sched_avg_rq& rq, u64 now_ns, u32 runnable) noexcept -> void {
        const u64 delta_ns = (now_ns > rq.last_update_time_ns)
            ? (now_ns - rq.last_update_time_ns) : 0U;
        if (delta_ns == 0U) return;
        if (delta_ns >= (PELT_HALF_LIFE * 4ULL) * PELT_PERIOD_NS) {
            rq.load_sum = runnable;
            rq.runnable_sum = runnable;
            rq.util_sum = runnable;
            rq.period_contrib_ns = 0U;
            rq.last_update_time_ns += delta_ns;
        } else {
            u64 periods = delta_ns / PELT_PERIOD_NS;
            u64 residual = delta_ns % PELT_PERIOD_NS;
            if (periods > 0U) {
                rq.load_sum = decay_load(rq.load_sum, periods);
                if (runnable == 0U) {
                    rq.runnable_sum = decay_load(rq.runnable_sum, periods);
                    rq.util_sum = decay_load(rq.util_sum, periods);
                }
            }
            const u64 contribution = residual * 1024U + (rq.period_contrib_ns * 1024U) / PELT_PERIOD_NS;
            rq.load_sum += contribution * runnable;
            rq.runnable_sum += contribution * runnable;
            rq.util_sum += contribution * runnable;
            rq.period_contrib_ns = residual;
            rq.last_update_time_ns += delta_ns;
        }
        if (rq.load_sum > LOAD_AVG_MAX) rq.load_sum = LOAD_AVG_MAX;
        if (rq.runnable_sum > LOAD_AVG_MAX) rq.runnable_sum = LOAD_AVG_MAX;
        if (rq.util_sum > LOAD_AVG_MAX) rq.util_sum = LOAD_AVG_MAX;
        rq.load_avg = rq.load_sum / LOAD_AVG_MAX;
        rq.runnable_avg = rq.runnable_sum / LOAD_AVG_MAX;
        rq.util_avg = rq.util_sum / LOAD_AVG_MAX;
    }

} // namespace zxfoundation::sched::pelt

} // end export
