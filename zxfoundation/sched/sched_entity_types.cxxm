/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sched/sched_entity_types.cxxm
/// @brief Schedulable entity carrier

export module zxfoundation.sched.sched_entity_types;
import zxfoundation.base.types;
import lib.rbtree;
import lib.list;
import std;

export {

namespace zxfoundation::sched {

    /// @brief Scheduler class identifier of the entity carrier.
    enum class entity_class : u8 {
        idle    = 0,
        fair    = 1,
        rt      = 2,
        deadline = 3,
    };

    static_assert(sizeof(entity_class) == sizeof(u8),
        "entity_class must remain byte-sized for cache-line packing");

    /// @brief Compact EEVDF scheduling entity carrier embedded in @c strand.
    struct sched_entity {
        u64 vruntime{0};
        u64 deadline{0};
        u64 slice{0};
        i64 lag{0};
        u32 weight{1024U};
        u32 rel_count{0};
        lib::rb_node fair_node{};
    };

    static_assert(sizeof(sched_entity) == 64U,
        "sched_entity must be exactly 64 bytes to preserve strand kstack/ksp offsets");

    /// @brief Per-entity PELT averaging state carried in @c strand_body (cold).
    /// @details 8 u64 fields = 64 B + 4 B u32 `_pad` rounds up to 72 B with
    ///          natural alignment.  s390x L1 cache lines are 256 B, so the
    ///          cold-storage layout has no cache affinity pressure on the
    ///          hot @c sched_entity path.
    struct sched_avg {
        u64 load_sum{0};
        u64 runnable_sum{0};
        u64 util_sum{0};
        u64 load_avg{0};
        u64 runnable_avg{0};
        u64 util_avg{0};
        u64 period_contrib_ns{0};
        u64 last_update_time_ns{0};
        u32 _pad{0};
    };

    static_assert(sizeof(sched_avg) == 72U,
        "sched_avg layout is 8*u64 + 1*u32 + 4B trailing pad = 72 B (s390x align)");

    /// @brief Per-CPU accumulators attached to @c cfs_rq, mirroring Linux's
    ///        @c cfs_rq::avg.  Updated by @c sched_pelt::update_rq_load_avg
    ///        in lock-step with per-entity averaging so the balancer sees
    ///        consistent per-CPU load numbers.
    struct sched_avg_rq {
        u64 load_sum{0};
        u64 runnable_sum{0};
        u64 util_sum{0};
        u64 load_avg{0};
        u64 runnable_avg{0};
        u64 util_avg{0};
        u64 period_contrib_ns{0};
        u64 last_update_time_ns{0};
        u32 nr_running_avg{0};
        u32 _pad{0};
    };

    static_assert(sizeof(sched_avg_rq) == 72U,
        "sched_avg_rq layout is 8*u64 + 2*u32 = 72 B");

    /// @brief Compile-time priority ordering rule asserted at many call sites.
    [[nodiscard]] consteval auto class_rank(entity_class c) noexcept -> u32 {
        return static_cast<u32>(c);
    }

} // namespace zxfoundation::sched

} // end export
