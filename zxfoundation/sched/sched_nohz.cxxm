/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sched/sched_nohz.cxxm
/// @brief Per-CPU tickless (nohz) idle state machine.

export module zxfoundation.sched.sched_nohz;
import zxfoundation.base.types;
import zxfoundation.base.config;
import zxfoundation.sys.timer_types;
import zxfoundation.sys.timer;
import lib.error;
import lib.expected;
import arch.s390x.lib.atomic;
import arch.s390x.cpu.lowcore;
import arch.s390x.cpu.percpu_types;

export {

namespace zxfoundation::sched::nohz {

    /// @brief Flags written into @c run_queue::nohz_flags.
    enum class nohz_flag : u32 {
        tick_stopped        = 1U << 0,   ///< Periodic tick has been removed.
        idle_prepared       = 1U << 1,   ///< CPU has entered nohz-prepare phase.
        nr_balance_pending  = 1U << 2,   ///< nohz kick-balance pin.
    };

    /// @brief Default nohz management callbacks — installed during the
    ///        scheduler init.
    using nohz_fn = auto (*)() noexcept -> void;

    /// @brief Generic per-CPU hook pointers.
    struct nohz_ops {
        nohz_fn   prepare_idle{nullptr};   ///< Call before tick stop.
        nohz_fn   enter_balance{nullptr};  ///< Called on wakeup before tick start.
        nohz_fn   tick_stop{nullptr};       ///< Actually issue the timer_cancel.
        nohz_fn tick_start{nullptr};   ///< Actually re-add the periodic timer.
        void*     context{nullptr};         ///< This CPU's remote context.
    };

    inline auto nohz_flag_mask(nohz_flag f) noexcept -> u32 {
        return static_cast<u32>(f);
    }

    /// @brief Enter nohz idle on the current CPU.
    /// @details Tick-stop only when the CPU has no deferred work pending and
    ///          is in the idle state (nothing runnable).  The caller should
    ///          call @c nohz_prepare_idle before the call.
    auto nohz_idle_enter(u32& nohz_flags, const nohz_ops& ops) noexcept -> void {
        if (ops.prepare_idle != nullptr) ops.prepare_idle();
        const bool already = (nohz_flags & nohz_flag_mask(nohz_flag::tick_stopped)) != 0U;
        if (already) return;
        if (ops.tick_stop != nullptr) ops.tick_stop();
        nohz_flags |= nohz_flag_mask(nohz_flag::tick_stopped);
    }

    /// @brief Exit nohz idle on the current CPU (called on any wakeup).
    /// @param[in,out] nohz_flags Per-CPU flag word.
    /// @param[in]     ops        Operational hooks.
    /// @note Re‑opens the periodic tick timer so scheduler_tick() fires again.
    ///       The @c ops.enter_balance hook is invoked before the tick is
    ///       restarted so the balancer has one pass to pull work from the
    ///       kasarren deriblings that were offline.
    auto nohz_idle_exit(u32& nohz_flags, const nohz_ops& ops) noexcept -> void {
        if (ops.enter_balance != nullptr) ops.enter_balance();
        if (ops.tick_start != nullptr) ops.tick_start();
        nohz_flags &= ~nohz_flag_mask(nohz_flag::tick_stopped);
    }

    /// @brief Test whether the nohz-idle kick is pending on the current CPU.
    [[nodiscard]] auto nohz_balance_pending(u32 nohz_flags) noexcept -> bool {
        return (nohz_flags & nohz_flag_mask(nohz_flag::nr_balance_pending)) != 0U;
    }

    /// @brief Clear the nohz-balance pending flag (committed by the balancer
    ///        on the first pass of the softirq).
    auto nohz_clear_balance(u32& nohz_flags) noexcept -> void {
        nohz_flags &= ~nohz_flag_mask(nohz_flag::nr_balance_pending);
    }

} // namespace zxfoundation::sched::nohz

} // end export