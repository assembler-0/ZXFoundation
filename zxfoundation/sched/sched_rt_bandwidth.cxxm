/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/sched/sched_rt_bandwidth.cxxm
/// @brief Global RT bandwidth controller — sched_rt_period_us + per-CPU runtime
///        enforcement.

export module zxfoundation.sched.sched_rt_bandwidth;
import zxfoundation.sys.timer_types;
import zxfoundation.sys.timer;
import zxfoundation.sys.time;
import arch.s390x.cpu.clock;
import zxfoundation.base.types;
import zxfoundation.base.config;
import lib.error;
import std;

export {

namespace zxfoundation::sched::rt_bw {

    /// @brief System-wide RT bandwidth period (1 000 ms).
    inline constexpr u64 RT_PERIOD_DEFAULT_NS = 1'000'000'000ULL;

    /// @brief Per-CPU RT runtime ceiling per period (950 ms).
    inline constexpr u64 RT_RUNTIME_DEFAULT_NS = 950'000'000ULL;

    /// @brief global sched_rt_period_us
    inline constexpr u64 sched_rt_period_us = RT_PERIOD_DEFAULT_NS / 1000ULL;

    /// @brief global sched_rt_runtime_us
    inline constexpr u64 sched_rt_runtime_us = RT_RUNTIME_DEFAULT_NS / 1000ULL;

    /// @brief Per-CPU RT bandwidth accounting block.
    /// @details Carried inside @c rt_rq.  Owned by the per-CPU @c run_queue.
    struct rt_bandwidth {
        u64                     rt_period_ns{RT_PERIOD_DEFAULT_NS};
        u64                     rt_runtime_ns{RT_RUNTIME_DEFAULT_NS};
        u64                     rt_time_ns{0ULL};
        /// @brief Start-of-period timestamp in monotonic time.
        u64                     rt_period_start_ns{0ULL};
        /// @brief Per-CPU timer handle for period replenishment.
        zxfoundation::sys::timer::kernel_timer  rt_period_timer{};
        bool                    rt_throttled{false};
        u8                      _pad[3]{};
    };

    static_assert(sizeof(rt_bandwidth) <= 96U,
        "rt_bandwidth fits in one cache sector");

    /// @brief Period replenishment: reset the per-CPU RT runtime counter.
    /// @param[in,out] bw Control block (int).
    auto rt_bw_replenish(rt_bandwidth& bw) noexcept -> void {
        bw.rt_time_ns = 0U;
        bw.rt_throttled = false;
        // Note: the period_start is advanced by the timer callback.
    }

    /// @brief Initialize one per-CPU RT bandwidth control block.
    /// @param[in,out] bw   Control block to initialise (on BSP stack).
    /// @param[in] cpu      CPU id.
    auto rt_bw_init(rt_bandwidth& bw, u16 cpu) noexcept -> void {
        bw.rt_period_ns = RT_PERIOD_DEFAULT_NS;
        bw.rt_runtime_ns = RT_RUNTIME_DEFAULT_NS;
        bw.rt_time_ns = 0U;
        bw.rt_period_start_ns = zxfoundation::sys::time::monotonic_now().nanoseconds_since_epoch();
        bw.rt_throttled = false;
        bw.rt_period_timer.deadline_tod =
            arch::s390x::cpu::clock::stck()
            + sys::timer::ns_to_tod(RT_PERIOD_DEFAULT_NS);
        bw.rt_period_timer.interval_tod = sys::timer::ns_to_tod(RT_PERIOD_DEFAULT_NS);
        bw.rt_period_timer.callback = [](void* data) noexcept -> void {
            auto* const p_bw = static_cast<rt_bandwidth*>(data);
            if (!p_bw) return;
            rt_bw_replenish(*p_bw);
            const u64 now_ns = zxfoundation::sys::time::monotonic_now().nanoseconds_since_epoch();
            discard_value now_ns;  // record available for future analytics
        };
        bw.rt_period_timer.data = &bw;
        bw.rt_period_timer.mode = zxfoundation::sys::timer::timer_mode::periodic;
        bw.rt_period_timer.armed = false;
        bw.rt_period_timer.cpu = cpu;
        // Arm the timer now — sched_init / sched_init_ap invoke rt_bw_init
        // before unlocking the RQ so the timer is pinned to this CPU.
        discard_value zxfoundation::sys::timer::timer_add(bw.rt_period_timer);
    }

    /// @brief Assess the RT bandwidth for the current CPU — returns true when
    ///        the per-CPU budget is exhausted and the run queue should be
    ///        throttled.
    /// @param[in,out] bw   Control block (mutated to set throttled).
    /// @param[in]     consumed_ns RT consumption accounting delta (1 tick).
    /// @return True when the CPU is now throttled.
    auto rt_bw_charge(rt_bandwidth& bw, u64 consumed_ns) noexcept -> bool {
        bw.rt_time_ns += consumed_ns;
        if (bw.rt_time_ns >= bw.rt_runtime_ns) {
            bw.rt_throttled = true;
            return true;
        }
        return false;
    }

} // namespace zxfoundation::sched::rt_bw

} // end export