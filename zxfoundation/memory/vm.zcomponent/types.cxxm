/// @file zxfoundation/memory/vm.zcomponent/vm_types.cxxm
/// @brief Virtual Memory Engine — type definitions.

export module zxfoundation.memory.vm.types;
import zxfoundation.base.types;
import zxfoundation.dgp.isolation.types;
import zxfoundation.dgp.memory_contract;
import zxfoundation.sync.rcu.types;
import zxfoundation.scoms.kobject.base;
import zxfoundation.memory.objects;
import zxfoundation.memory.page_cache.types;
import zxfoundation.sync.qspinlock.core;
import lib.rbtree;
import std;
import lib.error;

export {

namespace zxfoundation::memory::vm {

    using std::atomic;
    using std::memory_order;

    /// @brief Page protection flags (combinable).
    enum class vm_prot : u32 {
        none  = 0,
        read  = 1U << 0,
        write = 1U << 1,
        exec  = 1U << 2,
        rw    = read | write,
        rx    = read | exec,
        rwx   = read | write | exec,
    };

    [[nodiscard]] constexpr auto operator|(vm_prot a, vm_prot b) noexcept -> vm_prot {
        return static_cast<vm_prot>(static_cast<u32>(a) | static_cast<u32>(b));
    }
    [[nodiscard]] constexpr auto operator&(vm_prot a, vm_prot b) noexcept -> vm_prot {
        return static_cast<vm_prot>(static_cast<u32>(a) & static_cast<u32>(b));
    }
    [[nodiscard]] constexpr auto operator~(vm_prot f) noexcept -> vm_prot {
        return static_cast<vm_prot>(~static_cast<u32>(f));
    }
    [[nodiscard]] constexpr auto operator!(vm_prot f) noexcept -> bool {
        return static_cast<u32>(f) == 0;
    }
    constexpr auto operator|=(vm_prot& a, vm_prot b) noexcept -> vm_prot& {
        a = a | b;
        return a;
    }
    constexpr auto operator&=(vm_prot& a, vm_prot b) noexcept -> vm_prot& {
        a = a & b;
        return a;
    }

    /// @brief Mapping flags controlling allocation and behavior.
    enum class vm_flags : u32 {
        none      = 0,
        fixed     = 1U << 0,    ///< Map at exact VA.
        anonymous = 1U << 1,    ///< Demand-paged anonymous memory.
        physical  = 1U << 2,    ///< Direct physical backing.
        portal    = 1U << 3,    ///< Shared via portal.
        stack     = 1U << 4,    ///< Stack region (grows downward).
        guard     = 1U << 5,    ///< Guard page (fault = kill/signal).
        pinned    = 1U << 6,    ///< Wired pages (no eviction).
        dma       = 1U << 7,    ///< DMA-eligible mapping.
        no_merge  = 1U << 8,    ///< Never merge with neighbors.
        user      = 1U << 9,    ///< User-space accessible.
        kernel    = 1U << 10,   ///< Kernel-space mapping.
        cow       = 1U << 11,   ///< Copy-on-write mapping.
        file      = 1U << 12,   ///< File-backed mapping.
        ipc       = 1U << 13,   ///< IPC shared-memory mapping.
        hugepage_1m = 1U << 14, ///< Request an EDAT-1 1 MiB mapping.
        hugepage_2g = 1U << 15, ///< Request an EDAT-2 2 GiB mapping.
        shared_read = 1U << 17, ///< Shared read mappings use CoW on write.
    };

    [[nodiscard]] constexpr auto operator|(vm_flags a, vm_flags b) noexcept -> vm_flags {
        return static_cast<vm_flags>(static_cast<u32>(a) | static_cast<u32>(b));
    }
    [[nodiscard]] constexpr auto operator&(vm_flags a, vm_flags b) noexcept -> vm_flags {
        return static_cast<vm_flags>(static_cast<u32>(a) & static_cast<u32>(b));
    }
    [[nodiscard]] constexpr auto operator~(vm_flags f) noexcept -> vm_flags {
        return static_cast<vm_flags>(~static_cast<u32>(f));
    }
    [[nodiscard]] constexpr auto operator!(vm_flags f) noexcept -> bool {
        return static_cast<u32>(f) == 0;
    }
    constexpr auto operator|=(vm_flags& a, vm_flags b) noexcept -> vm_flags& {
        a = a | b;
        return a;
    }
    constexpr auto operator&=(vm_flags& a, vm_flags b) noexcept -> vm_flags& {
        a = a & b;
        return a;
    }

    /// @brief Describes how a vm_region obtains its physical memory.
    enum class vm_backing : u8 {
        anonymous     = 0,   ///< Demand-paged: allocated on fault.
        physical      = 1,   ///< Direct physical identity mapping.
        portal_shared = 2,   ///< Shared through a portal.
        file          = 3,   ///< Backed by a file-node page provider.
        ipc_shared    = 4,   ///< Backed by an IPC shared-memory provider.
    };

    /// @brief Maximum number of VM regions system-wide (SCOMS scoms_table capacity).
    inline constexpr u32 MAX_VM_REGIONS = 4096U;

    /// @brief Default per-domain committed-page budget (1 GiB at 4 KiB pages).
    inline constexpr u64 VM_DEFAULT_COMMIT_LIMIT_PAGES = 262144ULL;

    enum class vm_page_state : u8 {
        empty = 0,
        resident = 1,
        cow = 2,
        file_cache = 3,
        portal = 4,
        ipc = 5,
    };

    struct vm_page_slot {
        u64 va_page{0};
        u64 phys{0};
        void* file_node{nullptr};
        u32 file_index{0};
        page_cache::cache_binding cache_binding{};
        vm_page_state state{vm_page_state::empty};
        u8 flags{0};
        u8 dirty{0};
        u8 _pad[1]{};

        auto clear() noexcept -> void {
            if (cache_binding) __builtin_trap();
            va_page = 0;
            phys = 0;
            file_node = nullptr;
            file_index = 0;
            cache_binding.clear();
            state = vm_page_state::empty;
            flags = 0;
            dirty = 0;
        }

        auto transfer_to(vm_page_slot& target) noexcept -> void {
            if (target.state != vm_page_state::empty || target.cache_binding) {
                __builtin_trap();
            }
            target = *this;
            cache_binding.clear();
            va_page = 0;
            phys = 0;
            file_node = nullptr;
            file_index = 0;
            state = vm_page_state::empty;
            flags = 0;
            dirty = 0;
        }

        [[nodiscard]] auto matches(u64 page_va) const noexcept -> bool {
            return state != vm_page_state::empty && va_page == page_va;
        }
    };

    /// @brief Lazily-allocated per-VMA page map.
    struct vm_page_map {
        vm_page_slot* slots{nullptr};
        u32           capacity{0};
        u32           count{0};

        [[nodiscard]] auto find_page(u64 page_va) noexcept -> vm_page_slot* {
            if (!slots) return nullptr;
            for (u32 i = 0; i < count; ++i) {
                if (slots[i].matches(page_va)) return &slots[i];
            }
            return nullptr;
        }

        [[nodiscard]] auto find_page(u64 page_va) const noexcept -> const vm_page_slot* {
            if (!slots) return nullptr;
            for (u32 i = 0; i < count; ++i) {
                if (slots[i].matches(page_va)) return &slots[i];
            }
            return nullptr;
        }

        [[nodiscard]] auto reserve_page(u64 page_va) noexcept -> vm_page_slot*;
        [[nodiscard]] auto reserve_capacity(u32 min_capacity) noexcept -> bool;
        auto release_page(u64 page_va) noexcept -> bool;
        auto destroy() noexcept -> void;
    };


    /// @brief A contiguous virtual address region.
    struct vm_space;

    struct vm_region {
        scoms::kobject::bobject  ko{};

        u64             va_start{0};
        u64             va_end{0};

        vm_prot         prot{vm_prot::none};
        vm_flags        flags{vm_flags::none};
        vm_backing      backing{vm_backing::anonymous};
        u8              _pad0[3]{};

        u64             phys_base{0};
        u32             portal_id{~0U};
        u32             owner_domain{~0U};
        void*           file_node{nullptr};
        u32             file_page_offset{0};
        u32             _pad_file{0};

        /// @brief Back-pointer to the vm_space whose rb-tree contains
        ///        this region.
        vm_space*       owning_space{nullptr};

        objects::memory_object_ref storage_object{};
        objects::memory_object_ref grant_object{};
        objects::memory_object_ref mapping_object{};
        objects::memory_object_ref mapped_extent{};

        atomic<u64>     committed{0};
        atomic<u64>     resident{0};

        vm_page_map     pages{};

        lib::rb_node    rb{};
        sync::rcu::rcu_head   rcu{};


        [[nodiscard]] constexpr auto size() const noexcept -> u64 {
            return va_end - va_start;
        }

        [[nodiscard]] constexpr auto page_count() const noexcept -> u64 {
            return size() >> PAGE_SHIFT;
        }

        [[nodiscard]] auto find_page(u64 page_va) noexcept -> vm_page_slot* {
            return pages.find_page(page_va);
        }

        [[nodiscard]] auto find_page(u64 page_va) const noexcept -> const vm_page_slot* {
            return pages.find_page(page_va);
        }

        [[nodiscard]] auto reserve_page(u64 page_va) noexcept -> vm_page_slot* {
            return pages.reserve_page(page_va);
        }

        auto release_page(u64 page_va) noexcept -> bool {
            return pages.release_page(page_va);
        }

        [[nodiscard]] auto mo() noexcept -> objects::memory_object* {
            auto result = objects::memory_object_resolve(mapping_object);
            return result ? *result : nullptr;
        }
        [[nodiscard]] auto mo() const noexcept -> const objects::memory_object* {
            auto result = objects::memory_object_resolve(mapping_object);
            return result ? *result : nullptr;
        }

        [[nodiscard]] auto storage_key() const noexcept -> u8 {
            auto* m = mo(); return m ? m->storage_key : u8{0};
        }
        auto set_storage_key(u8 v) noexcept -> void {
            if (auto* m = mo()) m->storage_key = v;
        }
        [[nodiscard]] auto numa_node() const noexcept -> u8 {
            auto* m = mo(); return m ? m->numa_node : u8{0};
        }
        auto set_numa_node(u8 v) noexcept -> void {
            if (auto* m = mo()) m->numa_node = v;
        }
        [[nodiscard]] auto dgp_scope() const noexcept -> dgp::memory_contract::memory_scope {
            auto* m = mo(); return m ? m->dgp_scope : dgp::memory_contract::memory_scope::private_domain;
        }
        auto set_dgp_scope(dgp::memory_contract::memory_scope v) noexcept -> void {
            if (auto* m = mo()) m->dgp_scope = v;
        }
        [[nodiscard]] auto dgp_access() const noexcept -> dgp::memory_contract::memory_access {
            auto* m = mo(); return m ? m->dgp_access : dgp::memory_contract::memory_access::none;
        }
        auto set_dgp_access(dgp::memory_contract::memory_access v) noexcept -> void {
            if (auto* m = mo()) m->dgp_access = v;
        }
        [[nodiscard]] auto dgp_rights() const noexcept ->  dgp::isolation::isolation_rights {
            auto* m = mo(); return m ? m->dgp_rights :  dgp::isolation::isolation_rights::none;
        }
        auto set_dgp_rights( dgp::isolation::isolation_rights v) noexcept -> void {
            if (auto* m = mo()) m->dgp_rights = v;
        }
        [[nodiscard]] auto invalidate() const noexcept -> dgp::memory_contract::invalidation_scope {
            auto* m = mo(); return m ? m->invalidate : dgp::memory_contract::invalidation_scope::none;
        }
        auto set_invalidate(dgp::memory_contract::invalidation_scope v) noexcept -> void {
            if (auto* m = mo()) m->invalidate = v;
        }
        [[nodiscard]] auto dgp_generation() const noexcept -> u64 {
            auto* m = mo(); return m ? m->dgp_generation : u64{0};
        }
        auto set_dgp_generation(u64 v) noexcept -> void {
            if (auto* m = mo()) m->dgp_generation = v;
        }
        [[nodiscard]] auto mapping_generation() const noexcept -> u64 {
            auto* m = mo(); return m ? m->mapping_generation : u64{0};
        }
        auto set_mapping_generation(u64 v) noexcept -> void {
            if (auto* m = mo()) m->mapping_generation = v;
        }

        vm_region() noexcept = default;
        vm_region(const vm_region&)            = delete;
        auto operator=(const vm_region&)       = delete;
        vm_region(vm_region&&)                 = delete;
        auto operator=(vm_region&&)            = delete;
    };

    static_assert(__builtin_offsetof(vm_region, ko) == 0,
        "vm_region::ko must be at offset 0 — SCOMS container_of depends on this");


    struct vm_space {
        scoms::kobject::bobject*                owner_object{nullptr};
        scoms::kobject::bobject*                address_space_object{nullptr};
        lib::rb_root_cached                     tree{};
        sync::qspinlock::qspinlock              lock{};

        u64                                     total_mapped{0};
        u64                                     total_committed{0};
        u64                                     total_resident{0};

        u64                                     brk{0};
        u64                                     mmap_base{0};
        u64                                     dgp_generation{0};
        u64                                     mapping_generation{0};
        u64                                     asce_val{0};
        u8                                      storage_key{0};
        u8                                      numa_node{0};
        u16                                     _pad_policy{0};
        u32                                     storage_key_generation{0};

        u32                                     owner_domain{0};
        u32                                     region_count{0};
        u32                                     max_regions{4096};

        /// @brief Maximum committed anonymous/physical/IPC pages for this
        ///        domain.
        u64                                     commit_limit_pages{VM_DEFAULT_COMMIT_LIMIT_PAGES};

        vm_space() noexcept = default;
        vm_space(const vm_space&)             = delete;
        auto operator=(const vm_space&)       = delete;
        vm_space(vm_space&&)                  = delete;
        auto operator=(vm_space&&)            = delete;
    };

    /// @brief Test whether @p additional_pages fit in @p space's commit budget.
    /// @pre The caller serializes access to @p space, normally by holding
    ///      @c space.lock.
    /// @note A zero limit denies every new committed page.
    [[nodiscard]] inline auto vm_commit_admitted(
        const vm_space& space, u64 additional_pages
    ) noexcept -> bool {
        return additional_pages <= space.commit_limit_pages
            && space.total_committed <= space.commit_limit_pages - additional_pages;
    }

    struct vm_accounting {
        u64         limit_pages{0};
        atomic<u64> committed{0};
        atomic<u64> resident{0};
        atomic<u64> fault_count{0};
    };

    inline constexpr u64 VM_USER_START  = 0x0000'0000'0040'0000ULL;
    inline constexpr u64 VM_USER_END    = 0x0000'0080'0000'0000ULL;
    inline constexpr u64 VM_MMAP_BASE   = 0x0000'0040'0000'0000ULL;
    inline constexpr u64 VM_STACK_TOP   = 0x0000'0080'0000'0000ULL;

} // namespace zxfoundation::memory::vm

} // end export
