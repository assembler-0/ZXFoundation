/// SPDX-License-Identifier: Apache-2.0
/// @file zxfoundation/scoms/scoms_table.cxxm
/// @brief SCOMS — scoms_table<T, N>: unified, generation-counted,
///        reference-counted kernel object table.

export module zxfoundation.scoms.table;
import zxfoundation.base.types;
import zxfoundation.base.typestate;
import zxfoundation.scoms.kobject.types;
import zxfoundation.scoms.kobject.base;
import zxfoundation.scoms.kobject.ref;
import zxfoundation.scoms.metadata.core;
import zxfoundation.sync.qspinlock.core;
import zxfoundation.sync.lockable;
import arch.s390x.cpu.irq;
import lib.error;
import lib.stl;

#define __zxmacro_want_symalias
#include macro_extensions

auto allocate(u64) noexcept -> void* symalias_reference(kmalloc);
auto free(void*) noexcept -> void symalias_reference(kfree);

export {

namespace zxfoundation::scoms {

    using base::lifecycle_state;
    using std::atomic;
    using std::memory_order;

    /// @brief Generic, generation-counted kernel object table.
    /// @tparam T  Concrete kernel object type.  Must have a `kobject ko`
    ///            field at offset 0.
    /// @tparam N  Maximum number of objects (static capacity).
    template <typename T, u32 N>
    class scoms_table {
        static_assert(__builtin_offsetof(T, ko) == 0,
            "T::ko must be at offset 0 for SCOMS scoms_table");

        static constexpr u32 BLOCK_SIZE = 256U;
        static constexpr u32 BLOCK_COUNT = (N + BLOCK_SIZE - 1U) / BLOCK_SIZE;
        T**     m_slot_blocks[BLOCK_COUNT]{};
        u32*    m_next_blocks[BLOCK_COUNT]{};
        u32*    m_generation_blocks[BLOCK_COUNT]{};
        u32     m_free_head{0};
        atomic<u32> m_count{0};
        sync::qspinlock::qspinlock m_table_lock{};
        bool    m_initialized{false};

        /// @brief The kobject::kobject_type that this table manages.
        kobject::kobject_type m_type{kobject::kobject_type::none};
        inline static scoms_table* s_instance{nullptr};

        static auto reclaim_object(kobject::bobject& header) noexcept -> void {
            if (!s_instance) __builtin_trap();
            auto& object = *reinterpret_cast<T*>(&header);
            s_instance->reclaim_retired(object);
        }

        auto reclaim_retired(T& object) noexcept -> void {
            const u32 id = object.ko.id;
            if (id >= N) __builtin_trap();
            const sync::irq_lock_guard guard{m_table_lock};
            if (object_ptr(id) != nullptr) __builtin_trap();
            object_core::complete_reclaim(object.ko);
            object.ko.id = kobject::KOBJECT_ID_INVALID;
            object.~T();
            free(&object);
            next_ptr(id) = m_free_head;
            m_free_head = id;
        }

        [[nodiscard]] auto slot_ptr(u32 id) noexcept -> T*& {
            return m_slot_blocks[id / BLOCK_SIZE][id % BLOCK_SIZE];
        }

        [[nodiscard]] auto object_ptr(u32 id) noexcept -> T* {
            auto* block = m_slot_blocks[id / BLOCK_SIZE];
            return block ? block[id % BLOCK_SIZE] : nullptr;
        }

        [[nodiscard]] auto next_ptr(u32 id) noexcept -> u32& {
            return m_next_blocks[id / BLOCK_SIZE][id % BLOCK_SIZE];
        }

        [[nodiscard]] auto generation_ptr(u32 id) noexcept -> u32& {
            return m_generation_blocks[id / BLOCK_SIZE][id % BLOCK_SIZE];
        }

        [[nodiscard]] auto ensure_slot_block(u32 block) noexcept -> bool {
            if (m_next_blocks[block]) return true;
            auto* next = static_cast<u32*>(allocate(
                sizeof(u32) * BLOCK_SIZE));
            auto* generation = static_cast<u32*>(allocate(
                sizeof(u32) * BLOCK_SIZE));
            if (!next || !generation) return false;
            for (u32 i = 0; i < BLOCK_SIZE; ++i) {
                next[i] = ~0U;
                generation[i] = 0U;
            }
            m_next_blocks[block] = next;
            m_generation_blocks[block] = generation;
            return true;
        }

        [[nodiscard]] auto ensure_object_block(u32 block) noexcept -> bool {
            if (m_slot_blocks[block]) return true;
            auto* slots = static_cast<T**>(allocate(
                sizeof(T*) * BLOCK_SIZE));
            if (!slots) return false;
            for (u32 i = 0; i < BLOCK_SIZE; ++i) slots[i] = nullptr;
            m_slot_blocks[block] = slots;
            return true;
        }

    public:
        /// @brief Initialize the table.
        /// @param type  The kobject::kobject_type for objects in this table.
        auto init(kobject::kobject_type type) noexcept -> void {
            s_instance = this;
            install_bobject_finalizer(object_core::finalize_last_put);
            m_type = type;

            // Build the free-list.
            for (u32 i = 0; i < N; ++i) {
                if (!ensure_slot_block(i / BLOCK_SIZE)) return;
                next_ptr(i) = (i + 1 < N) ? (i + 1) : ~0U;
            }

            m_free_head   = 0;
            m_count.store(0, memory_order::relaxed);
            m_initialized = true;
        }

        /// @brief Allocate a slot, returning an embryo ref.
        /// @return  An embryo ref on success, or kernel_error if the
        ///          table is full.
        [[nodiscard]] auto alloc(kobject::kobject_type requested_type = kobject::kobject_type::none) noexcept
            -> std::expected<kobject::robject<T, lifecycle_state::embryo>, lib::kernel_error>
        {
            if (!m_initialized) [[unlikely]]
                return std::unexpected(
                    lib::kernel_error::from_generic(lib::generic_error::uninitialized));

            const sync::irq_lock_guard guard{m_table_lock};

            if (m_free_head == ~0U)
                return std::unexpected(
                    lib::kernel_error::from_memory(lib::memory_error::out_of_memory));

            const u32 slot = m_free_head;
            m_free_head = next_ptr(slot);
            next_ptr(slot) = ~0U;

            if (!ensure_object_block(slot / BLOCK_SIZE)) {
                next_ptr(slot) = m_free_head;
                m_free_head = slot;
                return std::unexpected(lib::kernel_error::from_memory(
                    lib::memory_error::out_of_memory));
            }
            auto* obj_ptr = static_cast<T*>(allocate(sizeof(T)));
            if (!obj_ptr) {
                next_ptr(slot) = m_free_head;
                m_free_head = slot;
                return std::unexpected(lib::kernel_error::from_memory(
                    lib::memory_error::out_of_memory));
            }
            std::construct_at(obj_ptr);
            m_slot_blocks[slot / BLOCK_SIZE][slot % BLOCK_SIZE] = obj_ptr;
            T& obj = *obj_ptr;
            obj.ko.generation = ++generation_ptr(slot);  // ABA prevention.
            const auto object_type = requested_type == kobject::kobject_type::none
                ? m_type : requested_type;
            obj.ko.initialize(slot, object_type);
            auto metadata_result = object_core::register_object(obj.ko);
            if (!metadata_result) {
                next_ptr(slot) = m_free_head;
                m_free_head = slot;
                obj.~T();
                free(obj_ptr);
                m_slot_blocks[slot / BLOCK_SIZE][slot % BLOCK_SIZE] = nullptr;
                return std::unexpected(metadata_result.error());
            }
            auto reclaimer_result = object_core::set_reclaimer(obj.ko, reclaim_object);
            if (!reclaimer_result) {
                discard_value object_core::unregister_object(obj.ko);
                next_ptr(slot) = m_free_head;
                m_free_head = slot;
                obj.~T();
                free(obj_ptr);
                m_slot_blocks[slot / BLOCK_SIZE][slot % BLOCK_SIZE] = nullptr;
                return std::unexpected(reclaimer_result.error());
            }

            discard_value m_count.fetch_add(1, memory_order::relaxed);

            return kobject::robject<T, lifecycle_state::embryo>{&obj};
        }

        /// @brief Allocate a specific slot index, returning an embryo ref.
        /// @param[in] id  Slot index to claim.  Must be < N and currently free.
        [[nodiscard]] auto alloc_at(u32 id) noexcept
            -> std::expected<kobject::robject<T, lifecycle_state::embryo>, lib::kernel_error>
        {
            if (!m_initialized) [[unlikely]]
                return std::unexpected(
                    lib::kernel_error::from_generic(lib::generic_error::uninitialized));

            if (id >= N)
                return std::unexpected(
                    lib::kernel_error::from_generic(lib::generic_error::invalid_arg));

            const sync::irq_lock_guard guard{m_table_lock};

            if (object_ptr(id) != nullptr)
                return std::unexpected(
                    lib::kernel_error::from_locking(
                        lib::locking_error::already_locked));

            if (m_free_head == ~0U)
                return std::unexpected(
                    lib::kernel_error::from_memory(lib::memory_error::out_of_memory));

            if (m_free_head == id) {
                m_free_head = next_ptr(id);
            } else {
                u32 prev = m_free_head;
                while (prev != ~0U && next_ptr(prev) != id)
                    prev = next_ptr(prev);
                if (prev == ~0U) {
                    return std::unexpected(
                        lib::kernel_error::from_locking(
                            lib::locking_error::already_locked));
                }
                next_ptr(prev) = next_ptr(id);
            }
            next_ptr(id) = ~0U;

            if (!ensure_object_block(id / BLOCK_SIZE)) {
                next_ptr(id) = m_free_head;
                m_free_head = id;
                return std::unexpected(lib::kernel_error::from_memory(
                    lib::memory_error::out_of_memory));
            }
            auto* obj_ptr = static_cast<T*>(allocate(sizeof(T)));
            if (!obj_ptr) {
                next_ptr(id) = m_free_head;
                m_free_head = id;
                return std::unexpected(lib::kernel_error::from_memory(
                    lib::memory_error::out_of_memory));
            }
            new (obj_ptr) T{};
            m_slot_blocks[id / BLOCK_SIZE][id % BLOCK_SIZE] = obj_ptr;
            T& obj = *obj_ptr;
            obj.ko.generation = ++generation_ptr(id);
            obj.ko.initialize(id, m_type);
            auto metadata_result = object_core::register_object(obj.ko);
            if (!metadata_result) {
                next_ptr(id) = m_free_head;
                m_free_head = id;
                obj.~T();
                free(obj_ptr);
                m_slot_blocks[id / BLOCK_SIZE][id % BLOCK_SIZE] = nullptr;
                return std::unexpected(metadata_result.error());
            }
            auto reclaimer_result = object_core::set_reclaimer(obj.ko, reclaim_object);
            if (!reclaimer_result) {
                discard_value object_core::unregister_object(obj.ko);
                next_ptr(id) = m_free_head;
                m_free_head = id;
                obj.~T();
                free(obj_ptr);
                m_slot_blocks[id / BLOCK_SIZE][id % BLOCK_SIZE] = nullptr;
                return std::unexpected(reclaimer_result.error());
            }

            discard_value m_count.fetch_add(1, memory_order::relaxed);

            return kobject::robject<T, lifecycle_state::embryo>{&obj};
        }

        /// @brief Look up by slot index.
        [[nodiscard]] auto find_raw(u32 id) noexcept -> T* {
            if (id >= N) return nullptr;
            auto* obj = object_ptr(id);
            if (!obj || obj->ko.id == kobject::KOBJECT_ID_INVALID) return nullptr;
            return obj;
        }

        [[nodiscard]] auto find_raw(u32 id) const noexcept -> const T* {
            if (id >= N) return nullptr;
            auto* obj = const_cast<scoms_table*>(this)->object_ptr(id);
            if (!obj || obj->ko.id == kobject::KOBJECT_ID_INVALID) return nullptr;
            return obj;
        }

        /// @brief Look up by slot index + generation.
        [[nodiscard]] auto find_by_gen(u32 id, u32 gen) noexcept -> T* {
            if (id >= N) return nullptr;
            auto* obj = object_ptr(id);
            if (!obj || obj->ko.id == kobject::KOBJECT_ID_INVALID) return nullptr;
            if (obj->ko.generation != gen) return nullptr;
            return obj;
        }

        /// @brief Look up by slot index and acquire a typed ref.
        /// @return  A ref if the slot is valid, or a null ref.
        template <lifecycle_state State = lifecycle_state::active>
        [[nodiscard]] auto acquire_ref(u32 id) noexcept
            -> kobject::robject<T, State>
        {
            const sync::irq_lock_guard guard{m_table_lock};
            T* p = object_ptr(id);
            if (!p) return {};
            if (p->ko.state != State) return {};
            return kobject::robject<T, State>{p};
        }

        /// @brief Release a slot back to the free-list.
        /// @param id  Slot index to release.
        /// @return    Success, or kernel_error if the slot is invalid.
        [[nodiscard]] auto release(u32 id) noexcept
            -> std::expected<void, lib::kernel_error>
        {
            if (id >= N)
                return std::unexpected(
                    lib::kernel_error::from_generic(lib::generic_error::invalid_arg));

            T* retired = nullptr;
            {
                const sync::irq_lock_guard guard{m_table_lock};
                auto* obj_ptr = object_ptr(id);
                if (!obj_ptr) return std::unexpected(
                    lib::kernel_error::from_generic(lib::generic_error::not_found));
                T& obj = *obj_ptr;
                if (obj.ko.state == lifecycle_state::embryo ||
                    obj.ko.state == lifecycle_state::active ||
                    obj.ko.state == lifecycle_state::suspended) {
                    if (!obj.ko.transition(lifecycle_state::dying)) {
                        return std::unexpected(lib::kernel_error::from_generic(
                            lib::generic_error::invalid_arg));
                    }
                }
                if (obj.ko.state != lifecycle_state::dying) {
                    return std::unexpected(lib::kernel_error::from_generic(
                        lib::generic_error::invalid_arg));
                }
                auto metadata_result = object_core::unregister_object(obj.ko);
                if (!metadata_result) return std::unexpected(metadata_result.error());
                discard_value obj.ko.transition(lifecycle_state::destroyed);
                m_slot_blocks[id / BLOCK_SIZE][id % BLOCK_SIZE] = nullptr;
                discard_value m_count.fetch_sub(1, memory_order::relaxed);
                retired = &obj;
            }
            retired->ko.put();
            return {};
        }

        /// @brief Destroy all objects matching a predicate.
        /// @param pred     Predicate: bool(const T&).
        /// @param cleanup  Optional cleanup: void(T&).  Called before
        ///                 the slot is released.
        /// @return Number of objects destroyed.
        template <typename Pred, typename Cleanup>
        auto destroy_if(Pred&& pred, Cleanup&& cleanup) noexcept -> u32 {
            u32 destroyed = 0;

            for (u32 i = 0; i < N; ++i) {
                auto ref = acquire_ref<lifecycle_state::active>(i);
                if (!ref || !pred(*ref)) continue;
                cleanup(*ref);
                if (release(i)) ++destroyed;
            }

            return destroyed;
        }

        /// @brief Destroy all objects matching a predicate (no cleanup).
        template <typename Pred>
        auto destroy_if(Pred&& pred) noexcept -> u32 {
            return destroy_if(
                static_cast<Pred&&>(pred),
                [](T&) noexcept {});
        }

        /// @brief Number of currently allocated (non-free) slots.
        [[nodiscard]] auto count() const noexcept -> u32 {
            return m_count.load(memory_order::relaxed);
        }

        /// @brief Maximum capacity.
        [[nodiscard]] static constexpr auto capacity() noexcept -> u32 {
            return N;
        }

        /// @brief Is the table initialized?
        [[nodiscard]] auto initialized() const noexcept -> bool {
            return m_initialized;
        }

        /// @brief Invoke @p fn for every live (non-free) object in the table.
        /// @tparam Fn  Callable of signature @c bool(T&) noexcept.
        /// @param[in] fn  Visitor.  Return @c true to continue, @c false to stop.
        /// @return Number of objects visited (including the one that stopped
        ///         the walk, if any).
        template <typename Fn>
        auto for_each(Fn&& fn) noexcept -> u32 {
            u32 visited = 0;
            for (u32 block = 0; block < BLOCK_COUNT; ++block) {
                auto* slots = m_slot_blocks[block];
                if (!slots) continue;
                for (u32 i = 0; i < BLOCK_SIZE; ++i) {
                    auto* obj = slots[i];
                    if (!obj) continue;
                    auto s = obj->ko.state;
                    if (s != lifecycle_state::embryo &&
                        s != lifecycle_state::active &&
                        s != lifecycle_state::suspended &&
                        s != lifecycle_state::dying) continue;
                    ++visited;
                    if (!fn(*obj)) return visited;
                }
            }
            return visited;
        }

        /// @brief Direct slot access (no validity check — internal use only).
        [[nodiscard]] auto slot(u32 id) noexcept -> T& {
            return *slot_ptr(id);
        }
        [[nodiscard]] auto slot(u32 id) const noexcept -> const T& {
            return *slot_ptr(id);
        }
    };

} // namespace zxfoundation::scoms

} // end export
