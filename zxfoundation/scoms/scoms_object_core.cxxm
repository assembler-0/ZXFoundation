/// SPDX-License-Identifier: Apache-2.0
/// @file scoms_object_core.cxxm
/// @brief Nucleus-owned metadata for the unified object ontology.

export module zxfoundation.scoms.scoms_object_core;
import zxfoundation.scoms.scoms_types;
import zxfoundation.locking.qspinlock;
import zxfoundation.locking.lock;
import zxfoundation.base.types;
import lib.error;
import std;

__external__ auto __raw_alloc(u64 size) noexcept -> void*;

export {

    namespace zxfoundation::scoms::object_core {

    constexpr u32 MAX_OBJECT_METADATA = 16384U;
    constexpr u32 METADATA_BLOCK_SIZE = 256U;
    constexpr u32 METADATA_BLOCK_COUNT =
        (MAX_OBJECT_METADATA + METADATA_BLOCK_SIZE - 1U) / METADATA_BLOCK_SIZE;

    struct object_metadata {
        const kobject* object{nullptr};
        u32 owner_domain{KOBJECT_ID_INVALID};
        u32 parent_slot{0};
        kobject_type parent_type{kobject_type::none};
        u32 parent_id{KOBJECT_ID_INVALID};
        u32 parent_generation{0};
        u32 object_flags{0};
        u32 dependent_count{0};
        u32 hardware_generation{0};
        void (*reclaimer)(kobject&) noexcept{nullptr};
        bool active{false};
        bool reclaim_pending{false};
    };

    [[nodiscard]] auto register_object(
        kobject& object, u32 owner_domain = KOBJECT_ID_INVALID
    ) noexcept -> std::expected<void, lib::kernel_error>;

    [[nodiscard]] auto unregister_object(
        kobject& object
    ) noexcept -> std::expected<void, lib::kernel_error>;

    /// @brief Register the table-specific final reclaimer for an object.
    [[nodiscard]] auto set_reclaimer(
        kobject& object, void (*reclaimer)(kobject&) noexcept
    ) noexcept -> std::expected<void, lib::kernel_error>;

    /// @brief Dispatch the final-put reclaimer retained in object metadata.
    auto finalize_last_put(kobject& object) noexcept -> void;

    /// @brief Remove metadata only after table storage has been unpublished.
    auto complete_reclaim(kobject& object) noexcept -> void;

    [[nodiscard]] auto set_owner(
        kobject& object, u32 owner_domain
    ) noexcept -> std::expected<void, lib::kernel_error>;

    [[nodiscard]] auto attach(
        kobject& child, kobject& parent
    ) noexcept -> std::expected<void, lib::kernel_error>;

    [[nodiscard]] auto detach(
        kobject& child
    ) noexcept -> std::expected<void, lib::kernel_error>;

    [[nodiscard]] auto has_dependents(
        const kobject& object
    ) noexcept -> bool;

    [[nodiscard]] auto bump_hardware_generation(
        kobject& object
    ) noexcept -> std::expected<u32, lib::kernel_error>;

    [[nodiscard]] auto metadata(
        const kobject& object
    ) noexcept -> std::expected<object_metadata, lib::kernel_error>;

} // namespace zxfoundation::scoms::object_core

} // end export

namespace zxfoundation::scoms::object_core::_internal {

static object_metadata* g_metadata[METADATA_BLOCK_COUNT]{};
static locking::qspinlock::qspinlock g_lock{};

[[nodiscard]] auto metadata_at(u32 index, bool create = false) noexcept
    -> object_metadata* {
    const u32 block = index / METADATA_BLOCK_SIZE;
    if (!g_metadata[block]) {
        if (!create) return nullptr;
        g_metadata[block] = static_cast<object_metadata*>(
            __raw_alloc(sizeof(object_metadata) * METADATA_BLOCK_SIZE));
        if (!g_metadata[block]) return nullptr;
        for (u32 i = 0; i < METADATA_BLOCK_SIZE; ++i)
            g_metadata[block][i] = {};
    }
    return &g_metadata[block][index % METADATA_BLOCK_SIZE];
}

[[nodiscard]] auto find_locked(const kobject& object) noexcept -> object_metadata* {
    if (object.object_flags == 0U) return nullptr;
    const u32 index = object.object_flags - 1U;
    if (index >= MAX_OBJECT_METADATA) return nullptr;
    auto* entry = metadata_at(index);
    return entry && entry->active && entry->object == &object ? entry : nullptr;
}

[[nodiscard]] auto retired_locked(const kobject& object) noexcept -> object_metadata* {
    if (object.object_flags == 0U) return nullptr;
    const u32 index = object.object_flags - 1U;
    if (index >= MAX_OBJECT_METADATA) return nullptr;
    auto* entry = metadata_at(index);
    return entry && entry->reclaim_pending && entry->object == &object ? entry : nullptr;
}

[[nodiscard]] auto error_not_found() noexcept -> lib::kernel_error {
    return lib::kernel_error::from_generic(lib::generic_error::not_found);
}

auto clear_parent_locked(object_metadata& child) noexcept -> void {
    if (child.parent_id == KOBJECT_ID_INVALID) return;

    if (child.parent_slot != 0U) {
        auto* parent = metadata_at(child.parent_slot - 1U);
        if (parent && parent->active && parent->object &&
            parent->object->type == child.parent_type &&
            parent->object->id == child.parent_id &&
            parent->object->generation == child.parent_generation &&
            parent->dependent_count != 0U) {
            --parent->dependent_count;
        }
    }

    child.parent_slot = 0;
    child.parent_type = kobject_type::none;
    child.parent_id = KOBJECT_ID_INVALID;
    child.parent_generation = 0;
}

} // namespace zxfoundation::scoms::object_core::_internal

namespace zxfoundation::scoms::object_core {

    [[nodiscard]] auto register_object(
        kobject& object, u32 owner_domain
    ) noexcept -> std::expected<void, lib::kernel_error> {
        const locking::irq_lock_guard guard{_internal::g_lock};
        if (_internal::find_locked(object)) {
            return std::unexpected(lib::kernel_error::from_generic(
                lib::generic_error::invalid_arg));
        }
        for (u32 i = 0; i < MAX_OBJECT_METADATA; ++i) {
            auto* entry = _internal::metadata_at(i, true);
            if (!entry || entry->active || entry->reclaim_pending) continue;
            entry->object = &object;
            entry->owner_domain = owner_domain;
            entry->parent_slot = 0;
            entry->parent_type = kobject_type::none;
            entry->parent_id = KOBJECT_ID_INVALID;
            entry->parent_generation = 0;
            entry->object_flags = object.object_flags;
            entry->dependent_count = 0;
            entry->hardware_generation = 0;
            entry->reclaimer = nullptr;
            entry->active = true;
            entry->reclaim_pending = false;
            object.object_flags = i + 1U;
            return {};
        }
        return std::unexpected(lib::kernel_error::from_memory(
            lib::memory_error::out_of_memory));
    }

    [[nodiscard]] auto unregister_object(
        kobject& object
    ) noexcept -> std::expected<void, lib::kernel_error> {
        const locking::irq_lock_guard guard{_internal::g_lock};
        auto* entry = _internal::find_locked(object);
        if (!entry) return std::unexpected(_internal::error_not_found());
        if (entry->dependent_count != 0U) {
            return std::unexpected(lib::kernel_error::from_generic(
                lib::generic_error::invalid_arg));
        }
        _internal::clear_parent_locked(*entry);
        entry->active = false;
        entry->reclaim_pending = true;
        return {};
    }

    [[nodiscard]] auto set_reclaimer(
        kobject& object, void (*reclaimer)(kobject&) noexcept
    ) noexcept -> std::expected<void, lib::kernel_error> {
        if (!reclaimer) return std::unexpected(lib::kernel_error::from_generic(
            lib::generic_error::invalid_arg));
        const locking::irq_lock_guard guard{_internal::g_lock};
        auto* entry = _internal::find_locked(object);
        if (!entry) return std::unexpected(_internal::error_not_found());
        entry->reclaimer = reclaimer;
        return {};
    }

    auto finalize_last_put(kobject& object) noexcept -> void {
        void (*reclaimer)(kobject&) noexcept = nullptr;
        {
            const locking::irq_lock_guard guard{_internal::g_lock};
            auto* entry = _internal::retired_locked(object);
            if (!entry || !entry->reclaimer) __builtin_trap();
            reclaimer = entry->reclaimer;
        }
        reclaimer(object);
    }

    auto complete_reclaim(kobject& object) noexcept -> void {
        const locking::irq_lock_guard guard{_internal::g_lock};
        auto* entry = _internal::retired_locked(object);
        if (!entry) __builtin_trap();
        entry->object = nullptr;
        entry->reclaimer = nullptr;
        entry->reclaim_pending = false;
        object.object_flags = 0U;
    }

    [[nodiscard]] auto set_owner(
        kobject& object, u32 owner_domain
    ) noexcept -> std::expected<void, lib::kernel_error> {
        const locking::irq_lock_guard guard{_internal::g_lock};
        auto* entry = _internal::find_locked(object);
        if (!entry) return std::unexpected(_internal::error_not_found());
        entry->owner_domain = owner_domain;
        return {};
    }

    [[nodiscard]] auto attach(
        kobject& child, kobject& parent
    ) noexcept -> std::expected<void, lib::kernel_error> {
        if (&child == &parent) {
            return std::unexpected(lib::kernel_error::from_generic(
                lib::generic_error::invalid_arg));
        }
        const locking::irq_lock_guard guard{_internal::g_lock};
        auto* child_meta = _internal::find_locked(child);
        auto* parent_meta = _internal::find_locked(parent);
        if (!child_meta || !parent_meta || child_meta->parent_id != KOBJECT_ID_INVALID) {
            return std::unexpected(_internal::error_not_found());
        }
        child_meta->parent_type = parent.type;
        child_meta->parent_id = parent.id;
        child_meta->parent_generation = parent.generation;
        child_meta->parent_slot = parent.object_flags;
        ++parent_meta->dependent_count;
        return {};
    }

    [[nodiscard]] auto detach(
        kobject& child
    ) noexcept -> std::expected<void, lib::kernel_error> {
        const locking::irq_lock_guard guard{_internal::g_lock};
        auto* child_meta = _internal::find_locked(child);
        if (!child_meta) return std::unexpected(_internal::error_not_found());
        if (child_meta->parent_id == KOBJECT_ID_INVALID) return {};

        _internal::clear_parent_locked(*child_meta);
        return {};
    }

    [[nodiscard]] auto has_dependents(
        const kobject& object
    ) noexcept -> bool {
        const locking::irq_lock_guard guard{_internal::g_lock};
        const auto* entry = _internal::find_locked(object);
        return entry != nullptr && entry->dependent_count != 0U;
    }

    [[nodiscard]] auto bump_hardware_generation(
        kobject& object
    ) noexcept -> std::expected<u32, lib::kernel_error> {
        const locking::irq_lock_guard guard{_internal::g_lock};
        auto* entry = _internal::find_locked(object);
        if (!entry) return std::unexpected(_internal::error_not_found());
        ++entry->hardware_generation;
        return entry->hardware_generation;
    }

    [[nodiscard]] auto metadata(
        const kobject& object
    ) noexcept -> std::expected<object_metadata, lib::kernel_error> {
        const locking::irq_lock_guard guard{_internal::g_lock};
        const auto* entry = _internal::find_locked(object);
        if (!entry) return std::unexpected(_internal::error_not_found());
        return *entry;
    }

} // namespace zxfoundation::scoms::object_core
